# examples/sh101.ttl
#
# Monophonic subtractive synthesiser modelled after the Roland SH-101.
#
# Signal path:
#   MidiPitch → VCO ──────────────────────┐
#   MidiPitch → SubOsc (×0.5) → subGain ──┤→ Mixer → Ladder VCF → VCA → Output
#   Noise → noiseGain ─────────────────────┘
#
# Modulation:
#   Envelope → VCA.cv                    (amplitude)
#   Envelope → Scale → VCF.cutoff        (filter sweep)
#   LFO     → Oscillator.frequency       (vibrato, depth=0 by default)
#
# Sub-oscillator: square wave one octave below the VCO, implemented by
# multiplying MidiPitch by 0.5 via ControlMultiply. Level is a host param.
#
# Noise: white noise mixed into the filter input. Level is a host param.
# Turn this up for breathy or percussion-like textures.
#
# The Scale element maps the 0–1 envelope to an absolute frequency range:
#   min = base cutoff (the "Cutoff" knob, Hz)
#   max = cutoff at envelope peak (the "Filter Peak" knob, Hz)
# A control arc that reaches VCF.cutoff REPLACES the port's fixed value, so
# the base cutoff must live inside the Scale rather than on the Ladder instance.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:sh101#> .

:sh101 a val:Circuit ;
    rdfs:label "SH-101" ;
    val:element :pitch , :lfo ,
                :osc ,
                :subMult , :subOsc , :subGain ,
                :noise , :noiseGain ,
                :vcfMix ,
                :vcf , :env , :envScale , :vca , :out ;
    val:arc :aPitchOsc , :aPitchSubMult , :aSubMultSubOsc ,
            :aSubOscGain , :aNoiseGain ,
            :aOscMix , :aSubGainMix , :aNoiseGainMix ,
            :aMixVcf , :aVcfVca , :aVcaOut ,
            :aLfoOsc , :aEnvVca , :aEnvScale , :aScaleVcf .

# ── Sources ──────────────────────────────────────────────────────────────────

:pitch a val:MidiPitch .

:lfo a val:LFO ;
    val:rate  5.0 ;
    val:shape 0 .            # 0 = sine (vibrato)

:osc a val:Oscillator ;
    val:shape 1 .            # 1 = sawtooth

# Sub-oscillator: MidiPitch × 0.5 gives one octave below the VCO.
# val:b 0.5 sets the fixed multiplier; no arc connects to b.
:subMult a val:ControlMultiply ;
    val:b 0.5 .

:subOsc a val:Oscillator ;
    val:shape 2 .            # 2 = square (as on the original hardware)

:subGain a val:Gain ;
    val:gain -12.0 .         # start at -12 dB; raise via param

:noise a val:Noise ;
    val:colour 0.0 .         # 0 = white noise

:noiseGain a val:Gain ;
    val:gain -60.0 .         # near-silent by default; raise via param

# ── Mixer (VCO + sub-oscillator + noise → VCF) ───────────────────────────────

:vcfMix a val:Mixer .

# ── Filter ───────────────────────────────────────────────────────────────────

:vcf a val:Ladder ;
    val:resonance 0.3 ;
    val:drive     1.0 .
# Note: val:cutoff is intentionally absent — the control arc from :envScale
# sets the cutoff every block, overriding any fixed value here.

# ── Envelope modulation ───────────────────────────────────────────────────────

:env a val:Envelope ;
    val:attack  10.0 ;       # ms
    val:decay   200.0 ;
    val:sustain 0.7 ;
    val:release 300.0 .

# Scale maps the 0–1 envelope to a cutoff range [min, max].
:envScale a val:Scale ;
    val:min 400.0 ;          # Hz — base cutoff when envelope is silent
    val:max 8000.0 .         # Hz — cutoff at envelope peak

# ── Amplitude ────────────────────────────────────────────────────────────────

:vca a val:VCA .

:out a val:Output .

# ── Audio arcs ───────────────────────────────────────────────────────────────

:aOscMix a val:Arc ;
    val:from [ val:node :osc     ; val:port "out" ] ;
    val:to   [ val:node :vcfMix  ; val:port "in"  ] .

:aSubGainMix a val:Arc ;
    val:from [ val:node :subGain ; val:port "out" ] ;
    val:to   [ val:node :vcfMix  ; val:port "in"  ] .

:aNoiseGainMix a val:Arc ;
    val:from [ val:node :noiseGain ; val:port "out" ] ;
    val:to   [ val:node :vcfMix    ; val:port "in"  ] .

:aMixVcf a val:Arc ;
    val:from [ val:node :vcfMix ; val:port "out" ] ;
    val:to   [ val:node :vcf    ; val:port "in"  ] .

:aVcfVca a val:Arc ;
    val:from [ val:node :vcf ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "in"  ] .

:aVcaOut a val:Arc ;
    val:from [ val:node :vca ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in"  ] .

# Sub-oscillator audio path
:aSubOscGain a val:Arc ;
    val:from [ val:node :subOsc  ; val:port "out" ] ;
    val:to   [ val:node :subGain ; val:port "in"  ] .

:aNoiseGain a val:Arc ;
    val:from [ val:node :noise     ; val:port "out" ] ;
    val:to   [ val:node :noiseGain ; val:port "in"  ] .

# ── Control arcs ─────────────────────────────────────────────────────────────

# MidiPitch → VCO frequency
:aPitchOsc a val:ControlArc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :osc   ; val:port "frequency" ] .

# MidiPitch × 0.5 → sub-oscillator frequency (one octave below)
:aPitchSubMult a val:ControlArc ;
    val:from [ val:node :pitch   ; val:port "out" ] ;
    val:to   [ val:node :subMult ; val:port "a"   ] .

:aSubMultSubOsc a val:ControlArc ;
    val:from [ val:node :subMult ; val:port "out"       ] ;
    val:to   [ val:node :subOsc  ; val:port "frequency" ] .

# LFO → VCO frequency (vibrato); depth=0 = off, raise to taste
:aLfoOsc a val:ControlArc ; val:depth 0.0 ;
    val:from [ val:node :lfo ; val:port "out" ] ;
    val:to   [ val:node :osc ; val:port "frequency" ] .

# Envelope → VCA cv (amplitude shaping)
:aEnvVca a val:ControlArc ;
    val:from [ val:node :env ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "cv"  ] .

# Envelope → Scale (compute absolute cutoff)
:aEnvScale a val:ControlArc ;
    val:from [ val:node :env      ; val:port "out" ] ;
    val:to   [ val:node :envScale ; val:port "in"  ] .

# Scale → VCF cutoff (this arc sets the cutoff every block)
:aScaleVcf a val:ControlArc ;
    val:from [ val:node :envScale ; val:port "out"    ] ;
    val:to   [ val:node :vcf      ; val:port "cutoff" ] .

# ── Host parameters ──────────────────────────────────────────────────────────

:p0 a val:Param ; val:slot 0 ; val:target :osc ; val:property val:shape ;
    lv2:name "Osc Shape" ; lv2:symbol "osc_shape" ; val:section "Oscillator" .

:p9 a val:Param ; val:slot 9 ; val:target :subGain ; val:property val:gain ;
    lv2:name "Sub Level" ; lv2:symbol "sub_level" ; val:section "Oscillator" ;
    units:unit units:db ; lv2:minimum -60.0 ; lv2:maximum 6.0 .

:p10 a val:Param ; val:slot 10 ; val:target :noiseGain ; val:property val:gain ;
    lv2:name "Noise Level" ; lv2:symbol "noise_level" ; val:section "Oscillator" ;
    units:unit units:db ; lv2:minimum -60.0 ; lv2:maximum 6.0 .

# p1 targets Scale.min — the filter's resting frequency (envelope closed).
# lv2:minimum/maximum here override Scale's generic ±1e6 port range.
:p1 a val:Param ; val:slot 1 ; val:target :envScale ; val:property val:min ;
    lv2:name "Cutoff" ; lv2:symbol "cutoff" ; val:section "Filter" ; units:unit units:hz ;
    lv2:minimum 20.0 ; lv2:maximum 20000.0 .

:p2 a val:Param ; val:slot 2 ; val:target :vcf ; val:property val:resonance ;
    lv2:name "Resonance" ; lv2:symbol "resonance" ; val:section "Filter" .

:p3 a val:Param ; val:slot 3 ; val:target :env ; val:property val:attack ;
    lv2:name "Attack" ; lv2:symbol "attack" ; val:section "Envelope" ; units:unit units:ms .

:p4 a val:Param ; val:slot 4 ; val:target :env ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "decay" ; val:section "Envelope" ; units:unit units:ms .

:p5 a val:Param ; val:slot 5 ; val:target :env ; val:property val:sustain ;
    lv2:name "Sustain" ; lv2:symbol "sustain" ; val:section "Envelope" .

:p6 a val:Param ; val:slot 6 ; val:target :env ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ; val:section "Envelope" ; units:unit units:ms .

# p7 targets Scale.max — the filter's peak frequency (envelope fully open).
:p7 a val:Param ; val:slot 7 ; val:target :envScale ; val:property val:max ;
    lv2:name "Filter Peak" ; lv2:symbol "filter_peak" ; val:section "Filter" ; units:unit units:hz ;
    lv2:minimum 20.0 ; lv2:maximum 20000.0 .

:p8 a val:Param ; val:slot 8 ; val:target :lfo ; val:property val:rate ;
    lv2:name "Vibrato Rate" ; lv2:symbol "vibrato_rate" ; val:section "Modulation" ; units:unit units:hz .
