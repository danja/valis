# examples/halloween-bass.ttl
#
# Three bass layers on one keyboard voice, for the half-time drop of a dubstep take on
# "Bela Lugosi's Dead": a sine sub an octave below the note, a pair of detuned saws through
# a ladder filter whose cutoff wobbles once every dotted eighth note of the host's tempo,
# and a harmonic wavetable growl whose position drifts and is then clipped.
#
# The wobble LFO is bipolar, so the Scale maps it around its centre: the cutoff sweeps from
# (2 x centre - top) up to top. Play it low; the sub is an octave below the played note.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:halloweenbass#> .

:halloweenbass a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Dubstep", "Bass", "Gothic" ;
    rdfs:label "Halloween: layered bass" ;
    val:element :pitch , :subHalf , :detune , :env , :sub , :subLvl , :sawA , :sawB , :sawMix , :wob , :wobScale , :ladder , :wobLvl , :growl , :growlLfo , :growlScale , :growlClip , :growlTone , :growlLvl , :sum , :vca , :dc , :comp , :limit , :out ;
    val:arc :a_pitch_out__subHalf_a ,
        :a_pitch_out__detune_a ,
        :a_subHalf_out__sub_frequency ,
        :a_pitch_out__sawA_frequency ,
        :a_detune_out__sawB_frequency ,
        :a_pitch_out__growl_frequency ,
        :a_sub_out__subLvl_in ,
        :a_sawA_out__sawMix_in ,
        :a_sawB_out__sawMix_in ,
        :a_wob_out__wobScale_in ,
        :a_wobScale_out__ladder_cutoff ,
        :a_sawMix_out__ladder_in ,
        :a_ladder_out__wobLvl_in ,
        :a_growlLfo_out__growlScale_in ,
        :a_growlScale_out__growl_position ,
        :a_growl_out__growlClip_in ,
        :a_growlClip_out__growlTone_in ,
        :a_growlTone_out__growlLvl_in ,
        :a_subLvl_out__sum_in ,
        :a_wobLvl_out__sum_in ,
        :a_growlLvl_out__sum_in ,
        :a_sum_out__vca_in ,
        :a_env_out__vca_cv ,
        :a_vca_out__dc_in ,
        :a_dc_out__comp_in ,
        :a_comp_out__limit_in ,
        :a_limit_out__out_in .

:pitch a val:MidiPitch .

:subHalf a val:ControlMultiply ;
    val:b 0.5 .

:detune a val:ControlMultiply ;
    val:b 1.006 .

:env a val:Envelope ;
    val:attack 4.0 ;
    val:decay 400.0 ;
    val:sustain 0.85 ;
    val:release 220.0 .

:sub a val:Oscillator ;
    val:shape 0 .

:subLvl a val:Gain ;
    val:gain -2.0 .

:sawA a val:Oscillator ;
    val:shape 1 .

:sawB a val:Oscillator ;
    val:shape 1 .

:sawMix a val:Mixer .

:wob a val:LFO ;
    val:shape 1 ;
    val:sync 0.75 .

:wobScale a val:Scale ;
    val:min 1000.0 ;
    val:max 1900.0 .

:ladder a val:Ladder ;
    val:resonance 0.6 ;
    val:drive 5.0 .

:wobLvl a val:Gain ;
    val:gain -6.0 .

:growl a val:Wavetable ;
    val:set 1 .

:growlLfo a val:LFO ;
    val:shape 0 ;
    val:sync 4.0 .

:growlScale a val:Scale ;
    val:min 0.55 ;
    val:max 0.4 .

:growlClip a val:Tanh ;
    val:gain 7.0 .

:growlTone a val:OnePole ;
    val:mode 0 ;
    val:cutoff 2400.0 .

:growlLvl a val:Gain ;
    val:gain -12.0 .

:sum a val:Mixer .

:vca a val:VCA .

:dc a val:OnePole ;
    val:mode 1 ;
    val:cutoff 22.0 .

:comp a val:Compressor ;
    val:threshold -14.0 ;
    val:ratio 4.0 .

:limit a val:Limiter ;
    val:ceiling -1.0 .

:out a val:Output .

:a_pitch_out__subHalf_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :subHalf ; val:port "a" ] .
:a_pitch_out__detune_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :detune ; val:port "a" ] .
:a_subHalf_out__sub_frequency a val:Arc ;
    val:from [ val:node :subHalf ; val:port "out" ] ;
    val:to   [ val:node :sub ; val:port "frequency" ] .
:a_pitch_out__sawA_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :sawA ; val:port "frequency" ] .
:a_detune_out__sawB_frequency a val:Arc ;
    val:from [ val:node :detune ; val:port "out" ] ;
    val:to   [ val:node :sawB ; val:port "frequency" ] .
:a_pitch_out__growl_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :growl ; val:port "frequency" ] .
:a_sub_out__subLvl_in a val:Arc ;
    val:from [ val:node :sub ; val:port "out" ] ;
    val:to   [ val:node :subLvl ; val:port "in" ] .
:a_sawA_out__sawMix_in a val:Arc ;
    val:from [ val:node :sawA ; val:port "out" ] ;
    val:to   [ val:node :sawMix ; val:port "in" ] .
:a_sawB_out__sawMix_in a val:Arc ;
    val:from [ val:node :sawB ; val:port "out" ] ;
    val:to   [ val:node :sawMix ; val:port "in" ] .
:a_wob_out__wobScale_in a val:Arc ;
    val:from [ val:node :wob ; val:port "out" ] ;
    val:to   [ val:node :wobScale ; val:port "in" ] .
:a_wobScale_out__ladder_cutoff a val:Arc ;
    val:from [ val:node :wobScale ; val:port "out" ] ;
    val:to   [ val:node :ladder ; val:port "cutoff" ] .
:a_sawMix_out__ladder_in a val:Arc ;
    val:from [ val:node :sawMix ; val:port "out" ] ;
    val:to   [ val:node :ladder ; val:port "in" ] .
:a_ladder_out__wobLvl_in a val:Arc ;
    val:from [ val:node :ladder ; val:port "out" ] ;
    val:to   [ val:node :wobLvl ; val:port "in" ] .
:a_growlLfo_out__growlScale_in a val:Arc ;
    val:from [ val:node :growlLfo ; val:port "out" ] ;
    val:to   [ val:node :growlScale ; val:port "in" ] .
:a_growlScale_out__growl_position a val:Arc ;
    val:from [ val:node :growlScale ; val:port "out" ] ;
    val:to   [ val:node :growl ; val:port "position" ] .
:a_growl_out__growlClip_in a val:Arc ;
    val:from [ val:node :growl ; val:port "out" ] ;
    val:to   [ val:node :growlClip ; val:port "in" ] .
:a_growlClip_out__growlTone_in a val:Arc ;
    val:from [ val:node :growlClip ; val:port "out" ] ;
    val:to   [ val:node :growlTone ; val:port "in" ] .
:a_growlTone_out__growlLvl_in a val:Arc ;
    val:from [ val:node :growlTone ; val:port "out" ] ;
    val:to   [ val:node :growlLvl ; val:port "in" ] .
:a_subLvl_out__sum_in a val:Arc ;
    val:from [ val:node :subLvl ; val:port "out" ] ;
    val:to   [ val:node :sum ; val:port "in" ] .
:a_wobLvl_out__sum_in a val:Arc ;
    val:from [ val:node :wobLvl ; val:port "out" ] ;
    val:to   [ val:node :sum ; val:port "in" ] .
:a_growlLvl_out__sum_in a val:Arc ;
    val:from [ val:node :growlLvl ; val:port "out" ] ;
    val:to   [ val:node :sum ; val:port "in" ] .
:a_sum_out__vca_in a val:Arc ;
    val:from [ val:node :sum ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "in" ] .
:a_env_out__vca_cv a val:Arc ;
    val:from [ val:node :env ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "cv" ] .
:a_vca_out__dc_in a val:Arc ;
    val:from [ val:node :vca ; val:port "out" ] ;
    val:to   [ val:node :dc ; val:port "in" ] .
:a_dc_out__comp_in a val:Arc ;
    val:from [ val:node :dc ; val:port "out" ] ;
    val:to   [ val:node :comp ; val:port "in" ] .
:a_comp_out__limit_in a val:Arc ;
    val:from [ val:node :comp ; val:port "out" ] ;
    val:to   [ val:node :limit ; val:port "in" ] .
:a_limit_out__out_in a val:Arc ;
    val:from [ val:node :limit ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in" ] .

:p0 a val:Param ; val:slot 0 ;
    val:target :wobScale ; val:property val:max ;
    lv2:name "Wobble top" ; lv2:symbol "wob_top" ;
    lv2:minimum 1200 ; lv2:maximum 6000 ;
    val:section "Wobble" ;
    units:unit units:hertz .
:p1 a val:Param ; val:slot 1 ;
    val:target :wobScale ; val:property val:min ;
    lv2:name "Wobble centre" ; lv2:symbol "wob_centre" ;
    lv2:minimum 300 ; lv2:maximum 2500 ;
    val:section "Wobble" ;
    units:unit units:hertz .
:p2 a val:Param ; val:slot 2 ;
    val:target :ladder ; val:property val:resonance ;
    lv2:name "Wobble resonance" ; lv2:symbol "wob_res" ;
    lv2:minimum 0 ; lv2:maximum 0.95 ;
    val:section "Wobble" .
:p3 a val:Param ; val:slot 3 ;
    val:target :ladder ; val:property val:drive ;
    lv2:name "Wobble drive" ; lv2:symbol "wob_drive" ;
    lv2:minimum 1 ; lv2:maximum 12 ;
    val:section "Wobble" .
:p4 a val:Param ; val:slot 4 ;
    val:target :subLvl ; val:property val:gain ;
    lv2:name "Sub level" ; lv2:symbol "sub_level" ;
    lv2:minimum -30 ; lv2:maximum 6 ;
    val:section "Mix" ;
    units:unit units:db .
:p5 a val:Param ; val:slot 5 ;
    val:target :wobLvl ; val:property val:gain ;
    lv2:name "Wobble level" ; lv2:symbol "wob_level" ;
    lv2:minimum -30 ; lv2:maximum 6 ;
    val:section "Mix" ;
    units:unit units:db .
:p6 a val:Param ; val:slot 6 ;
    val:target :growlLvl ; val:property val:gain ;
    lv2:name "Growl level" ; lv2:symbol "growl_level" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Mix" ;
    units:unit units:db .
:p7 a val:Param ; val:slot 7 ;
    val:target :growlClip ; val:property val:gain ;
    lv2:name "Growl drive" ; lv2:symbol "growl_drive" ;
    lv2:minimum 1 ; lv2:maximum 30 ;
    val:section "Growl" .
:p8 a val:Param ; val:slot 8 ;
    val:target :env ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ;
    lv2:minimum 20 ; lv2:maximum 1500 ;
    val:section "Envelope" ;
    units:unit units:ms .
:p9 a val:Param ; val:slot 9 ;
    val:target :env ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "decay" ;
    lv2:minimum 20 ; lv2:maximum 2000 ;
    val:section "Envelope" ;
    units:unit units:ms .
