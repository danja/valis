# examples/moog-source.ttl
#
# A monophonic analogue synthesiser voice in the manner of the Moog Source
# (https://en.wikipedia.org/wiki/Moog_Source), which played the bass line of New Order's 1983
# single "Blue Monday" from a sequencer. Two oscillators (a saw at the played pitch and a square
# an octave below, slightly sharp so they beat), a four-pole 24 dB per octave low-pass filter
# with emphasis, and two ADSR envelopes, one for the filter and one for the amplifier.
#
# The cutoff is the sum of the filter envelope's sweep and a share of the keyboard pitch
# (val:ControlAdd), so higher notes open the filter further. The short amp decay gives the
# pulsing, plucked bass of a sequenced line. Play it from E1 to E3.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:moogsource#> .

:moogsource a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Bass", "Synth", "Electro" ;
    rdfs:label "Moog Source bass" ;
    val:element :pitch , :osc2Ratio , :osc1 , :osc2 , :osc1Lvl , :osc2Lvl , :mix , :filtEnv , :filtScale , :track , :cutoff , :vcf , :ampEnv , :vca , :dc , :trim , :limit , :out ;
    val:arc :a_pitch_out__osc1_frequency ,
        :a_pitch_out__osc2Ratio_a ,
        :a_osc2Ratio_out__osc2_frequency ,
        :a_osc1_out__osc1Lvl_in ,
        :a_osc2_out__osc2Lvl_in ,
        :a_osc1Lvl_out__mix_in ,
        :a_osc2Lvl_out__mix_in ,
        :a_filtEnv_out__filtScale_in ,
        :a_pitch_out__track_a ,
        :a_filtScale_out__cutoff_a ,
        :a_track_out__cutoff_b ,
        :a_cutoff_out__vcf_cutoff ,
        :a_mix_out__vcf_in ,
        :a_vcf_out__vca_in ,
        :a_ampEnv_out__vca_cv ,
        :a_vca_out__dc_in ,
        :a_dc_out__trim_in ,
        :a_trim_out__limit_in ,
        :a_limit_out__out_in .

:pitch a val:MidiPitch .

:osc2Ratio a val:ControlMultiply ;
    val:b 0.5035 .

:osc1 a val:Oscillator ;
    val:shape 1 .

:osc2 a val:Oscillator ;
    val:shape 2 .

:osc1Lvl a val:Gain ;
    val:gain -3.0 .

:osc2Lvl a val:Gain ;
    val:gain -4.0 .

:mix a val:Mixer .

:filtEnv a val:Envelope ;
    val:attack 1.0 ;
    val:decay 170.0 ;
    val:sustain 0.18 ;
    val:release 110.0 .

:filtScale a val:Scale ;
    val:min 160.0 ;
    val:max 1900.0 .

:track a val:ControlMultiply ;
    val:b 0.9 .

:cutoff a val:ControlAdd .

:vcf a val:Ladder ;
    val:resonance 0.32 ;
    val:drive 2.2 .

:ampEnv a val:Envelope ;
    val:attack 1.5 ;
    val:decay 260.0 ;
    val:sustain 0.8 ;
    val:release 70.0 .

:vca a val:VCA .

:dc a val:OnePole ;
    val:mode 1 ;
    val:cutoff 24.0 .

:trim a val:Gain ;
    val:gain -3.0 .

:limit a val:Limiter ;
    val:ceiling -1.0 .

:out a val:Output .

:a_pitch_out__osc1_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :osc1 ; val:port "frequency" ] .
:a_pitch_out__osc2Ratio_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :osc2Ratio ; val:port "a" ] .
:a_osc2Ratio_out__osc2_frequency a val:Arc ;
    val:from [ val:node :osc2Ratio ; val:port "out" ] ;
    val:to   [ val:node :osc2 ; val:port "frequency" ] .
:a_osc1_out__osc1Lvl_in a val:Arc ;
    val:from [ val:node :osc1 ; val:port "out" ] ;
    val:to   [ val:node :osc1Lvl ; val:port "in" ] .
:a_osc2_out__osc2Lvl_in a val:Arc ;
    val:from [ val:node :osc2 ; val:port "out" ] ;
    val:to   [ val:node :osc2Lvl ; val:port "in" ] .
:a_osc1Lvl_out__mix_in a val:Arc ;
    val:from [ val:node :osc1Lvl ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .
:a_osc2Lvl_out__mix_in a val:Arc ;
    val:from [ val:node :osc2Lvl ; val:port "out" ] ;
    val:to   [ val:node :mix ; val:port "in" ] .
:a_filtEnv_out__filtScale_in a val:Arc ;
    val:from [ val:node :filtEnv ; val:port "out" ] ;
    val:to   [ val:node :filtScale ; val:port "in" ] .
:a_pitch_out__track_a a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :track ; val:port "a" ] .
:a_filtScale_out__cutoff_a a val:Arc ;
    val:from [ val:node :filtScale ; val:port "out" ] ;
    val:to   [ val:node :cutoff ; val:port "a" ] .
:a_track_out__cutoff_b a val:Arc ;
    val:from [ val:node :track ; val:port "out" ] ;
    val:to   [ val:node :cutoff ; val:port "b" ] .
:a_cutoff_out__vcf_cutoff a val:Arc ;
    val:from [ val:node :cutoff ; val:port "out" ] ;
    val:to   [ val:node :vcf ; val:port "cutoff" ] .
:a_mix_out__vcf_in a val:Arc ;
    val:from [ val:node :mix ; val:port "out" ] ;
    val:to   [ val:node :vcf ; val:port "in" ] .
:a_vcf_out__vca_in a val:Arc ;
    val:from [ val:node :vcf ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "in" ] .
:a_ampEnv_out__vca_cv a val:Arc ;
    val:from [ val:node :ampEnv ; val:port "out" ] ;
    val:to   [ val:node :vca ; val:port "cv" ] .
:a_vca_out__dc_in a val:Arc ;
    val:from [ val:node :vca ; val:port "out" ] ;
    val:to   [ val:node :dc ; val:port "in" ] .
:a_dc_out__trim_in a val:Arc ;
    val:from [ val:node :dc ; val:port "out" ] ;
    val:to   [ val:node :trim ; val:port "in" ] .
:a_trim_out__limit_in a val:Arc ;
    val:from [ val:node :trim ; val:port "out" ] ;
    val:to   [ val:node :limit ; val:port "in" ] .
:a_limit_out__out_in a val:Arc ;
    val:from [ val:node :limit ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in" ] .

:p0 a val:Param ; val:slot 0 ;
    val:target :filtScale ; val:property val:min ;
    lv2:name "Cutoff" ; lv2:symbol "cutoff" ;
    lv2:minimum 60 ; lv2:maximum 1500 ;
    val:section "Filter" ;
    units:unit units:hertz .
:p1 a val:Param ; val:slot 1 ;
    val:target :filtScale ; val:property val:max ;
    lv2:name "Envelope amount" ; lv2:symbol "env_amount" ;
    lv2:minimum 200 ; lv2:maximum 8000 ;
    val:section "Filter" ;
    units:unit units:hertz .
:p2 a val:Param ; val:slot 2 ;
    val:target :vcf ; val:property val:resonance ;
    lv2:name "Emphasis" ; lv2:symbol "emphasis" ;
    lv2:minimum 0 ; lv2:maximum 0.95 ;
    val:section "Filter" .
:p3 a val:Param ; val:slot 3 ;
    val:target :track ; val:property val:b ;
    lv2:name "Keyboard tracking" ; lv2:symbol "key_track" ;
    lv2:minimum 0 ; lv2:maximum 2 ;
    val:section "Filter" .
:p4 a val:Param ; val:slot 4 ;
    val:target :filtEnv ; val:property val:decay ;
    lv2:name "Filter decay" ; lv2:symbol "filter_decay" ;
    lv2:minimum 20 ; lv2:maximum 1500 ;
    val:section "Filter" ;
    units:unit units:ms .
:p5 a val:Param ; val:slot 5 ;
    val:target :osc2Lvl ; val:property val:gain ;
    lv2:name "Oscillator 2 level" ; lv2:symbol "osc2_level" ;
    lv2:minimum -40 ; lv2:maximum 6 ;
    val:section "Oscillators" ;
    units:unit units:db .
:p6 a val:Param ; val:slot 6 ;
    val:target :osc2Ratio ; val:property val:b ;
    lv2:name "Oscillator 2 ratio" ; lv2:symbol "osc2_ratio" ;
    lv2:minimum 0.25 ; lv2:maximum 2.05 ;
    val:section "Oscillators" .
:p7 a val:Param ; val:slot 7 ;
    val:target :vcf ; val:property val:drive ;
    lv2:name "Drive" ; lv2:symbol "drive" ;
    lv2:minimum 1 ; lv2:maximum 10 ;
    val:section "Filter" .
:p8 a val:Param ; val:slot 8 ;
    val:target :ampEnv ; val:property val:decay ;
    lv2:name "Amp decay" ; lv2:symbol "amp_decay" ;
    lv2:minimum 20 ; lv2:maximum 2000 ;
    val:section "Amplifier" ;
    units:unit units:ms .
:p9 a val:Param ; val:slot 9 ;
    val:target :ampEnv ; val:property val:release ;
    lv2:name "Amp release" ; lv2:symbol "amp_release" ;
    lv2:minimum 5 ; lv2:maximum 1000 ;
    val:section "Amplifier" ;
    units:unit units:ms .
