# examples/granular.ttl
#
# A granular synthesiser. It granulates a sound file, which can be changed from
# the Controls view, blends the result against the plugin's own audio input,
# tracks MIDI pitch when the MIDI In switch is on, and can take its grain timing
# from the host transport.
#
# Signal path (stereo from the granulator onward):
#
#   SampleLoad ──► Granulator ─┬─► Ladder L ──► VCA L ──► DryWet L ──► Output.left
#                              └─► Ladder R ──► VCA R ──► DryWet R ──► Output.right
#
#   Input ──────────────────────────────────────────► DryWet L.dry, DryWet R.dry
#
# The Mix knob crossfades each DryWet between the plugin's own input at 0 and
# the granulated signal at 1, and rests in the middle.
#
# Modulation:
#
#   Transport.trigger ──► clockGate (Scale) ──► Granulator.trigger
#   MidiInterval.semitones ──► pitchGate ────► Granulator.pitch
#   midi (Select) ──► Envelope.gate, and its thru ──► pitchGate.b
#   Envelope ───────────────────────────────► VCA L.cv, VCA R.cv
#   Envelope ──► toneScale (Scale) ─────────► Ladder L.cutoff, Ladder R.cutoff
#   mixScale (Scale) ───────────────────────► DryWet L.mix, DryWet R.mix
#
# The buffer. :sample is a val:SampleLoad playing samples/bell.wav on a loop,
# itself rendered from examples/rings-modal.ttl by valis-render. It appears in
# the Controls view as a file slot with a Load button, so the sample can be
# changed while the circuit runs. Its audio goes to the granulator's input, and
# the granulator records what arrives there, so the buffer holds the sample.
#
# Freeze decides what the buffer does with that input. On Record the buffer is
# a 1.2 second window sliding along the looping sample, so the texture keeps
# moving; on Freeze the window stops and the same moment repeats. Rewire
# :aInGran to :in to granulate the plugin's own audio input instead, and Freeze
# then captures whatever was playing.
#
# The grain clock. Transport.trigger is 1 for one control block on each
# division and 0 in between. Scale maps that 0-1 pulse onto [min, 1]:
#
#   Grain Clock = 0   the trigger port rests at 0, so grains fire only on the
#                     pulse - grain onsets lock to the host's tempo.
#   Grain Clock = -1  the trigger port rests at -1, which the granulator reads
#                     as "free-run", so grains fire at the Density rate instead.
#
# Pitch. MidiInterval gives the interval from the root note in semitones, which
# is what the granulator transposes by. Playing the root note plays the material
# at its recorded pitch; an octave up plays the grains twice as fast without
# changing how often they start.
#
# MIDI In. One switch decides whether notes reach the instrument at all. :midi
# is a val:Select: its out is the envelope's gate, 1 when the switch is off,
# which holds the envelope open so the circuit drones and works as an effect on
# whatever is at the audio input, and -1 when it is on, which returns the
# envelope to the host's own note gate. Its thru repeats the switch position as
# 0 or 1, and :pitchGate multiplies the played interval by it, so with MIDI off
# the material also stays at its recorded pitch.
#
# A control arc REPLACES the value of the port it reaches every block, so
# val:pitch, val:trigger, val:cutoff and val:cv carry no fixed value here: those
# live in the control path, in the Scale elements and in MidiInterval's root.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:granular#> .

:granular a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "Ambient", "Experimental", "Sound Design" ;
    rdfs:label "Granular" ;
    val:element :in , :sample , :gran ,
                :clock , :clockGate ,
                :key , :midi , :pitchGate ,
                :env , :toneScale ,
                :toneL , :toneR , :vcaL , :vcaR ,
                :mixScale , :mixL , :mixR , :out ;
    val:arc :aInGran ,
            :aGranToneL , :aGranToneR ,
            :aToneVcaL , :aToneVcaR ,
            :aVcaMixL , :aVcaMixR , :aInMixL , :aInMixR ,
            :aMixOutL , :aMixOutR ,
            :aClockGate , :aGateTrigger ,
            :aKeyPitch , :aPitchGateGran , :aMidiEnv , :aMidiThru ,
            :aEnvVcaL , :aEnvVcaR ,
            :aEnvTone , :aToneCutoffL , :aToneCutoffR ,
            :aMixL , :aMixR .

# ── Source ───────────────────────────────────────────────────────────────────

:in a val:Input .

# The Controls view draws this as a file slot with a Load button.
:sample a val:SampleLoad ;
    val:file  "samples/bell.wav" ;
    val:loop  1 ;              # a toggle in the Controls view
    val:speed 1.0 .

:gran a val:Granulator ;
    # Shorter than the sample on purpose: the buffer holds a window onto the
    # material rather than all of it, so Record slides that window along as the
    # sample loops and Freeze stops it on one moment.
    val:seconds  1.2 ;
    val:position 0.5 ;         # half a buffer behind the write head
    val:size     140.0 ;       # ms per grain
    val:density  22.0 ;        # grains per second when free-running
    val:spray    0.08 ;
    val:jitter   0.35 ;        # breaks up the periodicity of a fixed density
    val:pitchJitter 0.0 ;
    val:shape    0.6 ;
    val:spread   0.8 ;         # wide stereo placement
    val:reverse  0.0 ;
    val:scan     0.05 .        # a slow drift through the buffer
# val:pitch and val:trigger are intentionally absent: control arcs set them.

# ── Grain clock ──────────────────────────────────────────────────────────────

:clock a val:Transport ;
    val:division 0.25 .        # a sixteenth note

# min is the resting value of the trigger port: -1 free-runs, 0 waits for the
# transport's pulse.
:clockGate a val:Scale ;
    val:min -1.0 ;
    val:max  1.0 .

# ── Pitch and the MIDI switch ────────────────────────────────────────────────

:key a val:MidiInterval ;
    val:root 60.0 .            # middle C plays the material untransposed

# out goes to the envelope's gate: 1 holds it open, -1 returns it to the host's
# MIDI gate. thru is the same switch as 0 or 1, for the pitch path.
:midi a val:Select ;
    val:a 1.0 ;
    val:b -1.0 ;
    val:select 1.0 .           # on: the instrument starts out playable

# The played interval, multiplied by the switch: 0 semitones when MIDI is off.
:pitchGate a val:ControlMultiply .

# ── Amplitude and tone ───────────────────────────────────────────────────────

:env a val:Envelope ;
    val:attack  40.0 ;
    val:decay   600.0 ;
    val:sustain 0.85 ;
    val:release 900.0 .

:toneScale a val:Scale ;
    val:min 700.0 ;            # Hz — cutoff with the envelope closed
    val:max 14000.0 .          # Hz — cutoff at the envelope's peak

:toneL a val:Ladder ;
    val:resonance 0.12 ;
    val:drive     1.0 .

:toneR a val:Ladder ;
    val:resonance 0.12 ;
    val:drive     1.0 .

:vcaL a val:VCA .
:vcaR a val:VCA .

# ── Dry/wet ──────────────────────────────────────────────────────────────────

# mix rests at 0.5 in the Scale rather than on the DryWet instances: the control
# arcs from :mixScale replace whatever those carry.
:mixScale a val:Scale ;
    val:in  0.5 ;
    val:min 0.0 ;
    val:max 1.0 .

:mixL a val:DryWet .
:mixR a val:DryWet .

:out a val:Output .

# ── Audio arcs ───────────────────────────────────────────────────────────────

:aInGran a val:Arc ;
    val:from [ val:node :sample ; val:port "out" ] ;
    val:to   [ val:node :gran   ; val:port "in"  ] .

:aGranToneL a val:Arc ;
    val:from [ val:node :gran  ; val:port "left" ] ;
    val:to   [ val:node :toneL ; val:port "in"   ] .

:aGranToneR a val:Arc ;
    val:from [ val:node :gran  ; val:port "right" ] ;
    val:to   [ val:node :toneR ; val:port "in"    ] .

:aToneVcaL a val:Arc ;
    val:from [ val:node :toneL ; val:port "out" ] ;
    val:to   [ val:node :vcaL  ; val:port "in"  ] .

:aToneVcaR a val:Arc ;
    val:from [ val:node :toneR ; val:port "out" ] ;
    val:to   [ val:node :vcaR  ; val:port "in"  ] .

# The granulated signal is the wet side; the plugin's own input is the dry one.
:aVcaMixL a val:Arc ;
    val:from [ val:node :vcaL ; val:port "out" ] ;
    val:to   [ val:node :mixL ; val:port "wet" ] .

:aVcaMixR a val:Arc ;
    val:from [ val:node :vcaR ; val:port "out" ] ;
    val:to   [ val:node :mixR ; val:port "wet" ] .

:aInMixL a val:Arc ;
    val:from [ val:node :in   ; val:port "out" ] ;
    val:to   [ val:node :mixL ; val:port "dry" ] .

:aInMixR a val:Arc ;
    val:from [ val:node :in   ; val:port "out" ] ;
    val:to   [ val:node :mixR ; val:port "dry" ] .

:aMixOutL a val:Arc ;
    val:from [ val:node :mixL ; val:port "out"  ] ;
    val:to   [ val:node :out  ; val:port "left" ] .

:aMixOutR a val:Arc ;
    val:from [ val:node :mixR ; val:port "out"   ] ;
    val:to   [ val:node :out  ; val:port "right" ] .

# ── Control arcs ─────────────────────────────────────────────────────────────

:aClockGate a val:ControlArc ;
    val:from [ val:node :clock     ; val:port "trigger" ] ;
    val:to   [ val:node :clockGate ; val:port "in"      ] .

:aGateTrigger a val:ControlArc ;
    val:from [ val:node :clockGate ; val:port "out"     ] ;
    val:to   [ val:node :gran      ; val:port "trigger" ] .

:aKeyPitch a val:ControlArc ;
    val:from [ val:node :key       ; val:port "semitones" ] ;
    val:to   [ val:node :pitchGate ; val:port "a"         ] .

:aMidiThru a val:ControlArc ;
    val:from [ val:node :midi      ; val:port "thru" ] ;
    val:to   [ val:node :pitchGate ; val:port "b"    ] .

:aPitchGateGran a val:ControlArc ;
    val:from [ val:node :pitchGate ; val:port "out"   ] ;
    val:to   [ val:node :gran      ; val:port "pitch" ] .

# 1 holds the envelope open, -1 hands it back to the host's MIDI gate.
:aMidiEnv a val:ControlArc ;
    val:from [ val:node :midi ; val:port "out"  ] ;
    val:to   [ val:node :env  ; val:port "gate" ] .

:aEnvVcaL a val:ControlArc ;
    val:from [ val:node :env  ; val:port "out" ] ;
    val:to   [ val:node :vcaL ; val:port "cv"  ] .

:aEnvVcaR a val:ControlArc ;
    val:from [ val:node :env  ; val:port "out" ] ;
    val:to   [ val:node :vcaR ; val:port "cv"  ] .

:aEnvTone a val:ControlArc ;
    val:from [ val:node :env       ; val:port "out" ] ;
    val:to   [ val:node :toneScale ; val:port "in"  ] .

:aToneCutoffL a val:ControlArc ;
    val:from [ val:node :toneScale ; val:port "out"    ] ;
    val:to   [ val:node :toneL     ; val:port "cutoff" ] .

:aToneCutoffR a val:ControlArc ;
    val:from [ val:node :toneScale ; val:port "out"    ] ;
    val:to   [ val:node :toneR     ; val:port "cutoff" ] .

:aMixL a val:ControlArc ;
    val:from [ val:node :mixScale ; val:port "out" ] ;
    val:to   [ val:node :mixL     ; val:port "mix" ] .

:aMixR a val:ControlArc ;
    val:from [ val:node :mixScale ; val:port "out" ] ;
    val:to   [ val:node :mixR     ; val:port "mix" ] .

# ── Host parameters ──────────────────────────────────────────────────────────

:p0 a val:Param ; val:slot 0 ; val:target :gran ; val:property val:position ;
    lv2:name "Position" ; lv2:symbol "position" ; val:section "Grains" .

:p1 a val:Param ; val:slot 1 ; val:target :gran ; val:property val:size ;
    lv2:name "Size" ; lv2:symbol "size" ; val:section "Grains" ;
    units:unit units:ms ; lv2:minimum 5.0 ; lv2:maximum 1000.0 .

:p2 a val:Param ; val:slot 2 ; val:target :gran ; val:property val:density ;
    lv2:name "Density" ; lv2:symbol "density" ; val:section "Grains" ;
    units:unit units:hz ; lv2:minimum 0.5 ; lv2:maximum 120.0 .

:p3 a val:Param ; val:slot 3 ; val:target :gran ; val:property val:shape ;
    lv2:name "Shape" ; lv2:symbol "shape" ; val:section "Grains" .

:p4 a val:Param ; val:slot 4 ; val:target :gran ; val:property val:spray ;
    lv2:name "Spray" ; lv2:symbol "spray" ; val:section "Scatter" .

:p5 a val:Param ; val:slot 5 ; val:target :gran ; val:property val:jitter ;
    lv2:name "Jitter" ; lv2:symbol "jitter" ; val:section "Scatter" .

:p6 a val:Param ; val:slot 6 ; val:target :gran ; val:property val:pitchJitter ;
    lv2:name "Detune" ; lv2:symbol "detune" ; val:section "Scatter" ;
    lv2:minimum 0.0 ; lv2:maximum 12.0 .

:p7 a val:Param ; val:slot 7 ; val:target :gran ; val:property val:reverse ;
    lv2:name "Reverse" ; lv2:symbol "reverse" ; val:section "Scatter" .

:p8 a val:Param ; val:slot 8 ; val:target :gran ; val:property val:spread ;
    lv2:name "Width" ; lv2:symbol "width" ; val:section "Scatter" .

:p9 a val:Param ; val:slot 9 ; val:target :gran ; val:property val:scan ;
    lv2:name "Scan" ; lv2:symbol "scan" ; val:section "Buffer" ;
    lv2:minimum -1.0 ; lv2:maximum 1.0 .

# -1 keeps the loaded file, 0 records the audio input, 1 freezes what is there.
:p10 a val:Param ; val:slot 10 ; val:target :gran ; val:property val:freeze ;
    lv2:name "Freeze" ; lv2:symbol "freeze" ; val:section "Buffer" .

:p11 a val:Param ; val:slot 11 ; val:target :clock ; val:property val:division ;
    lv2:name "Division" ; lv2:symbol "division" ; val:section "Clock" ;
    lv2:minimum 0.0625 ; lv2:maximum 4.0 .

# 0 locks grain onsets to the transport; -1 free-runs them at Density.
:p12 a val:Param ; val:slot 12 ; val:target :clockGate ; val:property val:min ;
    lv2:name "Grain Clock" ; lv2:symbol "grain_clock" ; val:section "Clock" ;
    lv2:minimum -1.0 ; lv2:maximum 0.0 .

:p13 a val:Param ; val:slot 13 ; val:target :key ; val:property val:root ;
    lv2:name "Root Note" ; lv2:symbol "root_note" ; val:section "Pitch" ;
    lv2:minimum 24.0 ; lv2:maximum 96.0 .

# A binary choice, so the Controls view draws a switch rather than a dial.
:p14 a val:Param ; val:slot 14 ; val:target :midi ; val:property val:select ;
    lv2:name "MIDI In" ; lv2:symbol "midi_in" ; val:section "Pitch" .

:p15 a val:Param ; val:slot 15 ; val:target :toneScale ; val:property val:min ;
    lv2:name "Tone" ; lv2:symbol "tone" ; val:section "Filter" ;
    units:unit units:hz ; lv2:minimum 100.0 ; lv2:maximum 18000.0 .

:p16 a val:Param ; val:slot 16 ; val:target :toneScale ; val:property val:max ;
    lv2:name "Tone Peak" ; lv2:symbol "tone_peak" ; val:section "Filter" ;
    units:unit units:hz ; lv2:minimum 100.0 ; lv2:maximum 20000.0 .

:p17 a val:Param ; val:slot 17 ; val:target :env ; val:property val:attack ;
    lv2:name "Attack" ; lv2:symbol "attack" ; val:section "Envelope" ; units:unit units:ms .

:p18 a val:Param ; val:slot 18 ; val:target :env ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "decay" ; val:section "Envelope" ; units:unit units:ms .

:p19 a val:Param ; val:slot 19 ; val:target :env ; val:property val:sustain ;
    lv2:name "Sustain" ; lv2:symbol "sustain" ; val:section "Envelope" .

:p20 a val:Param ; val:slot 20 ; val:target :env ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ; val:section "Envelope" ; units:unit units:ms .

:p21 a val:Param ; val:slot 21 ; val:target :sample ; val:property val:loop ;
    lv2:name "Loop" ; lv2:symbol "loop" ; val:section "Sample" .

:p22 a val:Param ; val:slot 22 ; val:target :sample ; val:property val:speed ;
    lv2:name "Speed" ; lv2:symbol "speed" ; val:section "Sample" ;
    lv2:minimum -2.0 ; lv2:maximum 2.0 .

:p23 a val:Param ; val:slot 23 ; val:target :mixScale ; val:property val:in ;
    lv2:name "Mix" ; lv2:symbol "mix" ; val:section "Output" ;
    lv2:minimum 0.0 ; lv2:maximum 1.0 .
