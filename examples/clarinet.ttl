@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix :      <urn:valis:clarinet#> .

# Clarinet, built on the waveguide reed model.
#
# val:Reed is a cylindrical bore, stopped by the mouthpiece at one end and open
# at the other, driven by a pressure-controlled valve. A round trip reflects
# once with its sign inverted, so the tube holds a quarter wavelength and
# resonates at odd multiples of it. Measured at D4, the third harmonic comes out
# at 0.33 of the fundamental and the fifth at 0.19, while the second and fourth
# are under 0.005: that odd-harmonic spectrum is the clarinet's woody tone, and
# it comes out of the geometry rather than from any filtering.
#
# The envelope drives blowing pressure as well as the amplifier. A reed works
# over a band of pressure and does nothing outside it, so pressure is not a
# volume control: the Blow parameter sets how hard the note is played, and the
# envelope's attack is the time the player takes to get there.
#
# The one-pole after the reed stands for the bell, which radiates the high
# partials more readily than the low ones.
#
# Signal path: Reed → OnePole (bell) → VCA → Output
# Controls:    MidiPitch → Reed.frequency
#              Envelope  → blowScale → Reed.pressure, and → VCA.cv

:main a val:Circuit ;
    val:element :pitch, :env, :blowScale, :reed, :body, :amp, :out ;
    val:arc :aPitchReed, :aEnvBlow, :aBlowReed, :aReedBody, :aBodyAmp, :aEnvAmp, :aAmpOut .

:pitch a val:MidiPitch .
:env   a val:Envelope ; val:attack 30.0 ; val:decay 50.0 ;
                        val:sustain 0.8 ; val:release 200.0 .
:reed  a val:Reed ; val:stiffness 0.45 ; val:damping 0.2 ; val:breath 0.03 .

# The envelope is 0 to 1; the reed wants blowing pressure. Its maximum is the
# Blow parameter, which is how hard the note is played.
:blowScale a val:Scale ; val:min 0.0 ; val:max 0.75 .
:body  a val:OnePole ; val:cutoff 3000.0 .
:amp   a val:VCA .
:out   a val:Output .

# MidiPitch drives reed frequency for pitch tracking
:aPitchReed a val:Arc ;
    val:from [ val:node :pitch ; val:port "out"       ] ;
    val:to   [ val:node :reed  ; val:port "frequency" ] .

# Envelope shapes the breath contour, scaled by how hard the note is blown
:aEnvBlow a val:ControlArc ;
    val:from [ val:node :env       ; val:port "out" ] ;
    val:to   [ val:node :blowScale ; val:port "in"  ] .
:aBlowReed a val:ControlArc ;
    val:from [ val:node :blowScale ; val:port "out"      ] ;
    val:to   [ val:node :reed      ; val:port "pressure" ] .

# Audio chain
:aReedBody a val:Arc ;
    val:from [ val:node :reed ; val:port "out" ] ;
    val:to   [ val:node :body ; val:port "in"  ] .
:aBodyAmp a val:Arc ;
    val:from [ val:node :body ; val:port "out" ] ;
    val:to   [ val:node :amp  ; val:port "in"  ] .
:aAmpOut a val:Arc ;
    val:from [ val:node :amp ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in"  ] .

# Envelope also controls amplitude so the VCA closes between notes
:aEnvAmp a val:Arc ;
    val:from [ val:node :env ; val:port "out" ] ;
    val:to   [ val:node :amp ; val:port "cv"  ] .

# Host parameters
:p0 a val:Param ; val:slot 0 ; val:target :reed ; val:property val:stiffness ;
    lv2:name "Reed Stiffness" ; lv2:symbol "stiffness" .
:p1 a val:Param ; val:slot 1 ; val:target :reed ; val:property val:damping ;
    lv2:name "Damping"        ; lv2:symbol "damping" .
:p2 a val:Param ; val:slot 2 ; val:target :body ; val:property val:cutoff ;
    lv2:name "Brightness"     ; lv2:symbol "brightness" ; units:unit units:hz .
:p3 a val:Param ; val:slot 3 ; val:target :env  ; val:property val:attack ;
    lv2:name "Attack"         ; lv2:symbol "attack"     ; units:unit units:ms .
:p4 a val:Param ; val:slot 4 ; val:target :env  ; val:property val:decay ;
    lv2:name "Decay"          ; lv2:symbol "decay"      ; units:unit units:ms .
:p5 a val:Param ; val:slot 5 ; val:target :env  ; val:property val:sustain ;
    lv2:name "Sustain"        ; lv2:symbol "sustain" .
:p6 a val:Param ; val:slot 6 ; val:target :env  ; val:property val:release ;
    lv2:name "Release"        ; lv2:symbol "release"    ; units:unit units:ms .
:p7 a val:Param ; val:slot 7 ; val:target :blowScale ; val:property val:max ;
    lv2:name "Blow"           ; lv2:symbol "blow" ;
    lv2:minimum 0.3 ; lv2:maximum 1.0 .
:p8 a val:Param ; val:slot 8 ; val:target :reed ; val:property val:breath ;
    lv2:name "Breath"         ; lv2:symbol "breath" .
