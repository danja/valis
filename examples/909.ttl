    lv2:name "Snappy" ; lv2:symbol "sd_snappy" ; val:section "Snare" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 300.0 .

:pSdTone a val:Param ; val:slot 6 ;
