# examples/polysynth.ttl
#
# A polyphonic subtractive synthesiser: one voice written once, instantiated
# eight times as a pool.
#
# The elements in the voice are the ordinary monophonic ones. What makes the
# pool polyphonic is that the engine gives each copy its own note, so the
# oscillator and the envelope in voice 3 see a different note from the ones in
# voice 5. Allocation is the engine's: a note on goes to a voice that has never
# sounded, then to the one released longest ago, then to the oldest still held.
#
# The voice's audio output is summed by a val:Mixer the expansion adds, so
# everything after :poly sees one signal.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:polysynth#> .

################################################################
# One voice                                                    #
#                                                              #
# val:MidiPitch and val:Envelope read the note this copy was    #
# given, so the same definition sounds a different note in      #
# every voice.                                                 #
################################################################

:Voice a val:Subcircuit ;
    rdfs:label "Voice" ;

    lv2:port [ a lv2:OutputPort , lv2:AudioPort ;
               lv2:symbol "out" ; lv2:name "Out" ;
               val:node :vca ; val:port "out" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "cutoff" ; lv2:name "Cutoff" ;
               lv2:default 2400.0 ; lv2:minimum 80.0 ; lv2:maximum 12000.0 ;
               lv2:portProperty lv2:logarithmic ; units:unit units:hz ;
               val:node :vcf ; val:port "cutoff" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "resonance" ; lv2:name "Resonance" ;
               lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
               val:node :vcf ; val:port "resonance" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "decay" ; lv2:name "Decay" ;
               lv2:default 400.0 ; lv2:minimum 5.0 ; lv2:maximum 4000.0 ;
               units:unit units:ms ;
               val:node :env ; val:port "decay" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "release" ; lv2:name "Release" ;
               lv2:default 300.0 ; lv2:minimum 5.0 ; lv2:maximum 4000.0 ;
               units:unit units:ms ;
               val:node :env ; val:port "release" ] ;

    val:element :pitch , :osc , :vcf , :env , :vca ;
    val:arc :toOsc , :oscToVcf , :vcfToVca , :envToVca .

# The note this voice was given, as a frequency.
:pitch a val:MidiPitch .

:osc a val:Oscillator ; val:wave 1.0 .            # saw
:vcf a val:Ladder ; val:drive 1.2 .
:env a val:Envelope ; val:attack 5.0 ; val:sustain 0.7 .
:vca a val:VCA .

:toOsc a val:Arc ; val:from [ val:node :pitch ; val:port "out"       ] ;
                   val:to   [ val:node :osc   ; val:port "frequency" ] .

:oscToVcf a val:Arc ; val:from [ val:node :osc ; val:port "out" ] ;
                      val:to   [ val:node :vcf ; val:port "in"  ] .

:vcfToVca a val:Arc ; val:from [ val:node :vcf ; val:port "out" ] ;
                      val:to   [ val:node :vca ; val:port "in"  ] .

:envToVca a val:Arc ; val:from [ val:node :env ; val:port "out" ] ;
                      val:to   [ val:node :vca ; val:port "cv"  ] .

################################################################
# The circuit                                                  #
################################################################

:polysynth a val:Circuit ;
    rdfs:label "Polysynth" ;
    val:element :poly , :drive , :out ;
    val:arc :a1 , :a2 .

# Eight copies of the voice. One line is the whole of the polyphony.
:poly a :Voice ; val:voices 8 .

# Eight voices at once clip, so the sum goes through a soft saturator rather
# than into the output raw.
:drive a val:Tanh ; val:gain 0.7 ; val:antialiasing val:ADAA2 .

:out a val:Output .

:a1 a val:Arc ; val:from [ val:node :poly  ; val:port "out" ] ;
                val:to   [ val:node :drive ; val:port "in"  ] .
:a2 a val:Arc ; val:from [ val:node :drive ; val:port "out" ] ;
                val:to   [ val:node :out   ; val:port "in"  ] .

# A knob on a polyphonic instance's port drives every voice together, so the
# eight of them stay in step rather than drifting apart as it is turned.
:p0 a val:Param ; val:slot 0 ; val:target :poly ; val:property val:cutoff ;
    lv2:name "Cutoff" ; lv2:symbol "cutoff" ; units:unit units:hz .

:p1 a val:Param ; val:slot 1 ; val:target :poly ; val:property val:resonance ;
    lv2:name "Resonance" ; lv2:symbol "resonance" .

:p2 a val:Param ; val:slot 2 ; val:target :poly ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "decay" ; units:unit units:ms .

:p3 a val:Param ; val:slot 3 ; val:target :poly ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ; units:unit units:ms .
