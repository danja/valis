# examples/ducking.ttl
#
# Sidechain ducking. The left input channel is the trigger (a kick, say) and the
# right is what gets ducked (a pad or bass). An envelope follower on the left channel
# drives a VCA on the right through a val:Scale, which turns the follower's 0 to 1
# into a gain that starts at 1 and falls below zero; the VCA clamps it at 0, so even
# a quiet hit closes the gate hard. The follower's release is how long the pad takes
# to swell back. Both channels are mixed to the output.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:ducking#> .

:ducking a val:Circuit ;
    rdfs:label "Sidechain Ducking" ;
    val:element :in , :env , :duck , :vca , :mix , :out ;
    val:arc :aTrigEnv , :aPadVca , :aEnvDuck , :aDuckVca , :aTrigMix , :aVcaMix , :aMixOut .

:in a val:Input .

:env  a val:EnvelopeFollower ; val:attack 1.0 ; val:release 180.0 ; val:mode 0 .

# The resting gain lives in the control path, because a control arc replaces the
# VCA's own value.
:duck a val:Scale ; val:min 1.0 ; val:max -2.0 .

:vca a val:VCA .
:mix a val:Mixer .
:out a val:Output .

:aTrigEnv a val:Arc ; val:from [ val:node :in  ; val:port "left" ] ;
                      val:to   [ val:node :env ; val:port "in"   ] .
:aPadVca  a val:Arc ; val:from [ val:node :in  ; val:port "right" ] ;
                      val:to   [ val:node :vca ; val:port "in"    ] .
:aEnvDuck a val:ControlArc ; val:from [ val:node :env  ; val:port "out" ] ;
                             val:to   [ val:node :duck ; val:port "in"  ] .
:aDuckVca a val:ControlArc ; val:from [ val:node :duck ; val:port "out" ] ;
                             val:to   [ val:node :vca  ; val:port "cv"  ] .
:aTrigMix a val:Arc ; val:from [ val:node :in  ; val:port "left" ] ;
                      val:to   [ val:node :mix ; val:port "in"   ] .
:aVcaMix  a val:Arc ; val:from [ val:node :vca ; val:port "out" ] ;
                      val:to   [ val:node :mix ; val:port "in"   ] .
:aMixOut  a val:Arc ; val:from [ val:node :mix ; val:port "out" ] ;
                      val:to   [ val:node :out ; val:port "in"   ] .

:p0 a val:Param ; val:slot 0 ; val:target :env ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ; units:unit units:ms .
:p1 a val:Param ; val:slot 1 ; val:target :duck ; val:property val:max ;
    lv2:name "Depth" ; lv2:symbol "depth" .
