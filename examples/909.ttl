# examples/909.ttl
#
# TR-909 drum synthesiser — functional circuit model.
#
# Architecture notes:
#
# Bass Drum / Toms: the original uses a bridged-T resonant network that
# oscillates as a sine wave. Frequency is swept from a high attack peak down
# to the body note by a fast exponential pitch envelope, giving the
# characteristic thump. A Tanh stage adds the clipping seen in the output
# stage of the original.
#
# Snare: two sine oscillators at 180 Hz and 200 Hz are mixed before the tone
# VCA. Their 20 Hz beat produces the characteristic pitch wobble. White noise
# through a bandpass filter feeds a separate noise VCA (the "snappy" path),
# each with its own envelope.
#
# Hi-Hats: six square-wave oscillators in the original are reduced here to
# four, tuned to the first four inharmonic frequency ratios identified in
# circuit analyses: 562, 834, 1124, 1395 Hz (ratios 1 : 1.483 : 2.0 : 2.483).
# A high-pass filter removes the fundamental and low partials.
#
# General MIDI channel 10 note map:
#   36  Bass Drum
#   37  Rim Shot
#   38  Snare Drum
#   39  Hand Clap
#   41  Low Tom
#   43  Mid Tom
#   50  High Tom
#   42  Closed Hi-Hat
#   46  Open Hi-Hat

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:909#> .

:tr909 a val:Circuit ;
    rdfs:label "TR-909" ;
    val:element
        # Bass Drum
        :bdGate , :bdOsc , :bdPitchEnv , :bdPitchScale ,
        :bdAmpEnv , :bdSat , :bdVca ,
        # Snare Drum
        :sdGate ,
        :sdOsc1 , :sdOsc2 , :sdOscMix ,
        :sdNoise , :sdBpf ,
        :sdToneEnv , :sdToneVca ,
        :sdNoiseEnv , :sdNoiseVca ,
        :sdMix ,
        # Rim Shot
        :rsGate , :rsNoise , :rsHpf , :rsEnv , :rsVca ,
        # Hand Clap
        :cpGate , :cpNoise , :cpBpf , :cpEnv , :cpVca ,
        # Low Tom
        :ltGate , :ltOsc , :ltPitchEnv , :ltPitchScale , :ltAmpEnv , :ltVca ,
        # Mid Tom
        :mtGate , :mtOsc , :mtPitchEnv , :mtPitchScale , :mtAmpEnv , :mtVca ,
        # High Tom
        :htGate , :htOsc , :htPitchEnv , :htPitchScale , :htAmpEnv , :htVca ,
        # Closed Hi-Hat
        :chGate , :chOsc1 , :chOsc2 , :chOsc3 , :chOsc4 ,
        :chMix , :chHpf , :chEnv , :chVca ,
        # Open Hi-Hat
        :ohGate , :ohOsc1 , :ohOsc2 , :ohOsc3 , :ohOsc4 ,
        :ohMix , :ohHpf , :ohEnv , :ohVca ,
        # Output stage
        :mix , :out ;
    val:arc
        # Bass Drum
        :aBdGatePitchEnv , :aBdGateAmpEnv ,
        :aBdPitchEnvScale , :aBdScaleOsc ,
        :aBdOscSat , :aBdSatVca , :aBdEnvVca , :aBdVcaMix ,
        # Snare Drum
        :aSdGateToneEnv , :aSdGateNoiseEnv ,
        :aSdOsc1OscMix , :aSdOsc2OscMix ,
        :aSdOscMixToneVca , :aSdToneEnvToneVca ,
        :aSdNoiseBpf , :aSdBpfNoiseVca , :aSdNoiseEnvNoiseVca ,
        :aSdToneVcaMix , :aSdNoiseVcaMix , :aSdMixOut ,
        # Rim Shot
        :aRsGateEnv , :aRsNoiseHpf , :aRsHpfVca , :aRsEnvVca , :aRsVcaMix ,
        # Hand Clap
        :aCpGateEnv , :aCpNoiseBpf , :aCpBpfVca , :aCpEnvVca , :aCpVcaMix ,
        # Low Tom
        :aLtGatePitchEnv , :aLtGateAmpEnv ,
        :aLtPitchEnvScale , :aLtScaleOsc ,
        :aLtOscVca , :aLtAmpEnvVca , :aLtVcaMix ,
        # Mid Tom
        :aMtGatePitchEnv , :aMtGateAmpEnv ,
        :aMtPitchEnvScale , :aMtScaleOsc ,
        :aMtOscVca , :aMtAmpEnvVca , :aMtVcaMix ,
        # High Tom
        :aHtGatePitchEnv , :aHtGateAmpEnv ,
        :aHtPitchEnvScale , :aHtScaleOsc ,
        :aHtOscVca , :aHtAmpEnvVca , :aHtVcaMix ,
        # Closed Hi-Hat
        :aChGateEnv ,
        :aChOsc1Mix , :aChOsc2Mix , :aChOsc3Mix , :aChOsc4Mix ,
        :aChMixHpf , :aChHpfVca , :aChEnvVca , :aChVcaMix ,
        # Open Hi-Hat
        :aOhGateEnv ,
        :aOhOsc1Mix , :aOhOsc2Mix , :aOhOsc3Mix , :aOhOsc4Mix ,
        :aOhMixHpf , :aOhHpfVca , :aOhEnvVca , :aOhVcaMix ,
        # Output
        :aMixOut .

################################################################
# Bass Drum  (MIDI note 36)                                    #
#                                                              #
# The original uses a bridged-T resonant network (≈ sine wave) #
# with a fast exponential pitch sweep from ~200 Hz to ~55 Hz.  #
# The Tanh stage clips the output, adding punch.               #
################################################################

:bdGate a val:NoteGate ; val:note 36 .

# Bridged-T resonator approximated by a sine oscillator.
# Frequency is fully controlled by the pitch arc; the instance
# value is irrelevant but serves as documentation of the body pitch.
:bdOsc a val:Oscillator ;
    val:shape 0 .             # 0 = sine (bridged-T approximation)

# Very fast pitch drop: from the attack peak to the body frequency.
:bdPitchEnv a val:Envelope ;
    val:attack  0.2 ;         # ms
    val:decay   20.0 ;        # ms — fast drop gives the characteristic thump
    val:sustain 0.0 ;
    val:release 2.0 .

# min = body pitch (Tune control), max = attack pitch peak.
:bdPitchScale a val:Scale ;
    val:min 55.0 ;            # Hz — body frequency
    val:max 210.0 .           # Hz — attack peak

:bdAmpEnv a val:Envelope ;
    val:attack  1.0 ;         # ms
    val:decay   500.0 ;       # ms — Decay control range
    val:sustain 0.0 ;
    val:release 20.0 .

# Output stage clipping — models the saturation in the original's output amp.
:bdSat a val:Tanh ;
    val:gain 5.0 .

:bdVca a val:VCA .

################################################################
# Snare Drum  (MIDI note 38)                                   #
#                                                              #
# Two detuned sine oscillators (180 Hz + 200 Hz) give the tone #
# path. Their 20 Hz beating is the defining character of the   #
# 909 snare. White noise through a bandpass filter forms the   #
# "snappy" path. Each path has its own envelope and VCA.       #
################################################################

:sdGate a val:NoteGate ; val:note 38 .

# Two-oscillator tone section. The 20 Hz beat between them creates
# the characteristic wobble during the decay.
:sdOsc1 a val:Oscillator ;
    val:shape     0 ;         # sine
    val:frequency 180.0 .

:sdOsc2 a val:Oscillator ;
    val:shape     0 ;
    val:frequency 200.0 .

:sdOscMix a val:Mixer .      # sums the two oscillators

# Tone path: longer decay shapes the body of the snare.
:sdToneEnv a val:Envelope ;
    val:attack  0.2 ;
    val:decay   250.0 ;
    val:sustain 0.0 ;
    val:release 10.0 .

:sdToneVca a val:VCA .

# Noise path: bandpass centred around 2 kHz, shorter decay = "snappy".
:sdNoise a val:Noise ;
    val:colour 0 .            # white

:sdBpf a val:StateVariable ;
    val:cutoff    2000.0 ;
    val:resonance 0.5 .

:sdNoiseEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   80.0 ;        # Snappy control
    val:sustain 0.0 ;
    val:release 5.0 .

:sdNoiseVca a val:VCA .

:sdMix a val:Mixer .          # sums tone + noise outputs

################################################################
# Rim Shot  (MIDI note 37)                                     #
#                                                              #
# White noise through a high-pass filter gives the dry click   #
# of a stick on the drum rim. Very short decay.                #
################################################################

:rsGate a val:NoteGate ; val:note 37 .

:rsNoise a val:Noise ;
    val:colour 0 .

# HPF at 1.2 kHz removes the low-end thud, leaving the click.
:rsHpf a val:OnePole ;
    val:cutoff 1200.0 ;
    val:mode   1 .            # 1 = highpass

:rsEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   20.0 ;
    val:sustain 0.0 ;
    val:release 3.0 .

:rsVca a val:VCA .

################################################################
# Hand Clap  (MIDI note 39)                                    #
#                                                              #
# White noise through a resonant bandpass. The original circuit #
# produces multiple short bursts; approximated here as a single #
# filtered noise burst with a fast decay.                      #
################################################################

:cpGate a val:NoteGate ; val:note 39 .

:cpNoise a val:Noise ;
    val:colour 0 .

:cpBpf a val:StateVariable ;
    val:cutoff    1200.0 ;
    val:resonance 1.2 .       # higher resonance sharpens the "slap" character

:cpEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   80.0 ;
    val:sustain 0.0 ;
    val:release 8.0 .

:cpVca a val:VCA .

################################################################
# Low Tom  (MIDI note 41)                                      #
#                                                              #
# Same architecture as the Bass Drum: sine oscillator with a   #
# pitch sweep. Lower body frequency, medium decay.             #
################################################################

:ltGate a val:NoteGate ; val:note 41 .

:ltOsc a val:Oscillator ;
    val:shape 0 .             # sine

:ltPitchEnv a val:Envelope ;
    val:attack  0.2 ;
    val:decay   20.0 ;
    val:sustain 0.0 ;
    val:release 2.0 .

:ltPitchScale a val:Scale ;
    val:min 70.0 ;            # Hz — body pitch
    val:max 200.0 .           # Hz — attack peak

:ltAmpEnv a val:Envelope ;
    val:attack  1.0 ;
    val:decay   500.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:ltVca a val:VCA .

################################################################
# Mid Tom  (MIDI note 43)                                      #
################################################################

:mtGate a val:NoteGate ; val:note 43 .

:mtOsc a val:Oscillator ;
    val:shape 0 .

:mtPitchEnv a val:Envelope ;
    val:attack  0.2 ;
    val:decay   18.0 ;
    val:sustain 0.0 ;
    val:release 2.0 .

:mtPitchScale a val:Scale ;
    val:min 110.0 ;
    val:max 300.0 .

:mtAmpEnv a val:Envelope ;
    val:attack  1.0 ;
    val:decay   350.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:mtVca a val:VCA .

################################################################
# High Tom  (MIDI note 50)                                     #
################################################################

:htGate a val:NoteGate ; val:note 50 .

:htOsc a val:Oscillator ;
    val:shape 0 .

:htPitchEnv a val:Envelope ;
    val:attack  0.2 ;
    val:decay   15.0 ;
    val:sustain 0.0 ;
    val:release 2.0 .

:htPitchScale a val:Scale ;
    val:min 160.0 ;
    val:max 420.0 .

:htAmpEnv a val:Envelope ;
    val:attack  1.0 ;
    val:decay   250.0 ;
    val:sustain 0.0 ;
    val:release 15.0 .

:htVca a val:VCA .

################################################################
# Closed Hi-Hat  (MIDI note 42)                                #
#                                                              #
# Four square-wave oscillators at inharmonic ratios derived     #
# from circuit analysis of the original:                       #
#   562 Hz × {1, 1.483, 2.0, 2.483} = 562, 834, 1124, 1395 Hz #
# High-pass at 7 kHz leaves only the upper metallic partials.  #
# Very short decay.                                            #
################################################################

:chGate a val:NoteGate ; val:note 42 .

:chOsc1 a val:Oscillator ; val:shape 2 ; val:frequency  562.0 .   # square
:chOsc2 a val:Oscillator ; val:shape 2 ; val:frequency  834.0 .
:chOsc3 a val:Oscillator ; val:shape 2 ; val:frequency 1124.0 .
:chOsc4 a val:Oscillator ; val:shape 2 ; val:frequency 1395.0 .

:chMix a val:Mixer .

:chHpf a val:StateVariable ;
    val:cutoff    7000.0 ;
    val:resonance 0.4 .

:chEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   45.0 ;
    val:sustain 0.0 ;
    val:release 5.0 .

:chVca a val:VCA .

################################################################
# Open Hi-Hat  (MIDI note 46)                                  #
#                                                              #
# Identical spectral source to the closed hat. Longer decay.   #
# The original circuit includes a choke that mutes the open    #
# hat when the closed hat triggers; not modelled here.         #
# TODO: implement choke via a UnitDelay feedback path.         #
################################################################

:ohGate a val:NoteGate ; val:note 46 .

:ohOsc1 a val:Oscillator ; val:shape 2 ; val:frequency  562.0 .
:ohOsc2 a val:Oscillator ; val:shape 2 ; val:frequency  834.0 .
:ohOsc3 a val:Oscillator ; val:shape 2 ; val:frequency 1124.0 .
:ohOsc4 a val:Oscillator ; val:shape 2 ; val:frequency 1395.0 .

:ohMix a val:Mixer .

:ohHpf a val:StateVariable ;
    val:cutoff    7000.0 ;
    val:resonance 0.4 .

:ohEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   500.0 ;
    val:sustain 0.0 ;
    val:release 40.0 .

:ohVca a val:VCA .

################################################################
# Output stage                                                 #
################################################################

:mix a val:Mixer .
:out a val:Output .

################################################################
# Bass Drum arcs                                               #
################################################################

:aBdGatePitchEnv a val:ControlArc ;
    val:from [ val:node :bdGate    ; val:port "gate" ] ;
    val:to   [ val:node :bdPitchEnv ; val:port "gate" ] .

:aBdGateAmpEnv a val:ControlArc ;
    val:from [ val:node :bdGate   ; val:port "gate" ] ;
    val:to   [ val:node :bdAmpEnv ; val:port "gate" ] .

:aBdPitchEnvScale a val:ControlArc ;
    val:from [ val:node :bdPitchEnv   ; val:port "out" ] ;
    val:to   [ val:node :bdPitchScale ; val:port "in"  ] .

:aBdScaleOsc a val:ControlArc ;
    val:from [ val:node :bdPitchScale ; val:port "out"       ] ;
    val:to   [ val:node :bdOsc        ; val:port "frequency" ] .

:aBdOscSat a val:Arc ;
    val:from [ val:node :bdOsc ; val:port "out" ] ;
    val:to   [ val:node :bdSat ; val:port "in"  ] .

:aBdSatVca a val:Arc ;
    val:from [ val:node :bdSat ; val:port "out" ] ;
    val:to   [ val:node :bdVca ; val:port "in"  ] .

:aBdEnvVca a val:ControlArc ;
    val:from [ val:node :bdAmpEnv ; val:port "out" ] ;
    val:to   [ val:node :bdVca    ; val:port "cv"  ] .

:aBdVcaMix a val:Arc ;
    val:from [ val:node :bdVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Snare Drum arcs                                              #
################################################################

:aSdGateToneEnv a val:ControlArc ;
    val:from [ val:node :sdGate    ; val:port "gate" ] ;
    val:to   [ val:node :sdToneEnv ; val:port "gate" ] .

:aSdGateNoiseEnv a val:ControlArc ;
    val:from [ val:node :sdGate     ; val:port "gate" ] ;
    val:to   [ val:node :sdNoiseEnv ; val:port "gate" ] .

# Both oscillators sum in the oscillator mixer.
:aSdOsc1OscMix a val:Arc ;
    val:from [ val:node :sdOsc1  ; val:port "out" ] ;
    val:to   [ val:node :sdOscMix ; val:port "in"  ] .

:aSdOsc2OscMix a val:Arc ;
    val:from [ val:node :sdOsc2  ; val:port "out" ] ;
    val:to   [ val:node :sdOscMix ; val:port "in"  ] .

:aSdOscMixToneVca a val:Arc ;
    val:from [ val:node :sdOscMix  ; val:port "out" ] ;
    val:to   [ val:node :sdToneVca ; val:port "in"  ] .

:aSdToneEnvToneVca a val:ControlArc ;
    val:from [ val:node :sdToneEnv ; val:port "out" ] ;
    val:to   [ val:node :sdToneVca ; val:port "cv"  ] .

:aSdNoiseBpf a val:Arc ;
    val:from [ val:node :sdNoise ; val:port "out" ] ;
    val:to   [ val:node :sdBpf   ; val:port "in"  ] .

# Bandpass output of the filter feeds the noise VCA.
:aSdBpfNoiseVca a val:Arc ;
    val:from [ val:node :sdBpf     ; val:port "bp"  ] ;
    val:to   [ val:node :sdNoiseVca ; val:port "in"  ] .

:aSdNoiseEnvNoiseVca a val:ControlArc ;
    val:from [ val:node :sdNoiseEnv ; val:port "out" ] ;
    val:to   [ val:node :sdNoiseVca  ; val:port "cv"  ] .

# Tone and noise outputs sum in the snare local mixer.
:aSdToneVcaMix a val:Arc ;
    val:from [ val:node :sdToneVca ; val:port "out" ] ;
    val:to   [ val:node :sdMix     ; val:port "in"  ] .

:aSdNoiseVcaMix a val:Arc ;
    val:from [ val:node :sdNoiseVca ; val:port "out" ] ;
    val:to   [ val:node :sdMix      ; val:port "in"  ] .

:aSdMixOut a val:Arc ;
    val:from [ val:node :sdMix ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Rim Shot arcs                                                #
################################################################

:aRsGateEnv a val:ControlArc ;
    val:from [ val:node :rsGate ; val:port "gate" ] ;
    val:to   [ val:node :rsEnv  ; val:port "gate" ] .

:aRsNoiseHpf a val:Arc ;
    val:from [ val:node :rsNoise ; val:port "out" ] ;
    val:to   [ val:node :rsHpf   ; val:port "in"  ] .

:aRsHpfVca a val:Arc ;
    val:from [ val:node :rsHpf ; val:port "out" ] ;
    val:to   [ val:node :rsVca ; val:port "in"  ] .

:aRsEnvVca a val:ControlArc ;
    val:from [ val:node :rsEnv ; val:port "out" ] ;
    val:to   [ val:node :rsVca ; val:port "cv"  ] .

:aRsVcaMix a val:Arc ;
    val:from [ val:node :rsVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Hand Clap arcs                                               #
################################################################

:aCpGateEnv a val:ControlArc ;
    val:from [ val:node :cpGate ; val:port "gate" ] ;
    val:to   [ val:node :cpEnv  ; val:port "gate" ] .

:aCpNoiseBpf a val:Arc ;
    val:from [ val:node :cpNoise ; val:port "out" ] ;
    val:to   [ val:node :cpBpf   ; val:port "in"  ] .

:aCpBpfVca a val:Arc ;
    val:from [ val:node :cpBpf ; val:port "bp"  ] ;
    val:to   [ val:node :cpVca ; val:port "in"  ] .

:aCpEnvVca a val:ControlArc ;
    val:from [ val:node :cpEnv ; val:port "out" ] ;
    val:to   [ val:node :cpVca ; val:port "cv"  ] .

:aCpVcaMix a val:Arc ;
    val:from [ val:node :cpVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Low Tom arcs                                                 #
################################################################

:aLtGatePitchEnv a val:ControlArc ;
    val:from [ val:node :ltGate    ; val:port "gate" ] ;
    val:to   [ val:node :ltPitchEnv ; val:port "gate" ] .

:aLtGateAmpEnv a val:ControlArc ;
    val:from [ val:node :ltGate  ; val:port "gate" ] ;
    val:to   [ val:node :ltAmpEnv ; val:port "gate" ] .

:aLtPitchEnvScale a val:ControlArc ;
    val:from [ val:node :ltPitchEnv   ; val:port "out" ] ;
    val:to   [ val:node :ltPitchScale ; val:port "in"  ] .

:aLtScaleOsc a val:ControlArc ;
    val:from [ val:node :ltPitchScale ; val:port "out"       ] ;
    val:to   [ val:node :ltOsc        ; val:port "frequency" ] .

:aLtOscVca a val:Arc ;
    val:from [ val:node :ltOsc ; val:port "out" ] ;
    val:to   [ val:node :ltVca ; val:port "in"  ] .

:aLtAmpEnvVca a val:ControlArc ;
    val:from [ val:node :ltAmpEnv ; val:port "out" ] ;
    val:to   [ val:node :ltVca    ; val:port "cv"  ] .

:aLtVcaMix a val:Arc ;
    val:from [ val:node :ltVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Mid Tom arcs                                                 #
################################################################

:aMtGatePitchEnv a val:ControlArc ;
    val:from [ val:node :mtGate    ; val:port "gate" ] ;
    val:to   [ val:node :mtPitchEnv ; val:port "gate" ] .

:aMtGateAmpEnv a val:ControlArc ;
    val:from [ val:node :mtGate  ; val:port "gate" ] ;
    val:to   [ val:node :mtAmpEnv ; val:port "gate" ] .

:aMtPitchEnvScale a val:ControlArc ;
    val:from [ val:node :mtPitchEnv   ; val:port "out" ] ;
    val:to   [ val:node :mtPitchScale ; val:port "in"  ] .

:aMtScaleOsc a val:ControlArc ;
    val:from [ val:node :mtPitchScale ; val:port "out"       ] ;
    val:to   [ val:node :mtOsc        ; val:port "frequency" ] .

:aMtOscVca a val:Arc ;
    val:from [ val:node :mtOsc ; val:port "out" ] ;
    val:to   [ val:node :mtVca ; val:port "in"  ] .

:aMtAmpEnvVca a val:ControlArc ;
    val:from [ val:node :mtAmpEnv ; val:port "out" ] ;
    val:to   [ val:node :mtVca    ; val:port "cv"  ] .

:aMtVcaMix a val:Arc ;
    val:from [ val:node :mtVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# High Tom arcs                                                #
################################################################

:aHtGatePitchEnv a val:ControlArc ;
    val:from [ val:node :htGate    ; val:port "gate" ] ;
    val:to   [ val:node :htPitchEnv ; val:port "gate" ] .

:aHtGateAmpEnv a val:ControlArc ;
    val:from [ val:node :htGate  ; val:port "gate" ] ;
    val:to   [ val:node :htAmpEnv ; val:port "gate" ] .

:aHtPitchEnvScale a val:ControlArc ;
    val:from [ val:node :htPitchEnv   ; val:port "out" ] ;
    val:to   [ val:node :htPitchScale ; val:port "in"  ] .

:aHtScaleOsc a val:ControlArc ;
    val:from [ val:node :htPitchScale ; val:port "out"       ] ;
    val:to   [ val:node :htOsc        ; val:port "frequency" ] .

:aHtOscVca a val:Arc ;
    val:from [ val:node :htOsc ; val:port "out" ] ;
    val:to   [ val:node :htVca ; val:port "in"  ] .

:aHtAmpEnvVca a val:ControlArc ;
    val:from [ val:node :htAmpEnv ; val:port "out" ] ;
    val:to   [ val:node :htVca    ; val:port "cv"  ] .

:aHtVcaMix a val:Arc ;
    val:from [ val:node :htVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Closed Hi-Hat arcs                                           #
################################################################

:aChGateEnv a val:ControlArc ;
    val:from [ val:node :chGate ; val:port "gate" ] ;
    val:to   [ val:node :chEnv  ; val:port "gate" ] .

:aChOsc1Mix a val:Arc ;
    val:from [ val:node :chOsc1 ; val:port "out" ] ;
    val:to   [ val:node :chMix  ; val:port "in"  ] .

:aChOsc2Mix a val:Arc ;
