# examples/dd3.ttl
#
# A bucket-brigade delay pedal in the manner of the Boss DD-3: the dry signal always
# passes at full level, and the delayed signal is added to it at the effect level.
#
# The delay itself is a val:BucketBrigade, which ties bandwidth to delay time: set the
# time long and the repeats go dark, and they go darker with every trip round the feedback
# loop. The pedal's range switch (12.5 to 50, 50 to 200 and 200 to 800 ms) and hold mode
# are not modelled; the time parameter covers 12.5 to 800 ms in one sweep.
#
# Signal path:
#   Input ─┬──────────────────────────► mix ─► Output
#          └─► BucketBrigade ─► level ─►

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:dd3#> .

:dd3 a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "Guitar", "Ambient" ;
    rdfs:label "BBD Delay (DD-3 style)" ;
    val:element :in , :bbd , :level , :mix , :out ;
    val:arc :aInBbd , :aBbdLevel , :aLevelMix , :aInMix , :aMixOut .

:in    a val:Input .
:bbd   a val:BucketBrigade ; val:time 300.0 ; val:feedback 0.35 ; val:bandwidth 0.35 ;
                             val:noise -75.0 ; val:compander 1 ; val:seed 3 .
:level a val:Gain ; val:gain -6.0 .
:mix   a val:Mixer .
:out   a val:Output .

:aInBbd   a val:Arc ; val:from [ val:node :in    ; val:port "out" ] ;
                      val:to   [ val:node :bbd   ; val:port "in"  ] .
:aBbdLevel a val:Arc ; val:from [ val:node :bbd   ; val:port "out" ] ;
                       val:to   [ val:node :level ; val:port "in"  ] .
:aLevelMix a val:Arc ; val:from [ val:node :level ; val:port "out" ] ;
                       val:to   [ val:node :mix   ; val:port "in"  ] .
:aInMix   a val:Arc ; val:from [ val:node :in    ; val:port "out" ] ;
                      val:to   [ val:node :mix   ; val:port "in"  ] .
:aMixOut  a val:Arc ; val:from [ val:node :mix   ; val:port "out" ] ;
                      val:to   [ val:node :out   ; val:port "in"  ] .

:p0 a val:Param ; val:slot 0 ; val:target :bbd ; val:property val:time ;
    lv2:name "Delay Time" ; lv2:symbol "time" ; units:unit units:ms ;
    lv2:minimum 12.5 ; lv2:maximum 800.0 .

:p1 a val:Param ; val:slot 1 ; val:target :bbd ; val:property val:feedback ;
    lv2:name "Feedback" ; lv2:symbol "feedback" .

:p2 a val:Param ; val:slot 2 ; val:target :level ; val:property val:gain ;
    lv2:name "E. Level" ; lv2:symbol "level" ; units:unit units:db ;
    lv2:minimum -40.0 ; lv2:maximum 6.0 .

:p3 a val:Param ; val:slot 3 ; val:target :bbd ; val:property val:bandwidth ;
    lv2:name "Bandwidth" ; lv2:symbol "bandwidth" ; val:section "Chip" .
