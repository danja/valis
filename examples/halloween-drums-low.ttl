:p0 a val:Param ; val:slot 0 ;
    val:target :kPScale ; val:property val:min ;
    lv2:name "Kick tune" ; lv2:symbol "kick_tune" ;
    lv2:minimum 34 ; lv2:maximum 90 ;
    val:section "Kick" ;
    units:unit units:hertz .
:p1 a val:Param ; val:slot 1 ;
    val:target :kOsc ; val:property val:decay ;
    lv2:name "Kick decay" ; lv2:symbol "kick_decay" ;
    lv2:minimum 200 ; lv2:maximum 1200 ;
    val:section "Kick" ;
    units:unit units:ms .
:p2 a val:Param ; val:slot 2 ;
    val:target :kSubGain ; val:property val:gain ;
    lv2:name "Sub level" ; lv2:symbol "sub_level" ;
    lv2:minimum -30 ; lv2:maximum 6 ;
    val:section "Kick" ;
    units:unit units:db .
:p3 a val:Param ; val:slot 3 ;
    val:target :kSat ; val:property val:gain ;
    lv2:name "Kick drive" ; lv2:symbol "kick_drive" ;
    lv2:minimum 1 ; lv2:maximum 15 ;
    val:section "Kick" .
:p4 a val:Param ; val:slot 4 ;
    val:target :t1Osc ; val:property val:decay ;
    lv2:name "Tom decay" ; lv2:symbol "tom_decay" ;
    lv2:minimum 300 ; lv2:maximum 2500 ;
    val:section "Toms" ;
    units:unit units:ms .
:p5 a val:Param ; val:slot 5 ;
    val:target :hall ; val:property val:mix ;
    lv2:name "Hall mix" ; lv2:symbol "hall_mix" ;
    lv2:minimum 0 ; lv2:maximum 1 ;
    val:section "Hall" .
:p6 a val:Param ; val:slot 6 ;
    val:target :hall ; val:property val:decay ;
    lv2:name "Hall decay" ; lv2:symbol "hall_decay" ;
    lv2:minimum 1 ; lv2:maximum 12 ;
    val:section "Hall" ;
    units:unit units:s .
:p7 a val:Param ; val:slot 7 ;
    val:target :sCut ; val:property val:max ;
    lv2:name "Slam brightness" ; lv2:symbol "slam_bright" ;
    lv2:minimum 1000 ; lv2:maximum 9000 ;
    val:section "Slam" ;
    units:unit units:hertz .
:p8 a val:Param ; val:slot 8 ;
    val:target :tape ; val:property val:drive ;
    lv2:name "Tape drive" ; lv2:symbol "tape_drive" ;
    lv2:minimum 0 ; lv2:maximum 24 ;
    val:section "Master" ;
    units:unit units:db .
