# vocabs/valis.ttl
#
# The Valis vocabulary. Loaded at runtime by ElementRegistry, not merely
# documentation: a unit test asserts that the set of classes carrying
# val:implementation here and the set of factories registered in C++ are equal
# in both directions, so drift is a test failure rather than a surprise.
#
# Port and control-range description reuses lv2: and units: rather than
# inventing terms. See vocabs/lv2/ for the copies this file is written against.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .

<http://purl.org/stuff/valis/>
    a owl:Ontology ;
    rdfs:label "Valis" ;
    rdfs:comment "Virtual analog circuits described in RDF." .

################################################################
# Properties                                                   #
################################################################

val:implementation a rdf:Property ;
    rdfs:label "implementation" ;
    rdfs:domain rdfs:Class ;
    rdfs:range xsd:string ;
    rdfs:comment """The ElementRegistry key that constructs this class. A key,
not a file path: C++ has no dynamic import. A class without this property is
abstract and cannot be instantiated.""" .

val:linear a rdf:Property ;
    rdfs:label "linear" ;
    rdfs:range xsd:boolean ;
    rdfs:comment """Whether the element is linear. A property, not a class:
val:Ladder is a nonlinear val:Filter, so linearity is orthogonal to the
Filter/Transfer split.""" .

val:element a rdf:Property ; rdfs:domain val:Circuit ; rdfs:range val:Element ;
    rdfs:comment "Relates a circuit to an element it contains." .
val:arc a rdf:Property ; rdfs:domain val:Circuit ; rdfs:range val:Arc ;
    rdfs:comment "Relates a circuit to an arc it contains." .

val:from a rdf:Property ; rdfs:domain val:Arc ; rdfs:range val:Endpoint .
val:to   a rdf:Property ; rdfs:domain val:Arc ; rdfs:range val:Endpoint .
val:node a rdf:Property ; rdfs:domain val:Endpoint ; rdfs:range val:Element .
val:port a rdf:Property ; rdfs:domain val:Endpoint ; rdfs:range xsd:string ;
    rdfs:comment "The lv2:symbol of the port at this end of the arc." .

val:depth a rdf:Property ; rdfs:domain val:Arc ; rdfs:range xsd:double ;
    rdfs:comment """Modulation depth, for an arc ending on an lv2:ControlPort.
Depth is a property of the connection, not of either endpoint: the same source
may drive two destinations by different amounts. Ignored on audio arcs.""" .

val:option a rdf:Property ; rdfs:domain val:Subcircuit ;
    rdfs:comment """Exposes one of an inner element's options under a name an
instance can set, the way lv2:port exposes an inner port. lv2:symbol is the name
the instance uses, val:node names the element to set it on, and val:property
names the key there when it differs from the symbol.

Options are not ports. The ontology declares an element's ports but says nothing
about which option keys it accepts, and DspElement::setOption answers true for a
key it does not know, so nothing can tell which inner element would recognise a
key. Forwarding an option to whichever element wanted it would therefore be a
guess. The definition names its targets instead.

More than one val:node on the same option is a deliberate fan-out: both elements
are set. Two inner elements taking the same key is then something the author
asked for rather than a collision to break.

    :Voice a val:Subcircuit ;
        val:option [ lv2:symbol "file" ; val:node :player ] ;
        val:element :player .

    :kick a :Voice ; val:file "samples/Kick01.wav" .""" .

val:voices a rdf:Property ; rdfs:domain val:Subcircuit ; rdfs:range xsd:integer ;
    rdfs:comment """Instantiates a val:Subcircuit this many times as a pool of
voices, between 1 and 16. Set on the instance, not on the definition, so one
definition serves both a monophonic and a polyphonic circuit.

The elements inside are the ordinary monophonic ones. What makes the pool
polyphonic is that the engine gives each copy its own note: a note on is
allocated to a voice, and every element in that copy sees that note's gate,
velocity and number rather than the circuit's.

Allocation is deterministic, so the same circuit renders the same way every
time: a voice that has never sounded first, then the one whose note was released
longest ago, then the oldest still held. A released voice is not reused
immediately, because whatever is in it still has a release tail to finish.

An input port of the instance reaches every voice. An output port is summed by a
val:Mixer the expansion adds, so everything downstream sees one signal. A control
output cannot be exposed, because there is one value per voice and no honest way
to choose between them.""" .

val:hasOption a rdf:Property ; rdfs:domain val:Element ; rdfs:range rdf:Property ;
    rdfs:comment """Names a val: property, other than a port, that an element class accepts on
an instance: a file, a pattern, a buffer length. The property is declared once with
what it means; each class lists the ones it takes. Every element also accepts
val:oversampling. An option the element recognises but cannot apply fails the load with
a message naming the element and the option; one it does not recognise is ignored.""" .

val:fftSize a rdf:Property ; rdfs:range xsd:integer ;
    rdfs:label "fftSize" ;
    rdfs:comment """The window of a spectral element, in samples: a power of two from 64 to 8192
(default 1024). A larger window separates frequencies more finely and costs more latency, which
the element reports to the host.""" .

val:model a rdf:Property ; rdfs:range xsd:string ;
    rdfs:label "model" ;
    rdfs:comment """Path to a Neural Amp Modeler capture, a .nam file, read on the message thread.
Paths resolve as val:file does. A file that is missing, unreadable or trained at another sample
rate does not fail the load: the element passes its input through and reports why in
get_diagnostics.""" .

val:oversampling a rdf:Property ; rdfs:domain val:Element ; rdfs:range xsd:integer ;
    rdfs:comment """Runs this element at a multiple of the sample rate: 1, 2, 4, 8
or 16. The engine wraps the element, so any element can be oversampled and one
written later needs no change to take part.

A nonlinearity makes harmonics above the ones it was given, and any that land
above Nyquist fold back down as tones that were never in the signal. Oversampling
gives the element more room before that happens and filters the result on the way
back down. val:antialiasing answers the same problem the other way, by
integrating the curve, and costs far less; reach for oversampling where the
element has memory, which is where antiderivative anti-aliasing does not apply.

The resampling filters are polyphase IIR, chosen for low latency rather than flat
phase, so a parallel dry path around an oversampled element will not sum cleanly.
The latency they add is reported to the host.

See https://en.wikipedia.org/wiki/Oversampling""" .

val:antialiasing a rdf:Property ; rdfs:domain val:Transfer ; rdfs:range val:AntiAliasing ;
    rdfs:comment """How a memoryless nonlinearity suppresses the harmonics it
generates above Nyquist. Antiderivative anti-aliasing is cheaper and cleaner
than oversampling for this case.""" .

val:slot a rdf:Property ; rdfs:domain val:Param ; rdfs:range xsd:integer ;
    rdfs:comment """Which of the plugin's fixed parameter slots this binding
drives. The list is fixed at construction because VST3, LV2 and CLAP all
require a static parameter list.""" .
val:target   a rdf:Property ; rdfs:domain val:Param ; rdfs:range val:Element .
val:property a rdf:Property ; rdfs:domain val:Param ; rdfs:range rdf:Property .

# Editor metadata. Kept in a separate graph from execution metadata: moving a
# node must never invalidate the compiled circuit.
val:x a rdf:Property ; rdfs:range xsd:double .
val:y a rdf:Property ; rdfs:range xsd:double .

val:section a rdf:Property ;
    rdfs:label "section" ;
    rdfs:comment "Groups val:Param bindings under a named heading in the Controls panel." ;
    rdfs:domain val:Param ;
    rdfs:range rdfs:Literal .

val:valueA a rdf:Property ;
    rdfs:label "valueA" ;
    rdfs:comment """One end of an A/B morph: the value, in the property's own units, that a
val:Param takes when the morph position is 0. A binding with both val:valueA and val:valueB
moves between them as the position moves to 1, in a straight line. One position then changes
every such binding at once, which is a macro control across the whole circuit. Bindings
without both are left alone.""" ;
    rdfs:domain val:Param ;
    rdfs:range xsd:double .

val:valueB a rdf:Property ;
    rdfs:label "valueB" ;
    rdfs:comment "The other end of an A/B morph: the value at position 1. See val:valueA." ;
    rdfs:domain val:Param ;
    rdfs:range xsd:double .

################################################################
# Anti-aliasing strategies                                     #
################################################################

val:AntiAliasing a rdfs:Class ;
    rdfs:label "AntiAliasing" ;
    rdfs:comment "A strategy for suppressing the aliasing a nonlinearity creates." .

val:None a val:AntiAliasing ; rdfs:label "none" ;
    rdfs:comment "Process at the host rate. Cheapest, and audibly aliased when driven." .

val:ADAA1 a val:AntiAliasing ; rdfs:label "ADAA1" ;
    rdfs:comment "First-order antiderivative anti-aliasing." .

val:ADAA2 a val:AntiAliasing ; rdfs:label "ADAA2" ;
    rdfs:comment """Second-order antiderivative anti-aliasing. Must be evaluated
in double precision: the second antiderivative of tanh overflows in float.""" .

val:Oversample2x a val:AntiAliasing ; rdfs:label "2x oversampling" .
val:Oversample4x a val:AntiAliasing ; rdfs:label "4x oversampling" .

################################################################
# Structural classes                                           #
################################################################

val:Circuit a rdfs:Class ;
    rdfs:label "Circuit" ;
    rdfs:comment """A graph of elements joined by arcs.

A circuit is also a plugin: a complete instrument or effect, described by a
document rather than compiled in. So it may describe itself as a
trn:PluginProfile, using the transmissions vocabulary that the catalogue at
plugin-universe.com is built on rather than terms invented here, and be listed
alongside native plugins without translation.

    :dmx a val:Circuit , trn:PluginProfile ;
        rdfs:label "Oberheim DMX" ;
        trn:role trn:DrumInstrument ;
        trn:accepts trn:Midi ;
        trn:produces trn:Audio ;
        trn:genre "Hip Hop" .

The parameters need no separate declaration: val:Param already binds lv2:port
descriptions, which is the same thing a profile lists. Nothing below the model
reads any of it, and a circuit that declares no profile runs exactly as
before.""" .

val:Arc a rdfs:Class ;
    rdfs:label "Arc" ;
    rdfs:comment """A directed connection between two endpoints. Topology is
modelled with explicit arcs, never as an rdf:List, so the graph is a faithful
picture of the dataflow.""" .

val:Endpoint a rdfs:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "One end of an arc: an element and one of its ports." .

val:Param a rdfs:Class ;
    rdfs:label "Param" ;
    rdfs:comment "Binds a host parameter slot to an element's property." .

val:Subcircuit a rdfs:Class ;
    rdfs:label "Subcircuit" ;
    rdfs:comment """A named circuit fragment that is instantiated as if it were
an element. It declares lv2:port as an element class does, and each port carries
val:node and val:port naming the inner port it stands for.

An input port may name more than one val:node, and then reaches all of them: a
drum machine's voice card has one tuning trimmer and several sounds on it, and a
control that reached only the first would be a fault rather than a control. An
output port naming more than one is reported, because a signal comes from one
place. A port that declares
lv2:default sets that value on the element behind it; an instance may override
it by setting the port as a val: property, exactly as on any element.

Definitions live beside the circuit that uses them, not in this vocabulary, so a
subcircuit is per document. The model expands every instance into plain elements
and arcs before compilation: the compiler and the engine never see one. Inner
elements are renamed by prefixing them with the instance IRI, so two instances of
one definition do not collide.

Distinct from val:Network, which is the seam for future component-level
subcircuits solved by nodal analysis rather than patched from blocks.""" .

################################################################
# Element taxonomy                                             #
#                                                              #
# The Filter/Transfer split is memory vs. no memory. Linearity #
# is a separate property: a ladder filter has memory and is    #
# nonlinear.                                                   #
################################################################

val:Element a rdfs:Class ;
    rdfs:label "Element" ;
    rdfs:comment "A processing block in a circuit. Abstract." .

val:Source a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Source" ;
    rdfs:comment "An element that generates signal with no audio input. Abstract." .

val:Filter a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Filter" ;
    rdfs:comment "An element with memory: y = f(x, state). Abstract." .

val:Transfer a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Transfer" ;
    rdfs:comment """A memoryless transfer function: y = f(x). Abstract.
Named for what it is rather than what it lacks; see val:NonLinear.""" .

val:NonLinear owl:equivalentClass val:Transfer ;
    rdfs:label "NonLinear" ;
    rdfs:comment """Accepted as a synonym for val:Transfer so Turtle written
against either name resolves to the same implementation.""" .

val:Network a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Network" ;
    rdfs:comment """A subcircuit solved as a network rather than as a block.
Declared but not implemented: this is the seam for future component-level
(nodal-analysis) work. Instantiating one is a compile error today.""" .

################################################################
# Sources                                                      #
################################################################

val:Oscillator a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Oscillator" ;
    rdfs:comment """A band-limited oscillator that makes a sine, saw, square or triangle wave at val:frequency, chosen by
val:shape (0 sine, 1 saw, 2 square, 3 triangle). It is the usual start of a synthesiser voice.

The saw and square are corrected near their jumps so that they do not alias, which is the harsh
inharmonic whine a naive digital saw makes at high pitch (https://en.wikipedia.org/wiki/Aliasing).
The output swings between -1 and 1, so pass it through a val:VCA or a val:Gain before the output.

Drive val:frequency from a control arc: val:MidiPitch for a keyboard, a val:StepSequencer's pitch
for a pattern, a val:LFO for vibrato. A control arc replaces the frequency, so a resting pitch
belongs in the source and not on this element. The shape is a choice and not a blend; to move
smoothly between timbres use val:Wavetable.""" ;
    val:implementation "Oscillator" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 440.0 ;
        lv2:minimum 0.01 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "shape" ;
        lv2:name "Shape" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 3.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Sine"     ; rdf:value 0 ] ,
                       [ rdfs:label "Saw"      ; rdf:value 1 ] ,
                       [ rdfs:label "Square"   ; rdf:value 2 ] ,
                       [ rdfs:label "Triangle" ; rdf:value 3 ] ;
        rdfs:comment "0 sine, 1 saw, 2 square, 3 triangle" ] .

val:Wavetable a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Wavetable" ;
    rdfs:comment """Oscillator that reads a table of single-cycle waveforms and morphs
between them. val:set chooses the table and val:position moves through it from 0 to 1,
blending the neighbouring frames, so the position is a tone control that can be
swept by an envelope or an LFO.

Three sets, ten frames each:
- Shapes: sine, triangle, saw and square, in thirds of the range. Position 0 is a pure sine
  and position 1 is a square.
- Harmonics: a falling spectrum that flattens as the position rises, from a dark
  almost-sine to a buzzy tone.
- Vowels: two formant peaks moving through a, e, i, o and u. The peaks are fixed harmonic
  numbers, those of a voice at about 110 Hz, so they move with the note and are not fixed in Hz.

The tables are built from their harmonics at eleven levels, each with half as many as the
last, and the oscillator reads the level whose highest harmonic is below half the sample
rate at the pitch played. A bright frame at a high note therefore has fewer partials but
none that alias. The level changes in steps as the pitch moves, so a very wide pitch sweep
through a bright frame is heard as the top partials being added or taken away.

Every table is scaled to peak at 1, so the output never exceeds 1. A bright frame is
therefore a little louder, by ear, at low notes where it keeps more harmonics.

A change of val:position is smoothed across the block. A change of val:set is immediate.""" ;
    val:implementation "Wavetable" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 0.01 ; lv2:maximum 20000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "position" ;
        lv2:name "Position" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "set" ;
        lv2:name "Set" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Shapes" ; rdf:value 0 ] ,
                       [ rdfs:label "Harmonics" ; rdf:value 1 ] ,
                       [ rdfs:label "Vowels" ; rdf:value 2 ] ] .

val:Noise a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Noise" ;
    rdfs:comment """A source of random samples between -1 and 1. val:colour blends from white noise (0), which has the
same energy at every frequency and sounds like hiss, to pink noise (1), which has the same energy in
every octave and sounds like rain or a waterfall (https://en.wikipedia.org/wiki/Pink_noise).

Use it as the raw material of percussion (hats, snares, claps) by shaping it with a val:Envelope
into a val:VCA and a filter; as the breath of a wind instrument; or to excite a resonator such as a
val:ModalBank or val:CombFilter. The sequence is the same every time after a reset, so a render
repeats exactly.""" ;
    val:implementation "Noise" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "colour" ;
        lv2:name "Colour" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "0 white, 1 pink" ] .

val:TwinTBridge a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "TwinTBridge" ;
    rdfs:comment """Triggered damped sine resonator for bridged-T drum voices.
frequency sets the resonant pitch, decay sets the ring time in milliseconds,
and trigger restarts the resonator. If trigger is unconnected it follows the
host MIDI gate.""" ;
    val:implementation "TwinTBridge" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 55.0 ;
        lv2:minimum 10.0 ; lv2:maximum 5000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "decay" ;
        lv2:name "Decay" ; lv2:default 500.0 ;
        lv2:minimum 1.0 ; lv2:maximum 5000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI gate, 0/1 = explicit off/on." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI velocity (default), 0-1 = explicit per-note velocity." ] .

val:Bow a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Bow" ;
    rdfs:comment """Bowed string: a cello, a viol, anything played with rosined
hair. Two travelling waves on a string with the bow between them.

What makes it a bowed string rather than a plucked one is the friction at the
bow. The hair grips the string and drags it, the string breaks free and snaps
back, and the hair grips it again. That stick and slip cycle is what sustains
the note and is the whole of the nonlinearity.

val:pressure is bow force: a light bow slips early and sounds thin and glassy, a
heavy one sticks longer and sounds broad. val:position is where the bow sits
along the string, as a fraction of its length from the bridge; it decides which
harmonics are weak, so it is the main timbral control. Nearer the bridge is
brighter and harder to start.

The body is not modelled here. A string on its own is quiet and thin, which is
what a bridge and a body are for: feed this into a val:ModalBank to get an
instrument. See examples/cello.ttl.

https://ccrma.stanford.edu/~jos/pasp/Bowed_Strings.html""" ;
    val:implementation "Bow" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "drive" ; lv2:name "Drive" ;
        rdfs:comment """Shakes the bow arm at audio rate. Leave it
unconnected for an ordinary bowed note. Connect another val:Bow's output to it,
and that one's to this one's, and the two strings pull each other into and out of
lock as the coupling and the tuning ratio move.""" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 20.0 ; lv2:maximum 4000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pressure" ;
        lv2:name "Pressure" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Bow force. Light slips early and sounds glassy; heavy sticks and sounds broad." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default 0.4 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Bow speed. Sets how loud and how bright the note is." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "position" ;
        lv2:name "Position" ; lv2:default 0.12 ;
        lv2:minimum 0.02 ; lv2:maximum 0.5 ;
        rdfs:comment "Where the bow sits, as a fraction of the string from the bridge. Nearer the bridge is brighter." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Reed a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Reed" ;
    rdfs:comment """Single-reed waveguide clarinet. A cylindrical bore, stopped
by the mouthpiece at one end and open at the other. A round trip reflects once
with its sign inverted, so the tube holds a quarter wavelength and resonates at
odd multiples of it. That is why a clarinet sounds an octave below a flute of
the same length, why its even harmonics are weak, and why it overblows to the
twelfth rather than the octave.

The reed is a pressure-controlled valve. The bore's returning pressure works
against the player's, and the reed's opening is very nearly a straight line in
that difference until it slams against the lay and shuts. That clipped
characteristic is the whole nonlinearity.

val:Flute is the same machinery with the other boundary condition. Connect
val:MidiPitch to frequency for pitch tracking, and an envelope to pressure: the
instrument is silent until it is blown.

After McIntyre, Schumacher and Woodhouse; see Julius Smith, Physical Audio
Signal Processing, <https://ccrma.stanford.edu/~jos/pasp/Clarinet.html>.""" ;
    val:implementation "Reed" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 20.0 ; lv2:maximum 5000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pressure" ;
        lv2:name "Pressure" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Mouth blowing pressure. A reed works over a band of it: below the band nothing sounds, above it the reed is held against the lay and stays shut, and the two ends are always a factor of two apart. The control is mapped onto that band, so most of its travel plays, and it still passes through zero." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "stiffness" ;
        lv2:name "Stiffness" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How much pressure difference it takes to close the reed, which decides what the instrument needs to play rather than how it sounds. A soft reed speaks on very little air and shuts when it is overblown; a hard one will not start on that but takes everything it is given." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "breath" ;
        lv2:name "Breath" ; lv2:default 0.02 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Turbulence in the breath, as a fraction of blowing pressure." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.2 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "What the bore loses on each round trip. 0 is bright and metallic; 1 is dark and muted." ] .

val:Brass a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Brass" ;
    rdfs:comment """Lip-reed waveguide brass: a trumpet, a horn or a trombone. The player's lips are a
resonator tuned to the note, driven by the pressure difference across them. How far they open follows the
square of their displacement, so the valve closes twice a cycle. The bore is a delay line, and what comes back
from the bell works against the player's pressure. The result has many harmonics and gets brighter as the
player blows harder, as a real brass instrument does, which a filter on a saw wave does not.

A brass instrument speaks only over a band of mouth pressure, and the band moves up with the note: a low note
has little room above its floor and a high one needs much more. The pressure control is mapped onto the band
for the note being played, so 0 is silent and 1 is as hard as the note will take. Connect val:MidiPitch to
frequency and an envelope to pressure: the instrument is silent until it is blown.

After Perry Cook's SlideBrass in the Synthesis ToolKit,
<https://ccrma.stanford.edu/software/stk/classstk_1_1Brass.html>. It plays from about G3 to about
G6 and is tuned from a measured table; the second and third octave above middle C are best.""" ;
    val:implementation "Brass" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 262.0 ;
        lv2:minimum 40.0 ; lv2:maximum 3000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pressure" ;
        lv2:name "Pressure" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Mouth blowing pressure, mapped onto the band the note speaks over. Below 0.1 the note is not yet sounding; 0.1 is the softest the note will play and 1 is the hardest, which is brighter and louder." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "lip" ;
        lv2:name "Lip tension" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How sharply the lips resonate. A slack lip is buzzier and less sure of the note; a tight one is purer and more stable." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "breath" ;
        lv2:name "Breath" ; lv2:default 0.02 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Turbulence in the breath, as a fraction of blowing pressure." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.2 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "What the bore loses on each round trip. 0 is bright and brassy; 1 is dark, like a mute or a felt hat." ] .

val:Shaker a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Shaker" ;
    rdfs:comment """A shaken or scraped container of small particles: maracas, a cabasa, a guiro, a rain stick.

A shake puts energy into the system. The energy dies away, and while it lasts the particles collide at random,
each collision adding a short burst of sound that fades quickly. The bursts excite two resonances that stand
for the shell. The number of collisions in a second follows the energy and the number of particles, so a hard
shake is a dense roar that thins to single grains as it dies, which filtered noise cannot do. Each trigger adds
energy, so two shakes in a row are louder than one.

A guiro is the same system with the collisions made regular: with val:regularity at 1 the teeth of the notches
go past at val:scrape per second, and a trigger scrapes for as long as the energy lasts.

Connect a val:NoteGate's gate to trigger and its velocity to velocity. After Perry Cook's PhISEM (Physically
Informed Stochastic Event Modeling), <https://www.cs.princeton.edu/~prc/SingingSynth.html>.""" ;
    val:implementation "Shaker" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI gate, 0/1 = explicit off/on. A rise through 0.5 is a shake." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI velocity, 0-1 = explicit strength of the shake." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "particles" ;
        lv2:name "Particles" ; lv2:default 40.0 ;
        lv2:minimum 1.0 ; lv2:maximum 400.0 ;
        rdfs:comment "How many beads, seeds or grains there are. More makes a denser, smoother sound." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "shake" ;
        lv2:name "Shake decay" ; lv2:default 120.0 ;
        lv2:minimum 5.0 ; lv2:maximum 4000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "How long the energy of a shake lasts. A tight stroke on a maraca is short, a rain stick is long." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "sound" ;
        lv2:name "Grain decay" ; lv2:default 4.0 ;
        lv2:minimum 0.2 ; lv2:maximum 200.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "How long one collision rings. Short is dry like a seed, long is like a bead on a hard shell." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Shell frequency" ; lv2:default 3200.0 ;
        lv2:minimum 200.0 ; lv2:maximum 12000.0 ; units:unit units:hz ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "resonance" ;
        lv2:name "Shell resonance" ; lv2:default 3.0 ;
        lv2:minimum 0.5 ; lv2:maximum 30.0 ;
        rdfs:comment "How sharply the shell rings at its frequency. Low is a hiss, high is a pitched shimmer." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "regularity" ;
        lv2:name "Regularity" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "0 is random collisions (a shaker); 1 is evenly spaced ticks (a guiro or a rasp)." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "scrape" ;
        lv2:name "Scrape rate" ; lv2:default 40.0 ;
        lv2:minimum 1.0 ; lv2:maximum 400.0 ; units:unit units:hz ;
        rdfs:comment "How many teeth go past each second when regularity is above 0." ] .

val:Pluck a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Pluck" ;
    rdfs:comment """The exciter for a plucked string: what the finger or the plectrum does in the first few
milliseconds. Feed its output to a val:StiffString.

A pluck is a short burst whose spectrum depends on how hard the thing that strikes is and how hard it strikes. A
soft fingertip is dull and a nail or a pick is bright (val:hardness), and a harder stroke, as measured by velocity,
is brighter too. Where along the string the pluck lands then removes the harmonics that have a node there: plucked a
fifth of the way along, every fifth harmonic is missing, and the nearer the middle the hollower it sounds. That is a
comb filter whose delay is val:position times the string's period, so connect val:MidiPitch to frequency.

Connect a val:NoteGate's gate to trigger and its velocity to velocity.
After Julius Smith, <https://ccrma.stanford.edu/~jos/pasp/Plucked_String_Model.html>.""" ;
    val:implementation "Pluck" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI gate, 0/1 = explicit off/on. A rise through 0.5 is a pluck." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI velocity, 0-1 = explicit strength of the pluck." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 40.0 ; lv2:maximum 5000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "position" ;
        lv2:name "Position" ; lv2:default 0.2 ;
        lv2:minimum 0.04 ; lv2:maximum 0.5 ;
        rdfs:comment "Where along the string the pluck lands, as a fraction of its length from the bridge. 0.5 is the middle; near 0.1 is a bright, nasal sound beside the bridge." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "hardness" ;
        lv2:name "Hardness" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "0 is a soft fingertip, 1 is a hard pick." ] .

val:FMOperator a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "FM operator" ;
    rdfs:comment """One operator of a DX7-style FM synthesiser: a sine oscillator whose
phase is driven by an audio input. Everything the DX7 does is operators wired into
each other, so a patch is several of these, and the wiring is the algorithm.

The input "pm" is the modulator. Its amplitude times val:depth is the modulation
index, so the modulator's own level and envelope are the index, and an envelope
that falls on the modulator makes a tone that starts bright and mellows. Several
arcs on "pm" sum. An operator with nothing on "pm" is a plain sine, a carrier.

Frequency is val:frequency times val:ratio, detuned by val:detune cents. Connect
val:MidiPitch to frequency and the operator tracks the keyboard, with the ratio
choosing which harmonic it sits on; a whole-number ratio gives a harmonic tone and
anything else an inharmonic one, which is where bells come from. Setting val:fixed
above zero ignores the keyboard and sounds that many hertz instead.

Level and amplitude are separate: val:level is the operator's output level on the
DX7's 0 to 99 scale, linear in decibels, and val:amp is a 0 to 1 control that an
envelope drives. Both scale the output, so both scale the modulation index when
the operator is a modulator.

val:feedback feeds the operator's own output back into its phase, on the DX7's 0
to 7 scale. A sine with feedback moves towards a sawtooth. Feedback around more
than one operator is not modelled, because an arc that loops back is a cycle; the
element offers the one the DX7 offers on a single operator.

Strictly this is phase modulation rather than frequency modulation, as it is on
the DX7. See https://en.wikipedia.org/wiki/Frequency_modulation_synthesis""" ;
    val:implementation "FMOperator" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "pm" ; lv2:name "Phase mod" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 440.0 ;
        lv2:minimum 0.01 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio" ;
        lv2:name "Ratio" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ;
        rdfs:comment "Multiplies the frequency. The DX7's coarse and fine controls are this one number: coarse 1 fine 41 is 1.41." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "fixed" ;
        lv2:name "Fixed" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 10000.0 ; units:unit units:hz ;
        rdfs:comment "Above 0, the operator sounds this frequency whatever the keyboard plays, and ratio and detune are ignored." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune" ;
        lv2:name "Detune" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level" ;
        lv2:name "Level" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ;
        rdfs:comment "Output level on the DX7's scale: 99 is full, and each step below is about 0.75 dB down. 0 is silent." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp" ;
        lv2:name "Amp" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Amplitude, for an envelope to drive. A control arc here replaces the value." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "depth" ;
        lv2:name "Depth" ; lv2:default 12.566371 ;
        lv2:minimum 0.0 ; lv2:maximum 50.0 ;
        rdfs:comment "Radians of phase shift that a full-scale signal on pm produces. The default, four turns, is where the DX7's strongest modulator sits." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] .

val:FMMatrix a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "FM matrix" ;
    rdfs:comment """Six FM operators in one element with a modulation matrix between
them, so any operator can modulate any other, including through a loop.

Several val:FMOperator elements cannot make a loop that spans operators. An arc
that returns to an earlier element is a cycle, and the only thing that breaks one,
val:UnitDelay, delays a loop by a control slice and a sample (33 samples), which is
far too long for FM. A loop has to
be sample accurate, so it has to be inside one element.

Operators run from 6 down to 1, as on the DX7. m<d><s> is how much operator s
modulates operator d, as a fraction of val:depth. When s is higher than d, the
modulator has already been computed for this sample and is used as it is. When s is
lower than d, it is used as it was one sample ago, so every loop has one sample of
delay on the arc that runs against the order. The diagonal, m11 to m66, is the
DX7's own feedback control from 0 to 7, which averages an operator's last two
outputs.

val:carrier1 to val:carrier6 choose which operators are heard. Each operator's
level is val:level1 and so on, and its amplitude val:amp1 and so on is for an
envelope: connect val:RateLevelEnvelope outputs to them. The note is shared, with
a val:ratio and val:detune for each operator.

A DX7 algorithm is a choice of matrix entries and carriers. Algorithm 5, for
example, is m12, m34 and m56 set to 1 with carriers 1, 3 and 5. Setting
val:algorithm to a number from 1 to 32 does that for any of the DX7's own algorithms:
it takes over the matrix and the carriers, and val:feedback is the single feedback
control the machine has, applied to whichever operator the algorithm gives it to. In
algorithms 4 and 6 the feedback runs through a loop of operators (4 back to 6, and 5
back to 6) rather than from an operator to itself. With val:algorithm at 0 the matrix
and carrier ports apply instead. See
https://en.wikipedia.org/wiki/Frequency_modulation_synthesis""" ;
    val:implementation "FMMatrix" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 440.0 ;
        lv2:minimum 0.01 ; lv2:maximum 20000.0 ; units:unit units:hz ;
        rdfs:comment "The note. Each operator sounds this times its own ratio." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "depth" ;
        lv2:name "Depth" ; lv2:default 12.566371 ;
        lv2:minimum 0.0 ; lv2:maximum 50.0 ;
        rdfs:comment "Radians of phase shift at a modulation amount of 1." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "algorithm" ;
        lv2:name "Algorithm" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "0 uses the matrix and carriers below. 1 to 32 is a DX7 algorithm, which sets every modulation entry and every carrier itself; the ratios, levels and amps still apply." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ;
        rdfs:comment "The DX7's feedback control, 0 to 7, for the operator an algorithm gives it to. Used only with an algorithm; the matrix has its own on the diagonal." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio1" ;
        lv2:name "Ratio 1" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune1" ;
        lv2:name "Detune 1" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level1" ;
        lv2:name "Level 1" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ;
        rdfs:comment "Output level on the DX7 scale, 0 to 99." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp1" ;
        lv2:name "Amp 1" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "For an envelope to drive." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier1" ;
        lv2:name "Carrier 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How much of this operator is heard. 0 makes it a pure modulator." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio2" ;
        lv2:name "Ratio 2" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune2" ;
        lv2:name "Detune 2" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level2" ;
        lv2:name "Level 2" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp2" ;
        lv2:name "Amp 2" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier2" ;
        lv2:name "Carrier 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio3" ;
        lv2:name "Ratio 3" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune3" ;
        lv2:name "Detune 3" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level3" ;
        lv2:name "Level 3" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp3" ;
        lv2:name "Amp 3" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier3" ;
        lv2:name "Carrier 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio4" ;
        lv2:name "Ratio 4" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune4" ;
        lv2:name "Detune 4" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level4" ;
        lv2:name "Level 4" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp4" ;
        lv2:name "Amp 4" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier4" ;
        lv2:name "Carrier 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio5" ;
        lv2:name "Ratio 5" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune5" ;
        lv2:name "Detune 5" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level5" ;
        lv2:name "Level 5" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp5" ;
        lv2:name "Amp 5" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier5" ;
        lv2:name "Carrier 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio6" ;
        lv2:name "Ratio 6" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 32.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "detune6" ;
        lv2:name "Detune 6" ; lv2:default 0.0 ;
        lv2:minimum -100.0 ; lv2:maximum 100.0 ; units:unit units:cent ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "level6" ;
        lv2:name "Level 6" ; lv2:default 99.0 ;
        lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amp6" ;
        lv2:name "Amp 6" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "carrier6" ;
        lv2:name "Carrier 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m11" ;
        lv2:name "Feedback 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ;
        rdfs:comment "The DX7 feedback control, 0 to 7." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m12" ;
        lv2:name "2 to 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How much operator 2 modulates operator 1, as a fraction of depth. An operator numbered higher than its target is heard on the same sample; one numbered lower is heard one sample late, which is what closes a loop." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m13" ;
        lv2:name "3 to 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m14" ;
        lv2:name "4 to 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m15" ;
        lv2:name "5 to 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m16" ;
        lv2:name "6 to 1" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m21" ;
        lv2:name "1 to 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How much operator 1 modulates operator 2, as a fraction of depth. An operator numbered higher than its target is heard on the same sample; one numbered lower is heard one sample late, which is what closes a loop." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m22" ;
        lv2:name "Feedback 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m23" ;
        lv2:name "3 to 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m24" ;
        lv2:name "4 to 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m25" ;
        lv2:name "5 to 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m26" ;
        lv2:name "6 to 2" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m31" ;
        lv2:name "1 to 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m32" ;
        lv2:name "2 to 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m33" ;
        lv2:name "Feedback 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m34" ;
        lv2:name "4 to 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m35" ;
        lv2:name "5 to 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m36" ;
        lv2:name "6 to 3" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m41" ;
        lv2:name "1 to 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m42" ;
        lv2:name "2 to 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m43" ;
        lv2:name "3 to 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m44" ;
        lv2:name "Feedback 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m45" ;
        lv2:name "5 to 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m46" ;
        lv2:name "6 to 4" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m51" ;
        lv2:name "1 to 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m52" ;
        lv2:name "2 to 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m53" ;
        lv2:name "3 to 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m54" ;
        lv2:name "4 to 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m55" ;
        lv2:name "Feedback 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m56" ;
        lv2:name "6 to 5" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m61" ;
        lv2:name "1 to 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m62" ;
        lv2:name "2 to 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m63" ;
        lv2:name "3 to 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m64" ;
        lv2:name "4 to 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m65" ;
        lv2:name "5 to 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "m66" ;
        lv2:name "Feedback 6" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] .

val:Flute a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Flute" ;
    rdfs:comment """Jet-drive waveguide flute. A tube open at both ends, blown
by a ribbon of air aimed at a sharp edge across the mouth hole. The jet takes
time to cross that gap, so the model is two delay lines: the air column, and a
shorter jet delay. What the column pushes back deflects the jet, and where the
jet lands decides how much air enters the tube rather than passing by.

The flow into the tube is Uj * tanh((eta - y0) / b), after Verge and Fabre: Uj
is the jet's speed, eta how far the acoustic field has deflected it, y0 how far
it already sits off the edge. Two things follow, and both are audible. Uj goes
with the square root of blowing pressure, which is Bernoulli's, so the
instrument grows louder and brighter as it is blown rather than saturating at
one volume. And y0 breaks the symmetry: a jet centred on the edge is deflected
equally either way and puts out only odd harmonics, which is a hollow, stopped
sound, so val:offset is what puts the even harmonics in. A player does the same
thing by rolling the instrument towards or away from themselves.

It plays its first register: the jet ratio decides which mode the loop settles
in, and that port is bounded to the range that holds the fundamental.

Connect val:MidiPitch to frequency for pitch tracking, and an envelope to
pressure: the instrument is silent until it is blown, and speaks after a short
delay while the oscillation builds, as a real one does.

See Fabre and Hirschberg, and Julius Smith, Physical Audio Signal Processing,
<https://ccrma.stanford.edu/~jos/pasp/Flutes_Recorders_Flue_Organ.html>.""" ;
    val:implementation "Flute" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 440.0 ;
        lv2:minimum 20.0 ; lv2:maximum 5000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pressure" ;
        lv2:name "Pressure" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Blowing pressure. Below about a third of the travel the instrument does not speak and only wind noise is heard, as a flute blown too gently does; above that it sounds, growing louder and brighter to the top." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "offset" ;
        lv2:name "Offset" ; lv2:default 0.65 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "How far the jet sits off the edge, in jet widths. 0 is centred, which is symmetric and gives a hollow tone of odd harmonics only; raising it puts the even harmonics in and rounds the sound out. Around two thirds of the way up is where the second harmonic leads, which is where a flute sits." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "breath" ;
        lv2:name "Breath" ; lv2:default 0.05 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Turbulence in the breath, which is both what starts the note and what makes it audibly a wind instrument. Low for an orchestral flute, high for a bamboo one." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "jet" ;
        lv2:name "Jet" ; lv2:default 0.5 ;
        lv2:minimum 0.35 ; lv2:maximum 0.65 ;
        rdfs:comment "How long the jet takes to cross the mouth hole, as a fraction of the air column. The column is retuned to match it, so the pitch holds across the range while the tone changes." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "What the air column loses on each round trip. 0 is a bright metal tube; 1 is a soft, dark wooden one." ] .

################################################################
# Filters                                                      #
################################################################

val:OnePole a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "OnePole" ;
    rdfs:comment """A first-order filter with a gentle 6 dB per octave slope. val:mode picks lowpass (0), which
darkens; highpass (1), which removes low frequencies; or allpass (2), which changes only the phase.
val:cutoff is the corner frequency, from 20 Hz to 20 kHz.

It is the right tool for a light touch: softening a click, a tone control, taking rumble and DC
out of a signal (a highpass at 20 to 40 Hz), or smoothing a jumpy signal. For a steeper or resonant
filter use val:Ladder, val:StateVariable or val:Biquad. A control arc into val:cutoff replaces it
every block, so put the resting corner in the source.""" ;
    val:implementation "OnePole" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ; lv2:default 1000.0 ;
        lv2:minimum 20.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mode" ;
        lv2:name "Mode" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Lowpass" ; rdf:value 0 ] ,
                       [ rdfs:label "Highpass" ; rdf:value 1 ] ,
                       [ rdfs:label "Allpass" ; rdf:value 2 ] ;
        rdfs:comment "0 lowpass, 1 highpass, 2 allpass" ] .

val:StateVariable a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "StateVariable" ;
    rdfs:comment """Topology-preserving transform SVF in the Cytomic
mixing-coefficient form. All three responses are available at once, so one
filter can feed a forward path from lp and a feedback path from hp.

val:drive above 1 puts a saturator on the bandpass inside the filter. A quiet signal is
unaffected, a loud one is compressed and gains odd harmonics, and the resonance is held
to a level instead of growing: turn val:resonance up and the filter sings at a steady
amplitude. At 1 the saturator is off and the filter is exactly linear.""" ;
    val:implementation "StateVariable" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "lp" ; lv2:name "Lowpass" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "bp" ; lv2:name "Bandpass" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "hp" ; lv2:name "Highpass" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ; lv2:default 1000.0 ;
        lv2:minimum 20.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "resonance" ;
        lv2:name "Resonance" ; lv2:default 0.7071 ;
        lv2:minimum 0.05 ; lv2:maximum 20.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "drive" ;
        lv2:name "Drive" ; lv2:default 1.0 ;
        lv2:minimum 1.0 ; lv2:maximum 20.0 ] .

val:Ladder a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Ladder" ;
    rdfs:comment """A four-pole lowpass filter (24 dB per octave) in the style of the Moog ladder, with a saturating
stage at its input inside the feedback loop (https://en.wikipedia.org/wiki/Moog_filter). It has
memory and is nonlinear.

val:cutoff is the corner frequency. val:resonance, from 0 to 1, feeds the output back to the input:
low settings add a peak at the corner, and near the top of the range the filter rings and whistles
on its own. val:drive, from 1 to 20, pushes the input harder into the saturation for warmth and grit
at the cost of level.

The classic subtractive voice is val:Oscillator into this into a val:VCA, with a val:Envelope
through a val:Scale sweeping val:cutoff. A control arc into val:cutoff replaces the value every
block, so put the resting cutoff in the Scale's min.""" ;
    val:implementation "Ladder" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ; lv2:default 1000.0 ;
        lv2:minimum 20.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "resonance" ;
        lv2:name "Resonance" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "drive" ;
        lv2:name "Drive" ; lv2:default 1.0 ;
        lv2:minimum 1.0 ; lv2:maximum 20.0 ] .

val:Biquad a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Biquad" ;
    rdfs:comment """Second-order filter with the response chosen by val:mode: a low or
high shelf, a bell, a notch, or a 12 dB per octave low or high cut. Coefficients are
those of the Audio EQ Cookbook: https://www.w3.org/TR/audio-eq-cookbook/.

val:frequency is the corner of a shelf or cut and the centre of a bell or notch.
val:gain applies to the shelves and the bell only; the others ignore it. A bell or
shelf with val:gain at 0 is a straight wire. val:q is the width of a bell or notch and
the resonance of a cut; 0.7071 gives a cut its flattest passband, and a shelf its
steepest slope without overshoot. Several in series make a parametric equaliser.""" ;
    val:implementation "Biquad" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mode" ;
        lv2:name "Mode" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 5.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Low shelf" ; rdf:value 0 ] ,
                       [ rdfs:label "Bell" ; rdf:value 1 ] ,
                       [ rdfs:label "High shelf" ; rdf:value 2 ] ,
                       [ rdfs:label "Notch" ; rdf:value 3 ] ,
                       [ rdfs:label "Low cut" ; rdf:value 4 ] ,
                       [ rdfs:label "High cut" ; rdf:value 5 ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 1000.0 ;
        lv2:minimum 20.0 ; lv2:maximum 20000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 0.0 ;
        lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "q" ;
        lv2:name "Q" ; lv2:default 0.7071 ;
        lv2:minimum 0.1 ; lv2:maximum 20.0 ] .

val:Crossover a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Crossover" ;
    rdfs:comment """Linkwitz-Riley 4th-order crossover: splits the input at val:frequency
into val:low and val:high, each falling 24 dB per octave beyond the corner. Each side is
6 dB down at the corner and the two are in phase, so adding them gives back the input's
level at every frequency. Process the sides apart and sum them for a multiband effect.
See https://en.wikipedia.org/wiki/Audio_crossover#Linkwitz-Riley""" ;
    val:implementation "Crossover" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "low" ; lv2:name "Low" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "high" ; lv2:name "High" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 1000.0 ;
        lv2:minimum 20.0 ; lv2:maximum 20000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] .

val:Redux a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Redux" ;
    rdfs:comment """Bit-depth and sample-rate reducer. The input is held for val:downsample
samples and rounded to val:bits bits. Nothing is filtered before or after, so the aliasing
and the rounding error are kept as the sound. At 24 bits the rounding is off.

val:downsample is a factor, so 4 holds each value for four samples, and it need not be a
whole number. val:jitter varies the length of each hold by up to that fraction of the
factor, which smears the aliasing into noise. The variation is from a seeded generator
that restarts at every reset, so a render repeats exactly.""" ;
    val:implementation "Redux" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bits" ;
        lv2:name "Bits" ; lv2:default 8.0 ;
        lv2:minimum 1.0 ; lv2:maximum 24.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "downsample" ;
        lv2:name "Downsample" ; lv2:default 4.0 ;
        lv2:minimum 1.0 ; lv2:maximum 64.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "jitter" ;
        lv2:name "Jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:PitchShift a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "PitchShift" ;
    rdfs:comment """Moves the pitch of the input by val:pitch semitones without changing its
length. Two read heads sweep through a short delay line at a different speed from the one
it was written at, which changes the pitch the way playing a tape fast or slow would; each
head jumps back when it runs out of line, and a window hides the jump. The grain is
30 ms.

It suits a single voice or instrument best. A chord or a mix is shifted as a whole, and
the jumps add a slight tremolo at about 33 Hz that a held note makes audible. Large shifts
make it more obvious.

The dry signal is delayed by half a grain to match the average delay of the shifted one, so
val:mix gives a blend that does not comb. That 15 ms is declared as latency. Returning val:pitch
to 0 after a shift leaves the heads where they are, which can colour the sound slightly
until the shift is moved again.

val:align picks the place each head lands when it jumps back by comparing the stretch it
is about to play with the one the other head has just played, within a fifth of a grain
either side, and taking the best match. The crossfade then joins waveforms that agree, which
is what takes the tremolo off a held chord. It costs some processing per jump, and it is off
by default because the search can pick the wrong point on a very noisy or unpitched sound.""" ;
    val:implementation "PitchShift" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pitch" ;
        lv2:name "Pitch" ; lv2:default 0.0 ;
        lv2:minimum -24.0 ; lv2:maximum 24.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "align" ;
        lv2:name "Align" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                       [ rdfs:label "On"  ; rdf:value 1 ] ;
        rdfs:comment "Chooses where each head lands by correlation with the other, so the crossfade joins in phase." ] .

val:FreqShifter a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "FreqShifter" ;
    rdfs:comment """Moves every partial of the input by val:shift hertz. Unlike val:PitchShift,
which multiplies frequencies, this adds to them, so a harmonic series becomes inharmonic and
the result sounds metallic or bell-like. It is single-sideband modulation: the input is split
into two copies a quarter turn apart by a Hilbert transformer (a pair of allpass chains), then
multiplied by a cosine and a sine at the shift frequency and combined.

A positive shift moves partials up and a negative one moves them down. val:feedback returns
the shifted output to the input, so the shift repeats and the sound rises or falls
continuously, the barberpole phaser effect. The allpass chains delay by a frequency
dependent amount and no latency is declared, so a partial blend with the dry signal is
slightly phase coloured.""" ;
    val:implementation "FreqShifter" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "shift" ;
        lv2:name "Shift" ; lv2:default 0.0 ;
        lv2:minimum -2000.0 ; lv2:maximum 2000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 0.95 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Tape a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Tape" ;
    rdfs:comment """A tape machine's effect on a signal, in four stages. val:drive pushes the signal
into a tanh saturator that has unity gain for quiet signals, so more drive adds soft clipping
without making it louder. val:bump is a broad boost near 80 Hz, the low-frequency swell of a
playback head. val:wow and val:flutter vary the tape speed, which shows up as pitch sway: wow
is slow, under 2 Hz, flutter is faster, near 9 Hz, and both ride on a little random drift.
Finally val:hf rolls off the top end with a one-pole cut, and val:hiss adds noise at that
level in decibels, which passes through the same cut.

The speed variation is a delay that moves around a fixed 3 ms. That 3 ms is declared as
latency. val:seed chooses the noise and drift; the same seed after a reset gives the same
output.

See https://en.wikipedia.org/wiki/Wow_and_flutter_measurement""" ;
    val:implementation "Tape" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;  lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "drive" ;
        lv2:name "Drive" ; lv2:default 6.0 ;
        lv2:minimum 0.0 ; lv2:maximum 30.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bump" ;
        lv2:name "Bump" ; lv2:default 3.0 ;
        lv2:minimum 0.0 ; lv2:maximum 12.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "wow" ;
        lv2:name "Wow" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "flutter" ;
        lv2:name "Flutter" ; lv2:default 0.2 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "hf" ;
        lv2:name "High cut" ; lv2:default 14000.0 ;
        lv2:minimum 1000.0 ; lv2:maximum 20000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "hiss" ;
        lv2:name "Hiss" ; lv2:default -80.0 ;
        lv2:minimum -120.0 ; lv2:maximum -20.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ] .

val:BucketBrigade a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "BucketBrigade" ;
    rdfs:comment """An analogue bucket-brigade delay, after the Matsushita MN3005 in the Boss
DD-3. The chip passes each sample along 4096 stages, one step per clock edge, so the delay is
4096 over twice the clock rate, and because the clock is also the sampling rate the filters
around the chain have to follow it. The output is the delayed signal alone; mix it with the
dry signal in the circuit.

Three things follow, and they are modelled. A long delay is dark and a short one bright,
because the filters sit at val:bandwidth times the clock rate: at 0.35, 800 ms gives a corner
near 900 Hz and 50 ms one near 14 kHz. Repeats darken, because val:feedback takes the output
back through the same filters. And the chain is noisy, so the signal is compressed 2:1 in
decibels going in and expanded coming out (val:compander), which hides the noise when the
signal is quiet and adds a slight pump. val:noise is the level of the noise in the chain.

Changing val:time moves the clock and bends the pitch of what is in the chain, as the pedal
does. val:feedback up to 1.1 can self-oscillate; a soft clip in the loop keeps it bounded.
Not modelled: the pedal's range switch and hold mode, the clock's leakage into the audio, and
the losses between stages of a real chain. The seed chooses the noise.

See https://en.wikipedia.org/wiki/Bucket-brigade_device""" ;
    val:implementation "BucketBrigade" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;  lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "time" ;
        lv2:name "Time" ; lv2:default 300.0 ;
        lv2:minimum 5.0 ; lv2:maximum 800.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.1 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bandwidth" ;
        lv2:name "Bandwidth" ; lv2:default 0.35 ;
        lv2:minimum 0.05 ; lv2:maximum 1.0 ;
        rdfs:comment "The filters' corner as a fraction of the BBD clock rate." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "noise" ;
        lv2:name "Noise" ; lv2:default -75.0 ;
        lv2:minimum -120.0 ; lv2:maximum -30.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "compander" ;
        lv2:name "Compander" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                       [ rdfs:label "On"  ; rdf:value 1 ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ] .

val:Chorus a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Chorus" ;
    rdfs:comment """A three-voice chorus. Three short delays of about 7 milliseconds are each swept by a sine LFO,
spaced evenly round the cycle, and mixed back with the dry signal. The pitch of each wobbles
slightly as its delay moves, and the three together thicken the sound as if several players were
playing at once (https://en.wikipedia.org/wiki/Chorus_effect).

val:rate is the LFO speed (0.01 to 10 Hz), val:depth is how far the delay swings (up to 3.5 ms)
and val:mix is the wet-to-dry balance. Slow and shallow is subtle thickening; faster and deeper
is warble. Use it on pads, guitars and electric pianos. For a swirling, resonant sweep use
val:Flanger or val:Phaser.""" ;
    val:implementation "Chorus" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in"    ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out"   ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "rate"  ;
        lv2:name "Rate" ; lv2:default 0.5 ;
        lv2:minimum 0.01 ; lv2:maximum 10.0 ; units:unit units:hz ;
        rdfs:comment "LFO modulation rate. Slow (0.1–1 Hz) for lush chorus; faster for vibrato." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "depth" ;
        lv2:name "Depth" ; lv2:default 2.0 ;
        lv2:minimum 0.0 ; lv2:maximum 3.5 ; units:unit units:ms ;
        rdfs:comment "Modulation depth in milliseconds. 0 = static delay; 3.5 = maximum sweep." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "mix"   ;
        lv2:name "Mix" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Dry/wet blend. 0 = dry only; 1 = wet only; 0.5 = equal mix." ] .

val:Flanger a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Flanger" ;
    rdfs:comment """A single short delay of about 5 milliseconds, swept by a sine LFO, with feedback. Mixed with the
dry signal it makes a comb filter whose notches move as the delay changes, the jet-plane sweep
(https://en.wikipedia.org/wiki/Flanging).

val:rate is the sweep speed (0.01 to 10 Hz), val:depth the swing of the delay (up to 4 ms) and
val:mix the balance with the dry signal. val:feedback, from -0.95 to 0.95, sends the delayed signal
back in: more feedback makes the notches deeper and the sound more metallic, and a negative value
gives a hollower tone. It works best on bright, harmonically rich material such as drums and
guitar. For a gentler thickening use val:Chorus.""" ;
    val:implementation "Flanger" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in"       ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out"      ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "rate"     ;
        lv2:name "Rate" ; lv2:default 0.5 ;
        lv2:minimum 0.01 ; lv2:maximum 10.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "depth"    ;
        lv2:name "Depth" ; lv2:default 2.0 ;
        lv2:minimum 0.0 ; lv2:maximum 4.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.5 ;
        lv2:minimum -0.95 ; lv2:maximum 0.95 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "mix"      ;
        lv2:name "Mix" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Phaser a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Phaser" ;
    rdfs:comment """A chain of four first-order allpass filters whose corner frequency is swept by a sine LFO, with
feedback from the end of the chain to its start. The allpass stages change the phase of the signal
and not its level; mixed with the dry signal, the phase differences cancel at some frequencies and
make notches that move with the sweep (https://en.wikipedia.org/wiki/Phaser_(effect)).

val:rate is the sweep speed (0.01 to 10 Hz), val:depth sets how wide the sweep is (the corner moves
from 100 Hz to 100 plus depth times 1900 Hz), val:feedback (0 to 0.9) deepens the notches, and
val:mix is the balance with the dry signal. It is softer and more vocal than val:Flanger, whose
notches are evenly spaced. Use it on keys, guitar and pads.""" ;
    val:implementation "Phaser" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in"       ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out"      ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "rate"     ;
        lv2:name "Rate" ; lv2:default 0.5 ;
        lv2:minimum 0.01 ; lv2:maximum 10.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "depth"    ;
        lv2:name "Depth" ; lv2:default 0.7 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 0.9 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "mix"      ;
        lv2:name "Mix" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:UnitDelay a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "UnitDelay" ;
    rdfs:comment """Delays by one sample, and is required to break a cycle: the compiler
rejects any feedback loop that does not pass through one.

Elements run a whole control slice at a time, so closing a loop makes the delay
longer than one sample. The delay's input is then the previous slice's output of an
element that runs after it, and the loop takes a slice plus one sample to come
round: 33 samples, or 0.7 ms at 48 kHz, since the engine's slice is 32 samples
long. Anything that depends on the loop time, such as the pitch of a feedback comb,
follows from that figure and not from a single sample. Outside a loop the delay is
the one sample it says.

A loop that must be sample accurate has to be inside one element, as the operators
of val:FMMatrix are.""" ;
    val:implementation "UnitDelay" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] .

val:CombFilter a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "CombFilter" ;
    rdfs:comment """Feedback comb filter with a one-pole lowpass in the feedback
path — the Karplus-Strong plucked-string algorithm. Delay length is determined
by frequency (delayN = sampleRate / frequency). damping controls how fast high
frequencies decay: 0 = flat feedback (bright), 1 = heavily damped (dark).""" ;
    val:implementation "CombFilter" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 10.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.95 ;
        lv2:minimum 0.0 ; lv2:maximum 0.99 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.1 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:StiffString a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "StiffString" ;
    rdfs:comment """CombFilter with allpass-chain dispersion in the feedback path.
Allpass stages stretch upper partials upward from exact harmonics, giving the
inharmonic quality of a piano string or struck metal bar. dispersion 0 =
pure comb (harmonic); 1 = heavily stretched (bell-like).""" ;
    val:implementation "StiffString" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 10.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.95 ;
        lv2:minimum 0.0 ; lv2:maximum 0.99 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.1 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "dispersion" ;
        lv2:name "Dispersion" ; lv2:default 0.1 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Allpass coefficient for inharmonic stretching. 0 = harmonic (string); 1 = heavily inharmonic (bar/bell)." ] .

val:ModalBank a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "ModalBank" ;
    rdfs:comment """Six parallel 2-pole resonators tuned to the modal frequency
ratios of a physical object. mode selects the resonator family:
  0 = marimba / wooden bar  (ratios 1 : 2.756 : 5.404 : 8.933 : 13.344 : 18.648)
  1 = drumhead / circular membrane  (1 : 1.593 : 2.136 : 2.296 : 2.653 : 2.917)
  2 = rectangular membrane  (1 : 1.414 : 1.581 : 2.000 : 2.236 : 2.550)
  3 = plate  (1 : 1.414 : 2.000 : 2.236 : 2.449 : 2.828)
Connect an excitation signal (noise, impulse, bow) to the audio input.
Connect val:MidiPitch to frequency for pitch-tracked resonance.""" ;
    val:implementation "ModalBank" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in"         ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out"        ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "frequency"  ;
        lv2:name "Frequency" ; lv2:default 220.0 ;
        lv2:minimum 20.0 ; lv2:maximum 5000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "decay"      ;
        lv2:name "Decay" ; lv2:default 1.0 ;
        lv2:minimum 0.05 ; lv2:maximum 10.0 ; units:unit units:s ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "brightness" ;
        lv2:name "Brightness" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Spectral tilt. 0 = only fundamental; 1 = all modes equally loud." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "mode"       ;
        lv2:name "Mode" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 3.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Marimba"  ; rdf:value 0 ] ,
                       [ rdfs:label "Drumhead" ; rdf:value 1 ] ,
                       [ rdfs:label "Membrane" ; rdf:value 2 ] ,
                       [ rdfs:label "Plate"    ; rdf:value 3 ] ] .

################################################################
# Transfer functions                                           #
#                                                              #
# Fine-grained device models live here. A val:Diode is a real   #
# Shockley-equation diode with physical parameters, not a       #
# relabelled tanh, so a clipper built from one behaves like the #
# circuit it names.                                             #
################################################################

val:Tanh a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "Tanh" ;
    rdfs:comment """Symmetric soft saturation: the output is the hyperbolic tangent of val:gain times the input
(https://en.wikipedia.org/wiki/Hyperbolic_functions). Small signals pass with a gain of val:gain;
large ones are squeezed smoothly towards plus and minus 1 and never exceed it.

It adds odd harmonics, strongly at high gain, and sounds warm and tube-like rather than harsh. Put
it after a val:Gain or a filter to make overdrive, or use it to round off peaks. val:antialiasing
reduces the aliasing that the harmonics cause, and val:oversampling reduces it further. For a
softer knee see val:SinArcTan and val:SoftSine; for a hard edge see val:HardClip.""" ;
    val:implementation "Tanh" ;
    val:hasOption val:antialiasing ;
    val:linear false ;
    val:antialiasing val:ADAA2 ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 100.0 ] .

val:HardClip a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "HardClip" ;
    rdfs:comment """Cuts the signal flat at plus and minus val:threshold (0.01 to 2, default 1). Anything beyond the
threshold is removed, so the result is a flat top: the harshest distortion here, rich in strong odd
harmonics.

Use it as a safety stage before the output, or for deliberately raw fuzz. Hard edges alias badly
(https://en.wikipedia.org/wiki/Aliasing), so run it at a higher rate with val:oversampling for a
clean result. For a rounder sound use val:Tanh, val:SinArcTan or val:SoftSine, and for the response
of real diodes use val:Diode or val:DiodePair.""" ;
    val:implementation "HardClip" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "threshold" ;
        lv2:name "Threshold" ; lv2:default 1.0 ;
        lv2:minimum 0.01 ; lv2:maximum 2.0 ] .

val:Fold a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "Fold" ;
    rdfs:comment """A wavefolder. The input is multiplied by val:gain, and any part of it that goes beyond the limits is
reflected back instead of clipped, so the wave folds over itself like a sheet of paper. The output
stays between -1 and 1 however hard it is driven.

The more gain, the more folds and the brighter and more complex the sound; a plain sine becomes a
rich, shifting timbre as the gain rises, which is the basis of West-coast synthesis
(https://en.wikipedia.org/wiki/Wavefolder). Sweep val:gain with an envelope or an LFO for
movement. Folding creates harmonics far above the input, so use val:oversampling to keep aliasing
down at high gain.""" ;
    val:implementation "Fold" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 20.0 ] .

val:Diode a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "Diode" ;
    rdfs:comment """A single junction diode clipping a signal, from the Shockley equation
(https://en.wikipedia.org/wiki/Shockley_diode_equation): i = Is * (exp(v / (n * Vt)) - 1).
val:saturationCurrent (Is), val:emissionCoefficient (n) and val:thermalVoltage (Vt) are the
diode's own parameters, and the defaults are a 1N4148 signal diode at room temperature.

A diode conducts in one direction only. The positive half of the signal is squeezed
logarithmically, against a resistor of 1 kilohm that is fixed here, and the negative half passes
unchanged, because a reverse-biased diode is open. That asymmetry adds even harmonics as well as odd
ones, which makes a fuller sound than a symmetric clipper. Treat the input as volts: the output is
small, so follow it with a val:Gain. For two diodes in opposite directions, which clip both halves
alike and expose the resistor, use val:DiodePair; for diodes that do not match, val:AsymClip.""" ;
    val:implementation "Diode" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "saturationCurrent" ;
        lv2:name "Is" ; lv2:default 2.52e-9 ;
        lv2:minimum 1e-15 ; lv2:maximum 1e-3 ;
        units:unit [ a units:Unit ; units:symbol "A" ; units:render "%.3g A" ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "emissionCoefficient" ;
        lv2:name "n" ; lv2:default 1.752 ;
        lv2:minimum 1.0 ; lv2:maximum 2.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "thermalVoltage" ;
        lv2:name "Vt" ; lv2:default 0.02585 ;
        lv2:minimum 0.02 ; lv2:maximum 0.03 ;
        units:unit [ a units:Unit ; units:symbol "V" ; units:render "%.4f V" ] ] .

val:DiodePair a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "DiodePair" ;
    rdfs:comment """Two diodes in antiparallel across a signal, the classic soft clipper of overdrive and distortion
pedals (https://en.wikipedia.org/wiki/Clipper_(electronics)). Their current rises exponentially
with voltage, so the output rises with the input at first and then flattens, symmetrically. The
Shockley equation gives the shape: val:saturationCurrent and val:emissionCoefficient are the diode's
parameters, with defaults close to a silicon 1N4148, and val:seriesResistance is the resistor the
diodes shunt against (1 ohm to 1 megohm, default 1 kilohm).

Treat the input as volts. The output stays below about half a volt, so the signal comes out much
quieter than it went in; follow it with a val:Gain. A larger resistance clips earlier. Because it is
symmetric it adds odd harmonics; for even harmonics as well use val:Diode or val:AsymClip.""" ;
    val:implementation "DiodePair" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "saturationCurrent" ;
        lv2:name "Is" ; lv2:default 2.52e-9 ;
        lv2:minimum 1e-15 ; lv2:maximum 1e-3 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "emissionCoefficient" ;
        lv2:name "n" ; lv2:default 1.752 ;
        lv2:minimum 1.0 ; lv2:maximum 2.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "seriesResistance" ;
        lv2:name "Rs" ; lv2:default 1000.0 ;
        lv2:minimum 1.0 ; lv2:maximum 1e6 ;
        units:unit [ a units:Unit ; units:symbol "ohm" ; units:render "%.0f R" ] ] .

val:Triode a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "Triode" ;
    rdfs:comment """A waveshaper in the manner of a triode valve stage, as in the preamp of a guitar amplifier
(https://en.wikipedia.org/wiki/Triode). The input is offset by val:bias, in volts and negative
as in a real stage; positive excursions are compressed softly as the grid starts to conduct, and
negative ones are cut off more abruptly. The two halves are shaped differently, so it adds both even
and odd harmonics and sounds richer than a symmetric clipper. val:mu, the amplification factor
(1 to 250, about 100 for a 12AX7), scales how much the stage changes the signal.

It is a model of the behaviour and not a circuit solution. Chain two or three with val:OnePole
highpass filters between them to build up the cascading gain stages of an amplifier; the output has a
DC offset, so couple stages with a highpass at 20 Hz or so before the next one.""" ;
    val:implementation "Triode" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mu" ;
        lv2:name "mu" ; lv2:default 100.0 ;
        lv2:minimum 1.0 ; lv2:maximum 250.0 ;
        rdfs:comment "Amplification factor" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bias" ;
        lv2:name "Bias" ; lv2:default -1.5 ;
        lv2:minimum -10.0 ; lv2:maximum 0.0 ;
        units:unit [ a units:Unit ; units:symbol "V" ; units:render "%.2f V" ] ] .

val:AsymClip a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "AsymClip" ;
    rdfs:comment """An asymmetric soft clipper with separate thresholds for the positive and negative halves, which
models diodes that are not matched, such as the pair in a Klon Centaur (a germanium pair on one half
and a single Schottky on the other). val:drive multiplies the input first; val:posVf and val:negVf
(0.01 to 2, default 0.3 and 0.6) are the voltages at which each half starts to round off.

Clipping the two halves differently adds even harmonics as well as odd ones, which sounds fuller
and less harsh than a symmetric clipper. Lower thresholds clip earlier and harder. Keep the two
different for the effect; set them equal and it becomes a symmetric clipper. Use after a val:Gain
that sets how hard the signal arrives.""" ;
    val:implementation "AsymClip" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "drive" ;
        lv2:name "Drive" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 100.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "posVf" ;
        lv2:name "Positive Vf" ; lv2:default 0.3 ;
        lv2:minimum 0.01 ; lv2:maximum 2.0 ;
        units:unit [ a units:Unit ; units:symbol "V" ; units:render "%.2f V" ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "negVf" ;
        lv2:name "Negative Vf" ; lv2:default 0.6 ;
        lv2:minimum 0.01 ; lv2:maximum 2.0 ;
        units:unit [ a units:Unit ; units:symbol "V" ; units:render "%.2f V" ] ] .

################################################################
# Utility                                                      #
################################################################

val:Gain a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Gain" ;
    rdfs:comment """Multiplies the audio by a fixed amount, set in decibels. 0 dB leaves it unchanged, -6 dB roughly
halves the amplitude and +6 dB roughly doubles it. The range is -60 to +24 dB.

Use it to match levels between stages, to set how hard a signal hits a nonlinear element such as
val:Tanh or val:Ladder, and to make up the level that a clipper or the val:DiodePair takes away. A
sum from a val:Mixer often needs a negative gain to stay under full scale. A control arc into
val:gain replaces the value every block.""" ;
    val:implementation "Gain" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 0.0 ;
        lv2:minimum -60.0 ; lv2:maximum 24.0 ; units:unit units:db ] .

val:VCA a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "VCA" ;
    rdfs:comment """A voltage-controlled amplifier: it multiplies the audio by val:cv, a control value held between 0
(silence) and 1 (full level). It is how a note gets its shape: a val:Envelope into val:cv makes the
sound start, hold and die away.

The usual wiring is val:Oscillator into this into val:Output, with the envelope on a control arc to
val:cv. Because val:cv is read once per control block of 32 samples, very fast changes step rather
than glide. Several VCAs in series multiply, so velocity and an envelope can each have their own.
A control arc replaces val:cv every block. Use val:Gain for a fixed level in decibels.""" ;
    val:implementation "VCA" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "cv" ;
        lv2:name "CV" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Mixer a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Mixer" ;
    rdfs:comment """Adds together every signal that arrives at it. It is the only element where more than one arc may
reach the same input; anywhere else a second arc is an error. Mono signals go to val:in and come
out at val:out; stereo signals go to val:left and val:right and come out at the matching outputs.

Nothing is scaled, so several full-level signals add up past full scale and clip. Follow a mixer of
several voices with a val:Gain of a few decibels below zero, or a val:Limiter. Use it to combine
voices, to add a dry signal to an effect's output, or to merge an envelope-shaped noise burst with
a tone.""" ;
    val:implementation "Mixer" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;    lv2:name "In" ] ,
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ;   lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] .

val:Quantise a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Quantise" ;
    rdfs:comment """Snaps a pitch, in semitones, to the nearest note of a scale. The
scale is counted from a root pitch class, so with root 2 and Major the notes are
those of D major. Halfway between two notes the lower is chosen. Free passes the
value through unchanged.

It acts on semitones, so it sits between a source of intervals and whatever uses
them: val:MidiInterval into val:Quantise into a granulator's pitch plays only
notes of the scale however the keyboard is played.

Custom snaps to the notes of the Scala scale val:tuning names, counted up from the root
and repeating at the scale's last interval. The output is in semitones, so a scale of
other than twelve notes gives fractions. Without a val:tuning, Custom passes the value
through unchanged.""" ;
    val:implementation "Quantise" ;
    val:hasOption val:tuning ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "in" ;
        lv2:name "In" ; lv2:default 0.0 ;
        lv2:minimum -96.0 ; lv2:maximum 96.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "root" ;
        lv2:name "Root" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 11.0 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Pitch class of the scale's root, 0 for C." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "scale" ;
        lv2:name "Scale" ; lv2:default 4.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Free"         ; rdf:value 0 ] ,
                       [ rdfs:label "Semitones"    ; rdf:value 1 ] ,
                       [ rdfs:label "Octaves"      ; rdf:value 2 ] ,
                       [ rdfs:label "Fifths"       ; rdf:value 3 ] ,
                       [ rdfs:label "Major"        ; rdf:value 4 ] ,
                       [ rdfs:label "Minor"        ; rdf:value 5 ] ,
                       [ rdfs:label "Pentatonic"   ; rdf:value 6 ] ,
                       [ rdfs:label "Custom"       ; rdf:value 7 ] ; ] .

val:tuning a rdf:Property ;
    rdfs:label "tuning" ;
    rdfs:range xsd:string ;
    rdfs:comment """Path to a Scala (.scl) tuning file, read on the message thread. Paths
resolve as val:file does. A file that is missing or malformed fails the load with the line
that was wrong. The format is described at
<https://www.huygens-fokker.org/scala/scl_format.html>; thousands of scales are
published in the Scala archive, <https://www.huygens-fokker.org/docs/scales.zip>.""" .

val:Scale a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Scale" ;
    rdfs:comment """Maps a control signal onto a range: the output is min + in * (max - min). Fed an envelope or a
signal running from 0 to 1, it turns it into a value in the units the target wants, such as a
cutoff in hertz between val:min and val:max. A value outside 0 to 1 continues along the same line.

It is also where a resting value belongs. A control arc replaces the target port every block, so
a filter's base cutoff cannot be set on the filter; it is val:min here, and the envelope lifts it
toward val:max. Setting val:min above val:max inverts the signal, which is how to make an envelope
that closes a gate or ducks a level.""" ;
    val:implementation "Scale" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "in" ;
        lv2:name "In" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "min" ;
        lv2:name "Min" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "max" ;
        lv2:name "Max" ; lv2:default 1.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] .

val:ControlMultiply a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "ControlMultiply" ;
    rdfs:comment """Multiplies two control signals: the output is val:a times val:b. Use it to apply one control to
another, such as velocity to an envelope's level, a modulation depth to an LFO, or a note's
frequency to a pitch ratio (val:MidiPitch times a pitch envelope's ratio gives a note that bends).

Control signals update once per block of 32 samples, so this multiplies control values and not
audio. To multiply audio by a control, use val:VCA; for audio times audio there is no element
yet. Both inputs usually come from control arcs; an input with no arc keeps its own value.""" ;
    val:implementation "ControlMultiply" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "a" ;
        lv2:name "A" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "b" ;
        lv2:name "B" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] .

val:ControlAdd a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "ControlAdd" ;
    rdfs:comment """Adds three control signals: the output is val:a plus val:b plus val:c. Use it to
offset one control by another, such as a pitch in Hz plus a detune in Hz, a note's frequency plus a
vibrato, or a base cutoff plus an envelope's sweep. An input with no arc keeps its own value, so
setting val:b on the element itself gives a fixed offset, and the unused third input adds nothing.

Control signals update once per block of 32 samples, so this adds control values and not audio.
For audio, mix with val:Mixer. To multiply controls, use val:ControlMultiply.""" ;
    val:implementation "ControlAdd" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "a" ;
        lv2:name "A" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "b" ;
        lv2:name "B" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "c" ;
        lv2:name "C" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] .

val:Slew a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Slew" ;
    rdfs:comment """Makes a control signal move to its target over a time instead of jumping. Use it for
portamento (a note's frequency through val:Slew into an oscillator), a theremin's glide, legato
leads, or to soften a stepped control such as a sequencer's pitch.

val:rise is the time in milliseconds for a rising input and val:fall for a falling one. The
approach is exponential: the output covers 90% of a step in that time and the rest more slowly,
like a capacitor charging. A time of 0 follows the input at once. The first value after a reset is
taken as it is, so the circuit does not begin with a glide up from zero.""" ;
    val:implementation "Slew" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "in" ;
        lv2:name "In" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "rise" ;
        lv2:name "Rise" ; lv2:default 50.0 ;
        lv2:minimum 0.0 ; lv2:maximum 10000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "fall" ;
        lv2:name "Fall" ; lv2:default 50.0 ;
        lv2:minimum 0.0 ; lv2:maximum 10000.0 ; units:unit units:ms ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] .

val:AudioSelect a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "AudioSelect" ;
    rdfs:comment """Passes one of three audio inputs, a, b or c, chosen by val:select. A change of
choice is a five millisecond crossfade, so switching does not click. Use it to pick between the
outputs of one element, such as the lowpass, bandpass and highpass of a val:StateVariable, with
a single control.""" ;
    val:implementation "AudioSelect" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "a" ; lv2:name "A" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "b" ; lv2:name "B" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "c" ; lv2:name "C" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "select" ;
        lv2:name "Select" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "A" ; rdf:value 0 ] ,
                       [ rdfs:label "B" ; rdf:value 1 ] ,
                       [ rdfs:label "C" ; rdf:value 2 ] ] .

val:pattern a rdf:Property ;
    rdfs:label "pattern" ;
    rdfs:range xsd:string ;
    rdfs:comment """The steps of a val:StepSequencer, separated by spaces: a note name such as C3,
F#2 or Bb4 (C4 is middle C, MIDI note 60), a number from 0 to 127, or . for a rest. At most 64.""" .

val:StepSequencer a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "StepSequencer" ;
    rdfs:comment """Plays a pattern of notes and rests in time with the host. val:pattern lists the
steps; each lasts val:division quarter notes, so the default 0.25 is a sixteenth and a pattern
of sixteen steps is one bar of four-four. While the host plays, the step follows its musical
position, so the sequence stays in time through a relocate and whatever the buffer size. When
the host is stopped it runs on its own at the last tempo, as val:Transport does.

val:gate is high for the first val:gatelength of each step that holds a note, and low on rests.
val:note is the step's MIDI note, val:pitch the same in hertz, for an oscillator, and val:step
the step number, from 0. val:transpose moves the whole pattern in semitones. Connect val:gate to
a val:Envelope's gate and val:pitch to an oscillator's frequency. The sequencer sounds nothing
itself: it is the sequencer in a circuit and not the voice.""" ;
    val:implementation "StepSequencer" ;
    val:hasOption val:pattern ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "gate" ; lv2:name "Gate" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "note" ; lv2:name "Note" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 127.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "pitch" ; lv2:name "Pitch" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "step" ; lv2:name "Step" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 63.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "division" ;
        lv2:name "Division" ; lv2:default 0.25 ;
        lv2:minimum 0.015625 ; lv2:maximum 16.0 ;
        rdfs:comment "Length of a step in quarter notes." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gatelength" ;
        lv2:name "Gate length" ; lv2:default 0.5 ;
        lv2:minimum 0.01 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "transpose" ;
        lv2:name "Transpose" ; lv2:default 0.0 ;
        lv2:minimum -48.0 ; lv2:maximum 48.0 ; lv2:portProperty lv2:integer ; units:unit units:semitone12TET ] .

val:ControlMax a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "ControlMax" ;
    rdfs:comment """The largest of up to three control signals. Used on gates it is an OR: the
output is high when any input is, which lets several gates reach a port that takes one arc,
such as a val:SampleLoad's val:choke. An input with nothing connected never wins.""" ;
    val:implementation "ControlMax" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "a" ;
        lv2:name "A" ; lv2:default -1.0e6 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "b" ;
        lv2:name "B" ; lv2:default -1.0e6 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "c" ;
        lv2:name "C" ; lv2:default -1.0e6 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] .

val:Select a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Select" ;
    rdfs:comment """Two-way control switch. select picks a when it is off and b
when it is on, so one toggle in the Controls view can supply whatever pair of
values a circuit needs rather than only 0 and 1.

thru repeats the resolved switch position, so one switch can reach several
destinations: chain it into another Select's select, or into a
val:ControlMultiply to gate a control path off.""" ;
    val:implementation "Select" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "a" ;
        lv2:name "A" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "b" ;
        lv2:name "B" ; lv2:default 1.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "select" ;
        lv2:name "Select" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                       [ rdfs:label "On"  ; rdf:value 1 ] ;
        rdfs:comment "Off passes a, on passes b. The Controls view draws this as a switch." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "thru" ;
        lv2:name "Thru" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Pan a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Pan" ;
    rdfs:comment """An equal-power stereo panner. It takes a mono signal and places it between the left and right
channels with val:pan, from -1 (all left) through 0 (centre) to 1 (all right). Equal power means
the loudness stays the same as the sound moves, rather than dipping in the middle.

The outputs are val:left and val:right, which go to the matching inputs of val:Output (or of a
val:Mixer), and val:out, the combined signal. Use one per voice to spread a drum kit or a chord
across the stereo field, and drive val:pan from a val:LFO or a val:Drift for movement.""" ;
    val:implementation "Pan" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in" ;    lv2:name "In" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "pan" ;   lv2:name "Pan" ;
        lv2:default 0.0 ; lv2:minimum -1.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out" ;   lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "right" ; lv2:name "Right" ] .

val:Choke a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Choke" ;
    rdfs:comment """A gate that can be cut off by another. It passes val:gate through to val:out until val:choke goes
high; then the output drops to zero and stays there until the next rising edge of val:gate, so the
next note plays normally.

This is the hi-hat rule: playing the closed hat chokes the open hat. Feed the open hat's note gate
to val:gate and the closed hat's gate to val:choke. It acts on a control signal, so it stops
the trigger of a sound and not a sample that is already playing; to cut a sample off mid-play use
the choke port of val:SampleLoad, with val:ControlMax to combine several gates.""" ;
    val:implementation "Choke" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "gate" ;
        lv2:name "Gate" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "choke" ;
        lv2:name "Choke" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ;
        lv2:name "Out" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:SignalGenerator a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "SignalGenerator" ;
    rdfs:comment """A test signal source for trying a circuit without a keyboard or a recording: a sine (shape 0),
square (1), saw (2), triangle (3), white noise (4) or an impulse train at the frequency (5), at
val:frequency (1 Hz to 20 kHz) and val:amplitude (0 to 1).

The waves are plain geometric shapes without the correction that val:Oscillator applies, so at high
frequencies they alias; use it to exercise effects and to measure, and use val:Oscillator for
anything meant to be played. An impulse train is the quickest way to see an effect's decay or an
echo. The noise sequence is the same every time, so a render repeats exactly.""" ;
    val:implementation "SignalGenerator" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "frequency" ;
        lv2:name "Frequency" ; lv2:default 440.0 ;
        lv2:minimum 1.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "amplitude" ;
        lv2:name "Amplitude" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "shape" ;
        lv2:name "Shape" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 5.0 ; lv2:portProperty lv2:integer ] .

val:Oscilloscope a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Oscilloscope" ;
    rdfs:comment """A monitor: it passes audio straight through and measures it. Its control outputs val:peak, val:rms
and val:frequency (an estimate of the pitch) are what the Controls view draws as a waveform and a
level, and what the read_outputs tool returns.

Put one in the signal path to watch a signal at that point, or branch the audio to it and leave
its output unconnected. It changes nothing in the sound and costs little. An element that has no
path to the output is normally reported as unheard by lint; a monitor is the exception, because
looking at a signal is its purpose.""" ;
    val:implementation "Oscilloscope" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in" ;   lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out" ;  lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "peak" ; lv2:name "Peak" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "rms" ;  lv2:name "RMS" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "frequency" ; lv2:name "Frequency" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] .

val:NoteOut a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "NoteOut" ;
    rdfs:comment """Turns a control gate into MIDI note events on the plugin's
output. The gate rising sends a note on, the gate falling releases it.

The pitch is read once, when the note starts, so moving the control while the
note is held does not retune a note the host has already been told about. It is
a frequency in Hz, rounded to the nearest semitone, so val:MidiPitch and
val:Oscilloscope's frequency estimate both drive it directly. Behind the latter
this is an audio-to-MIDI converter assembled from parts that already existed.

The output is an atom:AtomPort carrying midi:MidiEvent, which is LV2's own
spelling. It has no buffer and no control slot: the engine collects what every
element emits into one bounded list per block and hands it to the host.""" ;
    val:implementation "NoteOut" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gate" ; lv2:name "Gate" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pitch" ; lv2:name "Pitch" ;
        lv2:default 440.0 ; lv2:minimum 8.0 ; lv2:maximum 12544.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ; lv2:name "Velocity" ;
        lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "channel" ; lv2:name "Channel" ;
        lv2:default 1.0 ; lv2:minimum 1.0 ; lv2:maximum 16.0 ;
        lv2:portProperty lv2:integer ] ,
      [ a lv2:OutputPort, atom:AtomPort ; atom:supports midi:MidiEvent ;
        lv2:symbol "out" ; lv2:name "Out" ] .

val:SpectralGate a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "SpectralGate" ;
    rdfs:comment """Removes every frequency bin quieter than val:threshold, leaving
the rest untouched. Not something a time-domain filter can do: it takes quiet
broadband noise out from underneath a loud tone, rather than removing a band.

Works on a window rather than on one sample at a time. A 1024-point Hann window
with a quarter-window hop, analysed and resynthesised by overlap-add, which
costs one window of latency. The engine adds that to the circuit's reported
latency, so the host compensates for it.

val:fftSize sets the window, as a power of two between 64 and 8192. A larger
window separates frequencies more finely and costs more latency.

See https://en.wikipedia.org/wiki/Short-time_Fourier_transform""" ;
    val:implementation "SpectralGate" ;
    val:hasOption val:fftSize ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;  lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "threshold" ;
        lv2:name "Threshold" ; lv2:default -60.0 ;
        lv2:minimum -120.0 ; lv2:maximum 0.0 ; units:unit units:db ] .

val:SpectralDelay a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "SpectralDelay" ;
    rdfs:comment """Delays each frequency by its own time, so a sound arrives spread out in
pitch: with a positive val:spread the highs trail the lows, like a chirp played backwards, and
with a negative one the lows trail. A val:spread of zero is an ordinary delay. The delay of a
bin is val:time at its centre, from nothing to twice val:time across the spectrum at full
spread.

Delay is in whole frames of the short-time Fourier transform, so its resolution is one hop,
about 5 ms at the default 1024-point window and 48 kHz. val:feedback returns each bin to its
own delay line, so every frequency repeats on its own schedule. val:fftSize sets the window as
for val:SpectralGate; a larger window costs more latency, which is declared.

See https://en.wikipedia.org/wiki/Short-time_Fourier_transform""" ;
    val:implementation "SpectralDelay" ;
    val:hasOption val:fftSize ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;  lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "time" ;
        lv2:name "Time" ; lv2:default 200.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "spread" ;
        lv2:name "Spread" ; lv2:default 0.5 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 0.95 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:Codec a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "Codec" ;
    rdfs:comment """The sound of low-bitrate audio coding. Frequencies above val:bandwidth are
removed, bins more than val:floor decibels below the loudest in each frame are dropped, and the
magnitudes that are left are rounded to steps of val:step decibels. The bins that survive
change from frame to frame, so what remains warbles and swirls the way a coarse codec does.

This is an approximation of the effect and not a model of any one encoder: it has no
psychoacoustic masking, no bit allocation and no codec transform of its own. It works on a
1024-point short-time Fourier transform and declares its latency.
A val:floor of 0 and a val:step of 0 with the bandwidth at its top leave the signal as it
was, delayed.

See https://en.wikipedia.org/wiki/Audio_coding_format""" ;
    val:implementation "Codec" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;  lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bandwidth" ;
        lv2:name "Bandwidth" ; lv2:default 12000.0 ;
        lv2:minimum 500.0 ; lv2:maximum 24000.0 ;
        lv2:portProperty lv2:logarithmic ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "step" ;
        lv2:name "Step" ; lv2:default 3.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "floor" ;
        lv2:name "Floor" ; lv2:default 30.0 ;
        lv2:minimum 0.0 ; lv2:maximum 90.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:LPC a rdfs:Class ; rdfs:subClassOf val:Filter ;
    rdfs:label "LPC" ;
    rdfs:comment """Linear predictive cross-synthesis, a vocoder that works on the spectral
envelope. The first input, val:in, is the modulator, usually a voice. The second, val:carrier,
is what is shaped, usually a buzzy or noisy signal. The output is the carrier with the
modulator's formants, so a sawtooth can be made to speak.

Every 128 samples a window of each input is fitted with an all-pole model of val:order poles by
Levinson-Durbin recursion on its autocorrelation, which always gives a stable filter. The
carrier is whitened by the inverse of its own model, so its own shape does not matter, then
passed through the modulator's model and scaled to the modulator's level. There is no latency.
A higher val:order follows the envelope in more detail; about 16 suits speech at 48 kHz.
val:mix blends the result with the plain carrier.

See https://en.wikipedia.org/wiki/Linear_predictive_coding""" ;
    val:implementation "LPC" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;      lv2:name "Modulator" ] ,
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "carrier" ; lv2:name "Carrier" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ;     lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "order" ;
        lv2:name "Order" ; lv2:default 16.0 ;
        lv2:minimum 2.0 ; lv2:maximum 32.0 ; lv2:portProperty lv2:integer ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:FreqAnalyzer a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "FreqAnalyzer" ;
    rdfs:comment """A monitor: it passes audio straight through and measures where its energy is. Its control outputs
val:low, val:mid and val:high are the share of energy in three bands (each 0 to 1), and
val:centroid is the spectrum's centre of mass in hertz, higher meaning brighter. The Controls view
draws them as a spectrum, and the read_outputs tool returns them.

Put one in the signal path, or branch the audio to it. It changes nothing in the sound. For a
fuller measurement of a whole render, with the pitch and the level of each octave, use the
analyze tool.""" ;
    val:implementation "FreqAnalyzer" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort   ; lv2:symbol "in" ;   lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort   ; lv2:symbol "out" ;  lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "low" ;  lv2:name "Low" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "mid" ;  lv2:name "Mid" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "high" ; lv2:name "High" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "centroid" ; lv2:name "Centroid" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 20000.0 ; units:unit units:hz ] .

val:Delay a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Delay" ;
    rdfs:comment """A single-tap delay line with feedback, up to 5 seconds. val:time is the delay in milliseconds and
val:feedback, from 0 to 0.99, sends that fraction of the delayed signal back in, so each repeat is
quieter than the last. The output is the delayed signal alone, with none of the dry input, so mix
the two with a val:Mixer or a val:DryWet.

The delay is a whole number of samples and the repeats are not filtered, so they are clean and
exact. Changing val:time while sound is passing makes a click, because the read point jumps. For
repeats that darken with each pass and for smooth time changes, use val:BucketBrigade; for a
reverb, val:Reverb.""" ;
    val:implementation "Delay" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "time" ;
        lv2:name "Time" ; lv2:default 250.0 ;
        lv2:minimum 0.0 ; lv2:maximum 5000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "feedback" ;
        lv2:name "Feedback" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 0.99 ] .

val:Reverb a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Reverb" ;
    rdfs:comment """Eight-line feedback delay network with four allpass diffusers on the
input (Jot and Chaigne, 1991: https://en.wikipedia.org/wiki/Reverberation#Feedback_delay_network).
The lines are mixed by an orthogonal Hadamard matrix, which loses no energy, so
the gain on each line alone sets the decay and the network cannot grow.

val:decay is the time for the tail to fall 60 dB at low frequencies, whatever
val:size is. val:damping is a lowpass in each line, so it shortens the high
frequencies only. Size scales every delay line, from a small room to a large hall;
it glides when changed. Mix is 0 for the dry input and 1 for the tail alone.

The element has one input and two outputs. val:out and val:right carry tails taken from
different combinations of the same eight lines, so they are alike in level and decay but
not copies of each other. Send them to the left and right outputs for a wide tail; use
val:out alone for a mono one.""" ;
    val:implementation "Reverb" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "size" ;
        lv2:name "Size" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 2.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "decay" ;
        lv2:name "Decay" ; lv2:default 2.0 ;
        lv2:minimum 0.1 ; lv2:maximum 20.0 ; units:unit units:s ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "damping" ;
        lv2:name "Damping" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 0.3 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:NamModel a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "NamModel" ;
    rdfs:comment """Runs a Neural Amp Modeler capture, a .nam file named by
val:model, as a nonlinear audio element. NAM is the open format for neural
captures of guitar amplifiers and pedals: https://www.neuralampmodeler.com/.

The model is read on the message thread when the circuit is installed. A model
trained at a rate other than the engine's is refused. Input and output are in
decibels either side of the network; the network itself is level sensitive, so
the input control is part of the tone. Bypass passes the input through.

A circuit that declares val:sha256 has the model file checked against it, so a capture
that was replaced since the circuit was written is not run in its place. A mismatch, like
a missing or unreadable file, leaves the element passing its input through and says why.""" ;
    val:implementation "NamModel" ;
    val:hasOption val:model , val:sha256 ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "input" ;
        lv2:name "Input" ; lv2:default 0.0 ;
        lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "output" ;
        lv2:name "Output" ; lv2:default 0.0 ;
        lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "bypass" ;
        lv2:name "Bypass" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Model" ; rdf:value 0 ] ,
                       [ rdfs:label "Bypass" ; rdf:value 1 ] ] .

val:RateLevelEnvelope a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Rate and level envelope" ;
    rdfs:comment """The DX7's envelope generator: four rates and four levels, on the
machine's 0 to 99 scales. On key down the level goes to l1 at rate r1, then to l2
at r2, then to l3 at r3 and stays there while the key is held. On key up it goes to
l4 at r4. Its output is a control signal from 0 to 1.

Levels are linear in decibels, so a step of level is always the same loudness step.
A rate is a speed, not a time: a segment takes longer the further it has to go,
where an ADSR segment takes the same time whatever the distance. Rate 99 crosses
the whole scale in a few milliseconds and rate 0 takes about forty seconds. The
timings are close to the machine's but are an approximation, not a match.

A long first segment is the usual way to make a plucked or struck tone, with l3
set low so it decays while the key is down. Set l3 to 99 and l4 to 0 for an
organ: full on, full off.

Velocity changes the level: val:velsens is how many 6 dB steps a key struck as
softly as possible loses, so 0 ignores velocity and 7 is a great deal of it.
Connect val:MidiVelocity to velocity.

Keyboard scaling follows the note. val:ratescale, 0 to 7, speeds every segment up as the
key goes higher, by up to about 27 steps of rate at the top of the keyboard, so high notes
are shorter than low ones as on an acoustic instrument. val:leftdepth and val:rightdepth add
or remove steps of level for keys below and above val:breakpoint, in a straight line up to
three octaves out; a negative depth makes the keys on that side quieter. These are smooth
approximations of the machine's stepped curves.

Used for pitch, the same contour comes out of val:ratio as a frequency ratio. A level of 50 is
no change, 99 is val:pitchrange octaves up and 0 as many down, so a pitch envelope sets l4
to 50 to rest on the note. Multiply it into the note's frequency with val:ControlMultiply. At
the default range of 0 the ratio is 1.

See https://en.wikipedia.org/wiki/Yamaha_DX7""" ;
    val:implementation "RateLevelEnvelope" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "ratio" ; lv2:name "Pitch ratio" ;
        lv2:default 1.0 ; lv2:minimum 0.0625 ; lv2:maximum 16.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratescale" ; lv2:name "Rate scaling" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "breakpoint" ; lv2:name "Level breakpoint" ;
        lv2:default 60.0 ; lv2:minimum 0.0 ; lv2:maximum 127.0 ; lv2:portProperty lv2:integer ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "leftdepth" ; lv2:name "Left depth" ;
        lv2:default 0.0 ; lv2:minimum -99.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "rightdepth" ; lv2:name "Right depth" ;
        lv2:default 0.0 ; lv2:minimum -99.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pitchrange" ; lv2:name "Pitch range" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0 ; units:unit units:oct ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "r1" ; lv2:name "Rate 1" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "r2" ; lv2:name "Rate 2" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "r3" ; lv2:name "Rate 3" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "r4" ; lv2:name "Rate 4" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "l1" ; lv2:name "Level 1" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "l2" ; lv2:name "Level 2" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "l3" ; lv2:name "Level 3" ;
        lv2:default 99.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "l4" ; lv2:name "Level 4" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 99.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "velsens" ;
        lv2:name "Velocity sensitivity" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 7.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gate" ;
        lv2:name "Gate" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI gate (default), 0/1 = explicit off/on." ] .

val:Envelope a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Envelope" ;
    rdfs:comment """An ADSR contour: attack, decay, sustain, release. When the gate rises the output climbs from
where it is to 1 over val:attack milliseconds, falls to val:sustain (0 to 1) over val:decay, and
holds there while the note is held; when the gate falls it goes to 0 over val:release. The
output is a control signal from 0 to 1, not audio (https://en.wikipedia.org/wiki/Envelope_(music)).

By default it follows the host's MIDI gate, so any note starts it. To drive it from something
else (a val:NoteGate for one note, a val:StepSequencer's gate, a val:GrainCloud's onset) connect
that to val:gate. Typical wiring: into a val:VCA's val:cv to shape loudness, or through a
val:Scale into a filter's cutoff to shape brightness. Percussive sounds use a short attack and decay
with sustain 0.""" ;
    val:implementation "Envelope" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "attack" ;
        lv2:name "Attack" ; lv2:default 10.0 ;
        lv2:minimum 0.1 ; lv2:maximum 5000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "decay" ;
        lv2:name "Decay" ; lv2:default 200.0 ;
        lv2:minimum 0.1 ; lv2:maximum 5000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "sustain" ;
        lv2:name "Sustain" ; lv2:default 0.7 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "release" ;
        lv2:name "Release" ; lv2:default 300.0 ;
        lv2:minimum 0.1 ; lv2:maximum 10000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gate" ;
        lv2:name "Gate" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = use host MIDI gate (default), 0/1 = explicit off/on. Connect a NoteGate.gate arc for per-note drum triggering." ] .

val:Input a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Input" ;
    rdfs:comment """The plugin's audio input. Mirrors val:Output: "out" carries the
host's channels summed to mono, and "left" and "right" carry the first two
channels separately.

Elements are mono, so a stereo circuit is two mono chains taken from "left" and
"right" and returned to val:Output's "left" and "right". A subcircuit written
once and instantiated per channel is the tidy way to write that; see
examples/subcircuit.ttl.""" ;
    val:implementation "Input" ;
    val:linear true ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ;   lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] .

val:Output a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Output" ;
    rdfs:comment """The circuit's audio output, which is the sound the plugin sends to the host. Every circuit has
exactly one; without it a circuit will not load. The audio arriving at val:in goes to both
channels; val:left and val:right feed the two channels separately for a stereo circuit.

It has no controls and no outputs of its own. Elements are mono, so a stereo circuit is two chains
that end at val:left and val:right. A circuit whose output has nothing connected is silent, and
lint reports it. Level is not limited here: put a val:Limiter before it if the signal can exceed
full scale.""" ;
    val:implementation "Output" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ;    lv2:name "In" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] .

################################################################
# Saturators from the Scream reference                         #
#                                                              #
# Algebraic soft clippers, cheap and well behaved. See          #
# docs/skream.md.                                              #
################################################################

val:SinArcTan a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "SinArcTan" ;
    rdfs:comment """Symmetric soft saturation with the curve x / sqrt(x squared + 1), applied to the input times
val:gain. It approaches plus and minus 1 more slowly than val:Tanh, so it stays softer for longer.

Use it where val:Tanh sounds too hard: gentle warmth, rounding peaks, or the first stage of several.
It has the same ports as val:Tanh and can replace it directly. val:antialiasing and
val:oversampling reduce the aliasing the saturation causes.""" ;
    val:implementation "SinArcTan" ;
    val:hasOption val:antialiasing ;
    val:linear false ;
    val:antialiasing val:ADAA1 ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 100.0 ] .

val:SoftSine a rdfs:Class ; rdfs:subClassOf val:Transfer ;
    rdfs:label "SoftSine" ;
    rdfs:comment """Symmetric soft saturation with the curve x / (|x| + 1), applied to the input times val:gain. The knee
is softer than val:SinArcTan and val:Tanh, and the output only approaches plus and minus 1 slowly.

It is the gentlest saturator here and the cheapest to compute. Use it for light warmth, or where
you want the level to keep rising with the input instead of flattening quickly. It has the same
ports as val:Tanh. val:antialiasing and val:oversampling reduce the aliasing the saturation causes.""" ;
    val:implementation "SoftSine" ;
    val:hasOption val:antialiasing ;
    val:linear false ;
    val:antialiasing val:ADAA1 ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "gain" ;
        lv2:name "Gain" ; lv2:default 1.0 ;
        lv2:minimum 0.1 ; lv2:maximum 100.0 ] .

################################################################
# Dynamics                                                     #
#                                                              #
# Detector and gain-computer are separate elements so the      #
# sidechain is visible in the graph rather than hidden inside   #
# a compressor. Scream gates its feedback path from an envelope #
# of the input, which only works if that arc is drawable.       #
################################################################

val:EnvelopeFollower a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "EnvelopeFollower" ;
    rdfs:comment """Turns the loudness of an audio signal into a control signal that follows it. It rectifies the
input and smooths it with val:attack (how fast it rises, in ms) and val:release (how slowly it
falls), in peak mode (val:mode 0) which tracks the highest samples, or RMS mode (1), which tracks
average power and reads more like perceived loudness. The output is roughly 0 to 1 for a signal up
to full scale.

Uses: an auto-wah (follower into a filter cutoff through a val:Scale), ducking and sidechains
(one signal's follower turning down another's val:VCA), and driving a val:Expander as a gate. A
short attack and a release of 100 ms or more is a smooth follower; a slow attack ignores clicks.""" ;
    val:implementation "EnvelopeFollower" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "attack" ;
        lv2:name "Attack" ; lv2:default 1.0 ;
        lv2:minimum 0.01 ; lv2:maximum 1000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "release" ;
        lv2:name "Release" ; lv2:default 100.0 ;
        lv2:minimum 0.1 ; lv2:maximum 5000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mode" ;
        lv2:name "Mode" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Peak" ; rdf:value 0 ] ,
                       [ rdfs:label "RMS"  ; rdf:value 1 ] ;
        rdfs:comment "0 peak, 1 RMS" ] .

val:Expander a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Expander" ;
    rdfs:comment """A downward expander, used as a noise gate: it turns down a signal while it is quiet. It reads its
detector level from val:amount, a linear level that comes from an val:EnvelopeFollower on a control
arc, and compares it with val:threshold in decibels (default -60). Below the threshold, each decibel
the level is under it is pushed down by val:ratio minus 1 more decibels; at a ratio of 20 it is
effectively a gate. Above the threshold the signal passes unchanged.

The sidechain is explicit so that it can come from anywhere: follow the signal itself to gate it,
or follow another signal to gate this one by it. examples/noise-gate.ttl shows it. The gain changes
once per control block, so the follower's attack and release set how smooth the opening and
closing are.""" ;
    val:implementation "Expander" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amount" ;
        lv2:name "Amount" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Detector level driving the gain computer." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "threshold" ;
        lv2:name "Threshold" ; lv2:default -60.0 ;
        lv2:minimum -140.0 ; lv2:maximum 0.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio" ;
        lv2:name "Ratio" ; lv2:default 2.0 ;
        lv2:minimum 1.0 ; lv2:maximum 20.0 ] .

val:Compressor a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Compressor" ;
    rdfs:comment """Giannoulis, Massberg and Reiss soft-knee compressor. Setting
upward above zero adds the upward stage that gives an OTT-style sound. The upward
stage lifts a signal quieter than the threshold, by at most val:boost decibels, so
that silence is not lifted into hiss.

The upward stage has its own threshold, val:liftThreshold: only a signal quieter than it is
lifted, and the downward stage keeps val:threshold. Set apart, they leave a band between the
two that is neither squashed nor lifted, which is how a multiband compressor keeps the body
of a sound. At its lowest setting, -90 dB, val:liftThreshold follows val:threshold, which is
how the element behaved before the port was added.""" ;
    val:implementation "Compressor" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "threshold" ;
        lv2:name "Threshold" ; lv2:default -6.0 ;
        lv2:minimum -60.0 ; lv2:maximum 0.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ratio" ;
        lv2:name "Ratio" ; lv2:default 4.0 ;
        lv2:minimum 1.0 ; lv2:maximum 40.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "knee" ;
        lv2:name "Knee" ; lv2:default 6.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "attack" ;
        lv2:name "Attack" ; lv2:default 5.0 ;
        lv2:minimum 0.01 ; lv2:maximum 500.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "release" ;
        lv2:name "Release" ; lv2:default 100.0 ;
        lv2:minimum 1.0 ; lv2:maximum 5000.0 ; units:unit units:ms ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "upward" ;
        lv2:name "Upward" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "boost" ;
        lv2:name "Max boost" ; lv2:default 18.0 ;
        lv2:minimum 0.0 ; lv2:maximum 60.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "liftThreshold" ;
        lv2:name "Lift threshold" ; lv2:default -90.0 ;
        lv2:minimum -90.0 ; lv2:maximum 0.0 ; units:unit units:db ;
        rdfs:comment "Level below which the upward stage lifts. The lowest setting follows the threshold." ] .

val:Limiter a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Limiter" ;
    rdfs:comment """Lookahead brickwall limiter: no sample leaves louder than val:ceiling.

It looks 1.5 ms ahead. The gain a loud sample needs is worked out before the sample
arrives and reached by a smooth ramp, so a peak is turned down without the click a
limiter that reacts after the fact produces. The audio is delayed by that lookahead and
the delay is reported as latency, so the host compensates for it. val:release is how
quickly the gain recovers once the peak has passed.

This element is mono. For a stereo pair, use one on each side and patch each side's
input into the other's val:link. The detector then listens to the louder of the two, so
both sides are turned down by the same amount and the stereo image does not move. An
unconnected link does nothing.""" ;
    val:implementation "Limiter" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "in" ; lv2:name "In" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "link" ; lv2:name "Link" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "ceiling" ;
        lv2:name "Ceiling" ; lv2:default -0.3 ;
        lv2:minimum -24.0 ; lv2:maximum 0.0 ; units:unit units:db ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "release" ;
        lv2:name "Release" ; lv2:default 60.0 ;
        lv2:minimum 1.0 ; lv2:maximum 1000.0 ; units:unit units:ms ] .

val:LFO a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "LFO" ;
    rdfs:comment """Control-rate oscillator. Its output drives control arcs.

A rise through 0.5 at val:retrigger restarts the cycle from its beginning, so a note started
by the same gate always begins the same sweep. A val:sync above zero is the length of one
cycle in beats: while the host transport plays, the phase follows the host's musical position,
so the LFO stays in time with the song and val:rate and val:retrigger are ignored. When the
transport is stopped it free-runs at val:rate.

The Curve shape plays a drawn waveform. val:curve is a list of numbers from -1 to 1 separated
by spaces or commas, up to 256, spaced evenly over one cycle and joined by straight lines,
with the last point joining back to the first.""" ;
    val:implementation "LFO" ;
    val:hasOption val:curve ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "rate" ;
        lv2:name "Rate" ; lv2:default 2.0 ;
        lv2:minimum 0.01 ; lv2:maximum 100.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "shape" ;
        lv2:name "Shape" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 5.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Sine"            ; rdf:value 0 ] ,
                       [ rdfs:label "Triangle"        ; rdf:value 1 ] ,
                       [ rdfs:label "Saw"             ; rdf:value 2 ] ,
                       [ rdfs:label "Square"          ; rdf:value 3 ] ,
                       [ rdfs:label "Sample and hold" ; rdf:value 4 ] ,
                       [ rdfs:label "Curve"           ; rdf:value 5 ] ;
        rdfs:comment "0 sine, 1 triangle, 2 saw, 3 square, 4 sample-and-hold, 5 drawn curve" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "retrigger" ;
        lv2:name "Retrigger" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "sync" ;
        lv2:name "Sync" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 64.0 ;
        rdfs:comment "Cycle length in beats while the host plays; 0 free-runs at the rate." ] .

val:curve a rdf:Property ;
    rdfs:label "curve" ;
    rdfs:range xsd:string ;
    rdfs:comment """The points of a val:LFO's Curve shape: numbers from -1 to 1 separated by
spaces or commas, evenly spaced over one cycle.""" .

val:Drift a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Drift" ;
    rdfs:comment """Slow, bounded, random control signal: noise pulled back toward zero, an
Ornstein-Uhlenbeck process (https://en.wikipedia.org/wiki/Ornstein%E2%80%93Uhlenbeck_process).
It never repeats as a low-frequency oscillator does, and never wanders off as a random walk
does. Connect it to pitch or cutoff for the slow instability of an analogue circuit.

val:centre is the value it wanders around, so the resting value of what it controls is
set here: a control arc replaces the target's own value. val:amount is the typical
distance from the centre, in the target's units, and the output never goes further than
three times it. val:speed is how quickly it is pulled back: the memory of the signal is
about 1 / speed seconds, so 0.1 is a slow tide and 5 a shiver. val:seed chooses the
sequence, so voices given different seeds drift apart. The same seed after a reset gives
the same drift, so a render repeats exactly.""" ;
    val:implementation "Drift" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "speed" ;
        lv2:name "Speed" ; lv2:default 1.5 ;
        lv2:minimum 0.01 ; lv2:maximum 100.0 ;
        lv2:portProperty lv2:logarithmic ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "amount" ;
        lv2:name "Amount" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1000.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "centre" ;
        lv2:name "Centre" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ] .

val:Vary a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Vary" ;
    rdfs:comment """Picks a new random value each time a trigger fires and holds it until the
next one: a sample-and-hold of noise, so a control can take a different value on every hit.
Connect a gate or a clock to val:trigger and the output to whatever should vary, such as a
filter cutoff or an oscillator's pitch.

The value is drawn between val:min and val:max. val:steps above 1 restricts it to that many
evenly spaced values, from val:min to val:max inclusive; 0 draws any value in range.
val:probability is the chance that a trigger takes a new value, and otherwise the old one is
kept. Until the first one is taken the output rests at the middle of the range.

val:seed chooses the sequence, and the same seed after a reset gives the same values. The
values do not depend on val:probability: lowering it skips hits without changing the ones
that are taken. A trigger is a rise through 0.5.""" ;
    val:implementation "Vary" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "min" ;
        lv2:name "Min" ; lv2:default 0.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "max" ;
        lv2:name "Max" ; lv2:default 1.0 ;
        lv2:minimum -1.0e6 ; lv2:maximum 1.0e6 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "probability" ;
        lv2:name "Probability" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "steps" ;
        lv2:name "Steps" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 64.0 ;
        lv2:portProperty lv2:integer ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ] .

val:MidiPitch a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "MidiPitch" ;
    rdfs:comment """Outputs the frequency of the most recent MIDI note as a control signal (Hz).
Holds the last value; defaults to A4 (440 Hz) before any note.

val:reference tunes the A above middle C, from 400 to 480 Hz. With a val:tuning the notes
follow a Scala scale instead of twelve to the octave: val:root is the MIDI note that
sounds the scale's first degree, at the pitch twelve-tone tuning gives that key, and each
key above or below it is one scale degree further. The scale repeats at its last interval,
usually the octave.""" ;
    val:implementation "MidiPitch" ;
    val:hasOption val:tuning ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "reference" ;
        lv2:name "Reference A" ; lv2:default 440.0 ;
        lv2:minimum 400.0 ; lv2:maximum 480.0 ; units:unit units:hz ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "root" ;
        lv2:name "Root" ; lv2:default 69.0 ;
        lv2:minimum 0.0 ; lv2:maximum 127.0 ; lv2:portProperty lv2:integer ;
        rdfs:comment "The MIDI note that sounds the first degree of a val:tuning. Without one it changes nothing. 69 is A4." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ;
        lv2:default 440.0 ; lv2:minimum 0.0 ; lv2:maximum 20000.0 ;
        units:unit units:hz ] .

val:MidiVelocity a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "MidiVelocity" ;
    rdfs:comment """The velocity of the most recent note-on, as a control value from 0 (softest) to 1 (hardest). It
holds that value between notes.

Use it to make playing harder sound louder or brighter: through a val:VCA's val:cv for loudness, or
through a val:Scale into a filter's cutoff for brightness. For a drum voice that must keep its
velocity until the sound has died away, use val:NoteGate instead, because velocity there is only
present while the note is held.""" ;
    val:implementation "MidiVelocity" ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "out" ; lv2:name "Out" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

val:NoteGate a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "NoteGate" ;
    rdfs:comment """Outputs a gate signal (0 or 1) and the velocity of the most recent
note-on, but only when the incoming MIDI note number matches val:note. Use one
NoteGate per drum instrument to route per-note triggers inside a circuit.""" ;
    val:implementation "NoteGate" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "note" ;
        lv2:name "Note" ; lv2:default 60.0 ;
        lv2:minimum 0.0 ; lv2:maximum 127.0 ; lv2:portProperty lv2:integer ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "gate" ;
        lv2:name "Gate" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "velocity" ;
        lv2:name "Velocity" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

################################################################
# Granular                                                     #
#                                                              #
# A granulator is a source and a processor at once: it records  #
# what arrives at its audio input, or loads a sound file, and   #
# plays short windowed reads of that buffer back. The two       #
# control sources beside it are what a granular instrument      #
# needs and an oscillator does not: the host timeline, and a    #
# MIDI note expressed as an interval rather than a frequency.   #
################################################################

val:file a rdf:Property ;
    rdfs:label "file" ;
    rdfs:range xsd:string ;
    rdfs:comment """Path to a sound file an element loads on the message thread.
Relative paths resolve against the working directory, then examples/, then the
repository root. A path that does not resolve fails the load with an error
rather than leaving the element silent.""" .

val:sha256 a rdf:Property ;
    rdfs:label "sha256" ;
    rdfs:range xsd:string ;
    rdfs:comment """The SHA-256 of the sound file val:file names, as 64 lowercase
hexadecimal characters. Checked on the message thread when the file is read: a
file that has been replaced or edited since the circuit was written fails the
load with a message naming both hashes, rather than playing something the
circuit was not written for.

Optional. A circuit that declares no hash loads whatever the path resolves to,
as before. See https://en.wikipedia.org/wiki/SHA-2 for the hash itself.""" .

val:channels a rdf:Property ;
    rdfs:label "channels" ;
    rdfs:range xsd:integer ;
    rdfs:comment """The channel count val:file is expected to have. Checked
against the file on load. Optional, and independent of val:sha256: dimensions
are worth stating even when the exact bytes are not pinned.""" .

val:sampleRate a rdf:Property ;
    rdfs:label "sampleRate" ;
    rdfs:range xsd:double ;
    rdfs:comment """The sample rate val:file is expected to have been recorded
at, in Hz. Checked against the file on load, before the resampling that brings
it to the engine's rate.""" .

val:frames a rdf:Property ;
    rdfs:label "frames" ;
    rdfs:range xsd:integer ;
    rdfs:comment """The length val:file is expected to have, in frames at its own
sample rate. Checked against the file on load.""" .

val:seconds a rdf:Property ;
    rdfs:label "seconds" ;
    rdfs:range xsd:double ;
    rdfs:comment "Length of an element's internal buffer, in seconds." .

val:Granulator a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "Granulator" ;
    rdfs:comment """Granular synthesiser and processor. One circular buffer
holds the material: audio arriving at the input is recorded at the write head
unless the element is frozen, and val:file replaces the contents with a sound
file summed to mono and resampled to the engine's rate. val:seconds sets the
buffer length (default 8, maximum 60).

Grains are short windowed reads of that buffer, up to 64 at once, each with its
own position, playback rate, window and stereo placement. Onsets either free-run
at the density rate or follow a control arc into the trigger port, which is how
a val:Transport drives grains in time with the host.

position is measured forward from the write head. With a file loaded the write
head sits at the start of the file, so 0 is the beginning and 1 the end. While
recording live input the write head is the present moment, so values near 1
granulate the most recent audio and lower values reach further back.

While the buffer is recording, a grain is kept behind the write head, by two
samples and by however far it will close the gap over its own length if it plays
faster than real time. Without that, a raised pitch at a position near 1 would
read the oldest audio in the buffer.

freeze decides what the buffer does with the audio input. An input with no arc
reaching it records nothing at all, so a circuit that loads val:file and wires
nothing to the input keeps that material without having to say so.

See Roads, Microsound (MIT Press, 2001)
<https://mitpress.mit.edu/9780262681544/microsound/> for the technique.""" ;
    val:implementation "Granulator" ;
    val:hasOption val:file , val:seconds , val:sha256 , val:channels , val:sampleRate , val:frames ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;    lv2:name "In" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ;   lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "position" ;
        lv2:name "Position" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Read point as a fraction of the buffer, measured forward from the write head." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "size" ;
        lv2:name "Size" ; lv2:default 120.0 ;
        lv2:minimum 1.0 ; lv2:maximum 2000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "Grain length. Below 50 ms the grain rate itself becomes the pitch; above it, grains blur into a pad." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "density" ;
        lv2:name "Density" ; lv2:default 20.0 ;
        lv2:minimum 0.01 ; lv2:maximum 200.0 ; units:unit units:hz ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "Grain onsets per second when trigger is -1. Independent of size, so it sets how far grains overlap." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "pitch" ;
        lv2:name "Pitch" ; lv2:default 0.0 ;
        lv2:minimum -48.0 ; lv2:maximum 48.0 ;
        rdfs:comment "Grain transposition in semitones. Connect val:MidiInterval here to play the buffer from a keyboard." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "spray" ;
        lv2:name "Spray" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random spread of each grain's start point, as a fraction of the buffer." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "jitter" ;
        lv2:name "Jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random spread of the interval between onsets. Breaks up the periodicity a fixed density produces." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "pitchJitter" ;
        lv2:name "Pitch Jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ;
        rdfs:comment "Random detune per grain, in semitones. A little gives chorus; an octave gives shimmer." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "shape" ;
        lv2:name "Shape" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Grain window. 0 is nearly rectangular and keeps transients; 1 is a full rise and fall with no audible edge." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "spread" ;
        lv2:name "Spread" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random stereo placement per grain. 0 is centred, 1 is the full width." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "reverse" ;
        lv2:name "Reverse" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Probability that a grain plays backwards." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "scan" ;
        lv2:name "Scan" ; lv2:default 0.0 ;
        lv2:minimum -4.0 ; lv2:maximum 4.0 ;
        rdfs:comment "Drift of the read point through the buffer, in buffer lengths per second. 0 holds still." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "freeze" ;
        lv2:name "Freeze" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Record" ; rdf:value 0 ] ,
                       [ rdfs:label "Freeze" ; rdf:value 1 ] ;
        rdfs:comment "Record writes whatever reaches the audio input into the buffer; Freeze holds what is already there. An input with no arc records nothing, so material loaded by val:file is never erased by a connection that does not exist." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = free-run at the density rate; otherwise each rising edge fires one grain." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "sizeJitter" ;
        lv2:name "Size jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random shortening of each grain. 0 keeps every grain the full size; 1 lets one be a quarter of it. The cloud loses the evenness a fixed size gives it." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "curve" ;
        lv2:name "Curve" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Blends the grain window toward a percussive one: a fast rise to a peak early in the grain and an exponential fall, so grains sound struck or plucked. Both windows have the same average height, so loudness stays close, though the percussive one is peakier and measures somewhat louder." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "range" ;
        lv2:name "Range" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ;
        rdfs:comment "Each grain draws a pitch offset within this many semitones of pitch, in the direction chosen and on the scale chosen. 0 draws nothing. Unlike pitchJitter, which detunes continuously, the draw lands on notes, so a cloud can play a chord rather than blur." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "direction" ;
        lv2:name "Direction" ; lv2:default 2.0 ;
        lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Up"   ; rdf:value 0 ] ,
                       [ rdfs:label "Down" ; rdf:value 1 ] ,
                       [ rdfs:label "Both" ; rdf:value 2 ] ;
        rdfs:comment "Which way the range reaches from pitch." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "scale" ;
        lv2:name "Scale" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 6.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Free"         ; rdf:value 0 ] ,
                       [ rdfs:label "Semitones"    ; rdf:value 1 ] ,
                       [ rdfs:label "Octaves"      ; rdf:value 2 ] ,
                       [ rdfs:label "Fifths"       ; rdf:value 3 ] ,
                       [ rdfs:label "Major"        ; rdf:value 4 ] ,
                       [ rdfs:label "Minor"        ; rdf:value 5 ] ,
                       [ rdfs:label "Pentatonic"   ; rdf:value 6 ]  ;
        rdfs:comment "The notes a grain's pitch may land on, counted from the pitch itself, so the transposed material stays in tune with itself. Free draws any value in the range. Staying on the pitch is always among the choices." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Seeds the random draws, so one seed gives one cloud, every time. 0 is the default sequence." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "grains" ;
        lv2:name "Grains" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 64.0 ;
        rdfs:comment "How many grains are sounding." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "onset" ;
        lv2:name "Onset" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "1 for a control slice in which a grain started and 0 otherwise. Connect it to a val:Envelope's gate, and that envelope to a val:VCA, to have each grain strike something such as a val:ModalBank." ] .

val:BufferPort a rdfs:Class ;
    rdfs:label "BufferPort" ;
    rdfs:comment """A port that hands a block of material to another element instead of carrying a
signal: the audio a granulator's grains are cut from, say. It is declared with lv2:InputPort or
lv2:OutputPort and val:BufferPort, as an event port is with atom:AtomPort, and like one it has no
audio buffer and no control slot.

An arc from a buffer output to a buffer input gives the receiver the material the sender owns, by
reference, and makes the sender run first in every block. Nothing is copied. An output can feed any
number of inputs; an input takes one source. A buffer output can only reach a buffer input, and
the two elements must agree on what is shared, which is checked when the circuit loads.""" .

val:GrainBuffer a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "GrainBuffer" ;
    rdfs:comment """The material half of val:Granulator: a circular buffer that records its audio input
at a write head, or holds a sound file named by val:file, and offers itself on a buffer output to any
number of val:GrainCloud elements. val:seconds sets its length (default 8, at most 60).

val:freeze decides what the buffer does with the audio input: Record writes it, Freeze holds what is
there. An input with no arc reaching it records nothing, so material loaded by val:file is never
erased by a connection that does not exist. The element has no audio output; the grains are heard
through the clouds.""" ;
    val:implementation "GrainBuffer" ;
    val:hasOption val:file , val:seconds , val:sha256 , val:channels , val:sampleRate , val:frames ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:AudioPort ; lv2:symbol "in" ;    lv2:name "In" ] ,
      [ a lv2:OutputPort, val:BufferPort ; lv2:symbol "buffer" ; lv2:name "Buffer" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "freeze" ;
        lv2:name "Freeze" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Record" ; rdf:value 0 ] ,
                       [ rdfs:label "Freeze" ; rdf:value 1 ] ;
        rdfs:comment "Record writes whatever reaches the audio input into the buffer; Freeze holds what is already there. An input with no arc records nothing, so material loaded by val:file is never erased by a connection that does not exist." ]  .

val:GrainCloud a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "GrainCloud" ;
    rdfs:comment """The grain half of val:Granulator. It cuts short windowed grains, up to 64 at once, from
the material its buffer input is given and mixes them into a mono and a stereo output. Everything
else about the grains is as described for val:Granulator: position, size, density, pitch, spray, the
window, the pitch draws from a scale, the trigger and the seed.

What it reads comes from a val:GrainBuffer by a buffer arc, and the buffer runs before the cloud in
every block. Several clouds can read one buffer, each with its own position, size and pitch, which
is what splitting the two is for: one recording granulated at once as a drone an octave down, a
shimmer an octave up and a stutter in time with the host. Nothing is copied; the clouds read the
buffer where it is.

A cloud reads the buffer as it stands at the end of the block it is running in, where val:Granulator
reads it as it stands at that very sample. The difference is at most one block of audio at the
write head, and none at all when the material is a file.""" ;
    val:implementation "GrainCloud" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort, val:BufferPort ; lv2:symbol "buffer" ; lv2:name "Buffer" ;
        rdfs:comment "The material to cut grains from: connect a val:GrainBuffer's buffer. Unconnected, the cloud is silent." ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ;   lv2:name "Out" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "left" ;  lv2:name "Left" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "right" ; lv2:name "Right" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "position" ;
        lv2:name "Position" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Read point as a fraction of the buffer, measured forward from the write head." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "size" ;
        lv2:name "Size" ; lv2:default 120.0 ;
        lv2:minimum 1.0 ; lv2:maximum 2000.0 ; units:unit units:ms ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "Grain length. Below 50 ms the grain rate itself becomes the pitch; above it, grains blur into a pad." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "density" ;
        lv2:name "Density" ; lv2:default 20.0 ;
        lv2:minimum 0.01 ; lv2:maximum 200.0 ; units:unit units:hz ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "Grain onsets per second when trigger is -1. Independent of size, so it sets how far grains overlap." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "pitch" ;
        lv2:name "Pitch" ; lv2:default 0.0 ;
        lv2:minimum -48.0 ; lv2:maximum 48.0 ;
        rdfs:comment "Grain transposition in semitones. Connect val:MidiInterval here to play the buffer from a keyboard." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "spray" ;
        lv2:name "Spray" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random spread of each grain's start point, as a fraction of the buffer." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "jitter" ;
        lv2:name "Jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random spread of the interval between onsets. Breaks up the periodicity a fixed density produces." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "pitchJitter" ;
        lv2:name "Pitch Jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ;
        rdfs:comment "Random detune per grain, in semitones. A little gives chorus; an octave gives shimmer." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "shape" ;
        lv2:name "Shape" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Grain window. 0 is nearly rectangular and keeps transients; 1 is a full rise and fall with no audible edge." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "spread" ;
        lv2:name "Spread" ; lv2:default 0.5 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random stereo placement per grain. 0 is centred, 1 is the full width." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "reverse" ;
        lv2:name "Reverse" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Probability that a grain plays backwards." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "scan" ;
        lv2:name "Scan" ; lv2:default 0.0 ;
        lv2:minimum -4.0 ; lv2:maximum 4.0 ;
        rdfs:comment "Drift of the read point through the buffer, in buffer lengths per second. 0 holds still." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = free-run at the density rate; otherwise each rising edge fires one grain." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "sizeJitter" ;
        lv2:name "Size jitter" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Random shortening of each grain. 0 keeps every grain the full size; 1 lets one be a quarter of it. The cloud loses the evenness a fixed size gives it." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "curve" ;
        lv2:name "Curve" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Blends the grain window toward a percussive one: a fast rise to a peak early in the grain and an exponential fall, so grains sound struck or plucked. Both windows have the same average height, so loudness stays close, though the percussive one is peakier and measures somewhat louder." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "range" ;
        lv2:name "Range" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 24.0 ;
        rdfs:comment "Each grain draws a pitch offset within this many semitones of pitch, in the direction chosen and on the scale chosen. 0 draws nothing. Unlike pitchJitter, which detunes continuously, the draw lands on notes, so a cloud can play a chord rather than blur." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "direction" ;
        lv2:name "Direction" ; lv2:default 2.0 ;
        lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Up"   ; rdf:value 0 ] ,
                       [ rdfs:label "Down" ; rdf:value 1 ] ,
                       [ rdfs:label "Both" ; rdf:value 2 ] ;
        rdfs:comment "Which way the range reaches from pitch." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "scale" ;
        lv2:name "Scale" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 6.0 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Free"         ; rdf:value 0 ] ,
                       [ rdfs:label "Semitones"    ; rdf:value 1 ] ,
                       [ rdfs:label "Octaves"      ; rdf:value 2 ] ,
                       [ rdfs:label "Fifths"       ; rdf:value 3 ] ,
                       [ rdfs:label "Major"        ; rdf:value 4 ] ,
                       [ rdfs:label "Minor"        ; rdf:value 5 ] ,
                       [ rdfs:label "Pentatonic"   ; rdf:value 6 ]  ;
        rdfs:comment "The notes a grain's pitch may land on, counted from the pitch itself, so the transposed material stays in tune with itself. Free draws any value in the range. Staying on the pitch is always among the choices." ]  ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "seed" ;
        lv2:name "Seed" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Seeds the random draws, so one seed gives one cloud, every time. 0 is the default sequence." ]  ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "grains" ;
        lv2:name "Grains" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 64.0 ;
        rdfs:comment "How many grains are sounding." ]  ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "onset" ;
        lv2:name "Onset" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "1 for a control slice in which a grain started and 0 otherwise. Connect it to a val:Envelope's gate, and that envelope to a val:VCA, to have each grain strike something such as a val:ModalBank." ] .

val:TimeStretch a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "TimeStretch" ;
    rdfs:comment """Plays the sound file named by val:file at a different speed without changing its
pitch, or at a different pitch without changing its speed, with the formants kept where they were
if wanted. val:speed is how fast the file is read, 1 being as recorded and 0 holding one moment
of it indefinitely. val:pitch moves the pitch in semitones whatever the speed.

It is a phase vocoder with phase locking round the peaks of the spectrum, on 2048-point
windows: a window is 43 ms at 48 kHz, so very short sounds are smeared and very sharp attacks
lose some of their edge. The result has a slight sheen, as every phase vocoder does. val:formant
keeps the spectral envelope, the shape of the vocal tract in a voice, where it was when the pitch
moves, so a voice shifted up does not turn into a chipmunk; it is estimated from the smoothed
cepstrum and costs two more transforms per frame. It has no effect while val:pitch is 0, and it
is off by default because it suits voices and not everything: a pure tone is all envelope, so
holding its formant where it was takes the shifted tone away. Use it on sounds that have a
vocal tract.

The file is summed to mono and resampled to the engine's rate, as for val:SampleLoad. val:loop,
val:start and val:trigger work as they do there. A frame moves through the file by at most half
its length, so at a high val:speed combined with a downward val:pitch the speed is limited.

The output is delayed by about three windows' worth of the file, because the first samples of
an overlap-add are only partly covered; the delay is not reported as latency since a player has
no input to be late against.""" ;
    val:implementation "TimeStretch" ;
    val:hasOption val:file , val:sha256 , val:channels , val:sampleRate , val:frames ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "speed" ;
        lv2:name "Speed" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 4.0 ;
        rdfs:comment "How fast the file is read. 1 is as recorded, 0.5 half speed, 0 freezes." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "pitch" ;
        lv2:name "Pitch" ; lv2:default 0.0 ;
        lv2:minimum -24.0 ; lv2:maximum 24.0 ; units:unit units:semitone12TET ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "formant" ;
        lv2:name "Keep formants" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "Shift" ; rdf:value 0 ] ,
                       [ rdfs:label "Keep"  ; rdf:value 1 ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "loop" ;
        lv2:name "Loop" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "One shot" ; rdf:value 0 ] ,
                       [ rdfs:label "Loop"     ; rdf:value 1 ] ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "start" ;
        lv2:name "Start" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Where playback begins, as a fraction of the file." ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "-1 plays free-running; otherwise each rise restarts from start." ] .

val:SampleLoad a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "SampleLoad" ;
    rdfs:comment """Plays the sound file named by val:file, summed to mono and
resampled to the engine's rate. The Controls view draws one of these as a file
slot with a Load button, so the sample can be changed without editing the
document.

Feed it into a val:Granulator's audio input to granulate a recording, or use it
on its own as a one-shot player. Where val:Granulator's own val:file loads
material directly into its buffer, a SampleLoad plays the file as audio, which
is what lets the sample be swapped while the circuit runs.""" ;
    val:implementation "SampleLoad" ;
    val:hasOption val:file , val:sha256 , val:channels , val:sampleRate , val:frames ;
    val:linear false ;
    lv2:port
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "speed" ;
        lv2:name "Speed" ; lv2:default 1.0 ;
        lv2:minimum -4.0 ; lv2:maximum 4.0 ;
        rdfs:comment "Playback rate. 1 is the recorded speed, 2 an octave up, negative plays backwards." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "start" ;
        lv2:name "Start" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Where a trigger starts playback, as a fraction of the file." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "loop" ;
        lv2:name "Loop" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        lv2:scalePoint [ rdfs:label "One shot" ; rdf:value 0 ] ,
                       [ rdfs:label "Loop"     ; rdf:value 1 ] ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default -1.0 ;
        lv2:minimum -1.0 ; lv2:maximum 1.0 ;
        rdfs:comment "Override: -1 = play free-running; otherwise each rising edge restarts from start." ] ,
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "choke" ;
        lv2:name "Choke" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        rdfs:comment "A rise through 0.5 stops the sound, fading out over 2 ms. A trigger in the same block wins." ] .

val:Transport a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "Transport" ;
    rdfs:comment """The host timeline as control signals. division is measured
in quarter notes, so 0.25 is a sixteenth and 4 is one bar of four-four. phase
ramps 0 to 1 across each division and trigger is 1 for the one control block in
which it wraps, which is what a val:Granulator trigger port expects.

When the host is stopped, or is a host with no timeline at all, phase free-runs
at the same rate from the last tempo reported, so a circuit still behaves in the
standalone app.""" ;
    val:implementation "Transport" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "division" ;
        lv2:name "Division" ; lv2:default 1.0 ;
        lv2:minimum 0.015625 ; lv2:maximum 64.0 ;
        lv2:portProperty lv2:logarithmic ;
        rdfs:comment "Length of one pulse in quarter notes." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "playing" ;
        lv2:name "Playing" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "tempo" ;
        lv2:name "Tempo" ; lv2:default 120.0 ;
        lv2:minimum 1.0 ; lv2:maximum 999.0 ; units:unit units:bpm ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "phase" ;
        lv2:name "Phase" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "trigger" ;
        lv2:name "Trigger" ; lv2:default 0.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "rate" ;
        lv2:name "Rate" ; lv2:default 2.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1000.0 ; units:unit units:hz ;
        rdfs:comment "Pulses per second at the current tempo and division." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "period" ;
        lv2:name "Period" ; lv2:default 500.0 ;
        lv2:minimum 0.0 ; lv2:maximum 4000000.0 ; units:unit units:ms ;
        rdfs:comment "The length of one pulse in milliseconds, which is what grain size and val:Delay time are measured in. Connect it there to tie a window or an echo to the tempo." ] .

val:MidiInterval a rdfs:Class ; rdfs:subClassOf val:Source ;
    rdfs:label "MidiInterval" ;
    rdfs:comment """The most recent MIDI note as an interval from a root note.
val:MidiPitch answers what frequency to oscillate at; a sampler or granulator
needs how far from the root to transpose, which is this. semitones drives a
val:Granulator pitch port directly; ratio is the same interval as a playback
speed multiplier.""" ;
    val:implementation "MidiInterval" ;
    val:linear false ;
    lv2:port
      [ a lv2:InputPort,  lv2:ControlPort ; lv2:symbol "root" ;
        lv2:name "Root" ; lv2:default 60.0 ;
        lv2:minimum 0.0 ; lv2:maximum 127.0 ; lv2:portProperty lv2:integer ;
        rdfs:comment "The note that plays the material untransposed. 60 is middle C." ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "semitones" ;
        lv2:name "Semitones" ; lv2:default 0.0 ;
        lv2:minimum -127.0 ; lv2:maximum 127.0 ] ,
      [ a lv2:OutputPort, lv2:ControlPort ; lv2:symbol "ratio" ;
        lv2:name "Ratio" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1000.0 ] .

val:DryWet a rdfs:Class ; rdfs:subClassOf val:Element ;
    rdfs:label "DryWet" ;
    rdfs:comment """Crossfades between an unprocessed signal and a processed one. val:dry takes the original, val:wet
takes the effect's output, and val:mix sets the balance: 0 is all dry, 1 is all wet.

Use it to put a blend control on an effect that has none of its own, such as a distortion or a
filter. Feed the same source to val:dry and to the effect, and the effect's output to val:wet. Delaying effects shift the wet signal in time; an effect that
reports latency makes the blend comb unless the dry path is delayed by the same amount.""" ;
    val:implementation "DryWet" ;
    val:linear true ;
    lv2:port
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "dry" ; lv2:name "Dry" ] ,
      [ a lv2:InputPort, lv2:AudioPort ; lv2:symbol "wet" ; lv2:name "Wet" ] ,
      [ a lv2:OutputPort, lv2:AudioPort ; lv2:symbol "out" ; lv2:name "Out" ] ,
      [ a lv2:InputPort, lv2:ControlPort ; lv2:symbol "mix" ;
        lv2:name "Mix" ; lv2:default 1.0 ;
        lv2:minimum 0.0 ; lv2:maximum 1.0 ] .
