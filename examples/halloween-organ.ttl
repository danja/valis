:a_tone_out__room_in a val:Arc ;
    val:from [ val:node :tone ; val:port "out" ] ;
    val:to   [ val:node :room ; val:port "in" ] .
:a_room_out__trim_in a val:Arc ;
    val:from [ val:node :room ; val:port "out" ] ;
    val:to   [ val:node :trim ; val:port "in" ] .
:a_trim_out__limit_in a val:Arc ;
    val:from [ val:node :trim ; val:port "out" ] ;
    val:to   [ val:node :limit ; val:port "in" ] .
:a_limit_out__out_in a val:Arc ;
    val:from [ val:node :limit ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in" ] .

:p0 a val:Param ; val:slot 0 ;
    val:target :b16Gain ; val:property val:gain ;
    lv2:name "Drawbar 16" ; lv2:symbol "drawbar_16" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p1 a val:Param ; val:slot 1 ;
    val:target :b513Gain ; val:property val:gain ;
    lv2:name "Drawbar 513" ; lv2:symbol "drawbar_513" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p2 a val:Param ; val:slot 2 ;
    val:target :b8Gain ; val:property val:gain ;
    lv2:name "Drawbar 8" ; lv2:symbol "drawbar_8" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p3 a val:Param ; val:slot 3 ;
    val:target :b4Gain ; val:property val:gain ;
    lv2:name "Drawbar 4" ; lv2:symbol "drawbar_4" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p4 a val:Param ; val:slot 4 ;
    val:target :b223Gain ; val:property val:gain ;
    lv2:name "Drawbar 223" ; lv2:symbol "drawbar_223" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p5 a val:Param ; val:slot 5 ;
    val:target :b2Gain ; val:property val:gain ;
    lv2:name "Drawbar 2" ; lv2:symbol "drawbar_2" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Drawbars" ;
    units:unit units:db .
:p6 a val:Param ; val:slot 6 ;
    val:target :dirt ; val:property val:gain ;
    lv2:name "Overdrive" ; lv2:symbol "overdrive" ;
    lv2:minimum 1 ; lv2:maximum 20 ;
    val:section "Tone" .
:p7 a val:Param ; val:slot 7 ;
    val:target :tone ; val:property val:cutoff ;
    lv2:name "Tone" ; lv2:symbol "tone" ;
    lv2:minimum 1500 ; lv2:maximum 12000 ;
    val:section "Tone" ;
    units:unit units:hertz .
:p8 a val:Param ; val:slot 8 ;
    val:target :scan ; val:property val:rate ;
    lv2:name "Scanner rate" ; lv2:symbol "scan_rate" ;
    lv2:minimum 0.5 ; lv2:maximum 9 ;
    val:section "Leslie" ;
    units:unit units:hertz .
:p9 a val:Param ; val:slot 9 ;
    val:target :scan ; val:property val:depth ;
    lv2:name "Scanner depth" ; lv2:symbol "scan_depth" ;
    lv2:minimum 0 ; lv2:maximum 3.5 ;
    val:section "Leslie" ;
    units:unit units:ms .
:p10 a val:Param ; val:slot 10 ;
    val:target :room ; val:property val:mix ;
    lv2:name "Room mix" ; lv2:symbol "room_mix" ;
    lv2:minimum 0 ; lv2:maximum 1 ;
    val:section "Room" .
:p11 a val:Param ; val:slot 11 ;
    val:target :clickLvl ; val:property val:gain ;
    lv2:name "Key click" ; lv2:symbol "key_click" ;
    lv2:minimum -40 ; lv2:maximum 0 ;
    val:section "Tone" ;
    units:unit units:db .
