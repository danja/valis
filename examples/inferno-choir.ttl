:cc1 a val:MidiCC ;
    val:controller 1 ;
    val:initial 0.0 .

:cc2 a val:MidiCC ;
    val:controller 2 ;
    val:initial 0.0 .

:cc3 a val:MidiCC ;
    val:controller 3 ;
    val:initial 0.0 .

:cc4 a val:MidiCC ;
    val:controller 4 ;
    val:initial 0.0 .

:vel a val:MidiVelocity .

:pitch a val:MidiPitch .

:glide a val:Slew ;
    val:rise 40.0 ;
    val:fall 40.0 .

:cc1Amt a val:Scale ;
    val:min 0.0 ;
    val:max 1.0 .

:wail a val:ControlAdd ;
    val:a 0.25 .

:cc2Amt a val:Scale ;
    val:min 0.0 ;
    val:max 1.0 .

:velAmt a val:Scale ;
    val:min 0.0 ;
    val:max 0.35 .

:scream a val:ControlAdd ;
    val:a 0.2 .

:cc3Amt a val:Scale ;
    val:min 0.0 ;
    val:max 1.0 .

:vowel a val:ControlAdd ;
    val:a 0.45 .

:mouth a val:Drift ;
    val:speed 1.3 ;
    val:amount 0.12 ;
    val:centre 0.0 ;
    val:seed 9.0 .

:vowelNow a val:ControlAdd .

:cc4Amt a val:Scale ;
    val:min 0.0 ;
    val:max 1.0 .

:inferno a val:ControlAdd ;
    val:a 0.3 .

:swoopEnv a val:Envelope ;
    val:attack 1.0 ;
    val:decay 240.0 ;
    val:sustain 0.0 ;
    val:release 10.0 .

:swoop a val:Scale ;
    val:min 1.0 ;
    val:max 1.25 .

:diveEnv a val:Envelope ;
    val:attack 1.0 ;
    val:decay 1.0 ;
    val:sustain 1.0 ;
    val:release 900.0 .

:dive a val:Scale ;
    val:min 0.7 ;
    val:max 1.0 .

:lift a val:Scale ;
    val:min 1.0 ;
    val:max 1.18 .

:vibRate a val:Scale ;
    val:min 4.2 ;
    val:max 7.4 .

:vibLfo a val:LFO ;
    val:shape 0 .

:vibDepth a val:Scale ;
    val:min 0.0 ;
    val:max 0.045 .

:vibAmt a val:ControlMultiply .

:waver a val:Drift ;
    val:speed 1.4 ;
    val:amount 0.012 ;
    val:centre 0.0 ;
    val:seed 7.0 .

:cry a val:Drift ;
    val:speed 0.55 ;
    val:amount 0.05 ;
    val:centre 0.0 ;
    val:seed 5.0 .

:wander a val:ControlAdd .

:vibFactor a val:ControlAdd ;
    val:a 1.0 .

:m1 a val:ControlMultiply .

:m2 a val:ControlMultiply .

:m3 a val:ControlMultiply .

:hz a val:ControlMultiply .

:hzB a val:ControlMultiply ;
    val:b 1.007 .

:hzLow a val:ControlMultiply ;
    val:b 0.4985 .

:hzRing a val:ControlMultiply ;
    val:b 0.5 .

:oscA a val:Glottal ;
    val:shape 0 .

:oscB a val:Glottal ;
    val:shape 0 .

:oscC a val:Glottal ;
    val:shape 0 .

:openQ a val:Scale ;
    val:min 0.7 ;
    val:max 0.35 .

:rdQ a val:Scale ;
    val:min 1.8 ;
    val:max 0.45 .

:lvA a val:Gain ;
    val:gain -4.0 .

:lvB a val:Gain ;
    val:gain -5.0 .

:lvC a val:Gain ;
    val:gain -12.0 .

:oscMix a val:Mixer .

:rough a val:RingModulator .

:roughAmt a val:Scale ;
    val:min 0.0 ;
    val:max 0.55 .

:tilt a val:OnePole ;
    val:mode 0 .

:tiltHz a val:Scale ;
    val:min 1600.0 ;
    val:max 9000.0 .

:hiss a val:Noise ;
    val:colour 0.0 .

:breathAmt a val:Scale ;
    val:min 0.06 ;
    val:max 0.6 .

:breathVca a val:VCA .

:excite a val:Mixer .

:f1v a val:Scale ;
    val:min 320.0 ;
    val:max 900.0 .

:f2v a val:Scale ;
    val:min 850.0 ;
    val:max 1450.0 .

:f3v a val:Scale ;
    val:min 2250.0 ;
    val:max 2800.0 .

:f4v a val:Scale ;
    val:min 3300.0 ;
    val:max 3700.0 .

:strain a val:Scale ;
    val:min 0.0 ;
    val:max 0.24 .

:shift a val:ControlAdd ;
    val:a 1.0 .

:f1 a val:ControlMultiply .

:f2 a val:ControlMultiply .

:f3 a val:ControlMultiply .

:f4 a val:ControlMultiply .

:t1 a val:StateVariable ;
    val:resonance 11.0 .

:t2 a val:StateVariable ;
    val:resonance 12.0 .

:t3 a val:StateVariable ;
    val:resonance 13.0 .

:t4 a val:StateVariable ;
    val:resonance 14.0 .

:g1 a val:Gain ;
    val:gain 9.0 .

:g2 a val:Gain ;
    val:gain 6.0 .

:g3 a val:Gain ;
    val:gain 1.0 .

:g4 a val:Gain ;
    val:gain -4.0 .

:body a val:Gain ;
    val:gain -5.0 .

:throat a val:Mixer .

:driveG a val:Scale ;
    val:min 1.6 ;
    val:max 14.0 .

:burn a val:Tanh .

:foldG a val:Scale ;
    val:min 1.0 ;
    val:max 3.2 .

:scorch a val:Fold .

:smoke a val:OnePole ;
    val:mode 0 ;
    val:cutoff 7500.0 .

:makeup a val:Gain .

:makeupDb a val:Scale ;
    val:min 0.0 ;
    val:max 9.0 .

:roarNoise a val:Noise ;
    val:colour 1.0 .

:roarLp a val:OnePole ;
    val:mode 0 ;
    val:cutoff 260.0 .

:roarWander a val:Drift ;
    val:speed 0.7 ;
    val:amount 0.3 ;
    val:centre 0.6 ;
    val:seed 3.0 .

:roarVca a val:VCA .

:roarAmt a val:Scale ;
    val:min 0.25 ;
    val:max 1.0 .

:roarVca2 a val:VCA .

:roarLvl a val:Gain ;
    val:gain -22.0 .

:crackRate a val:Scale ;
    val:min 20.0 ;
    val:max 85.0 .

:crackClock a val:LFO ;
    val:shape 3 .

:crackPick a val:Vary ;
    val:min 0.0 ;
    val:max 1.0 ;
    val:probability 1.0 ;
    val:seed 11.0 .

:crackEnv a val:Envelope ;
    val:attack 0.1 ;
    val:decay 7.0 ;
    val:sustain 0.0 ;
    val:release 4.0 .

:crackNoise a val:Noise ;
    val:colour 0.0 .

:crackVca a val:VCA .

:crackHp a val:OnePole ;
    val:mode 1 ;
    val:cutoff 1800.0 .

:crackAmt a val:Scale ;
    val:min 0.0 ;
    val:max 1.0 .

:crackVca2 a val:VCA .

:crackLvl a val:Gain ;
    val:gain -20.0 .

:voiceLvl a val:Gain ;
    val:gain -2.0 .

:sum a val:Mixer .

:choir a val:Chorus ;
    val:rate 0.33 ;
    val:depth 2.4 ;
    val:mix 0.35 .

:ampEnv a val:Envelope ;
    val:attack 70.0 ;
    val:decay 300.0 ;
    val:sustain 0.9 ;
    val:release 1100.0 .

:velLvl a val:Scale ;
    val:min 0.55 ;
    val:max 1.0 .

:ampCv a val:ControlMultiply .

:vca a val:VCA .

:hall a val:Reverb ;
    val:size 1.7 ;
    val:decay 5.5 ;
    val:damping 0.45 ;
    val:mix 0.38 .

:dc a val:OnePole ;
    val:mode 1 ;
    val:cutoff 28.0 .

:trim a val:Gain ;
    val:gain -2.0 .

:limit a val:Limiter ;
    val:ceiling -1.0 .

:out a val:Output .

:a_cc1_out__cc1Amt_in a val:Arc ;
    val:from [ val:node :cc1 ; val:port "out" ] ;
    val:to   [ val:node :cc1Amt ; val:port "in" ] .
