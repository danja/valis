# examples/latin-perc.ttl
#
# Hand percussion for a Latin band and a small punk kit, played by note number from one MIDI file or several.
# Notes: 36 bass drum, 38 snare, 39 snare body, 41 floor tom, 49 crash, 56 cowbell, 60 high bongo, 61 low bongo,
# 62 conga slap, 63 high conga, 64 low conga, 69 cabasa, 70 maracas, 73 short guiro, 74 long guiro, 75 claves.
# Struck things are a brief burst of noise through a low-pass (the stick, the palm) into a val:ModalBank tuned to
# the modes of the object: a circular membrane for drums, wooden bars for claves, a plate for the cowbell and crash.
# The snare adds wires as filtered noise. The maracas, cabasa and guiro are val:Shaker, which models the collisions
# of particles in a shell instead of filtering noise. A small room closes the sum.
# https://en.wikipedia.org/wiki/Latin_percussion

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:latinperc#> .

:latinperc a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Percussion", "Acoustic", "Latin" ;
    rdfs:label "Latin percussion and kit" ;
    val:element :marGate , :marShk , :marLvl , :cabGate , :cabShk , :cabLvl , :gusGate , :gusShk , :gusLvl , :gulGate , :gulShk , :gulLvl , :cghGate , :cghEnv , :cghHit , :cghNoise , :cghVca , :cghSoft , :cghMod , :cghLvl , :cglGate , :cglEnv , :cglHit , :cglNoise , :cglVca , :cglSoft , :cglMod , :cglLvl , :slpGate , :slpEnv , :slpHit , :slpNoise , :slpVca , :slpSoft , :slpMod , :slpLvl , :bghGate , :bghEnv , :bghHit , :bghNoise , :bghVca , :bghSoft , :bghMod , :bghLvl , :bglGate , :bglEnv , :bglHit , :bglNoise , :bglVca , :bglSoft , :bglMod , :bglLvl , :clvGate , :clvEnv , :clvHit , :clvNoise , :clvVca , :clvSoft , :clvMod , :clvLvl , :snbGate , :snbEnv , :snbHit , :snbNoise , :snbVca , :snbSoft , :snbMod , :snbLvl , :tomGate , :tomEnv , :tomHit , :tomNoise , :tomVca , :tomSoft , :tomMod , :tomLvl , :kckGate , :kckEnv , :kckHit , :kckNoise , :kckVca , :kckSoft , :kckMod , :kckLvl , :cwGate , :cwEnv , :cwHit , :cwNoise , :cwVca , :cwSoft , :cwMod , :cwLvl , :snrGate , :snrEnv , :snrHit , :snrNoise , :snrFilt , :snrVca , :snrLvl , :crpGate , :crpEnv , :crpHit , :crpNoise , :crpVca , :crpSoft , :crpMod , :crpLvl , :crsGate , :crsEnv , :crsHit , :crsNoise , :crsFilt , :crsVca , :crsLvl , :master , :room , :trim , :limit , :out ;
