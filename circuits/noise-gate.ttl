# examples/noise-gate.ttl
#
# A noise gate: an envelope follower watches the input and an expander pulls the
# signal down while the follower reads below the threshold. The follower's release
# is the gate's release, and its attack how fast the gate opens. A ratio of 20 or
# so makes the expander a gate; a lower ratio is a gentler downward expansion.

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:noisegate#> .

:gate a val:Circuit ;
    rdfs:label "Noise Gate" ;
    val:element :in , :env , :expander , :out ;
    val:arc :aInExp , :aInEnv , :aEnvExp , :aExpOut .

:in a val:Input .

:env a val:EnvelopeFollower ; val:attack 2.0 ; val:release 120.0 ; val:mode 0 .

:expander a val:Expander ; val:threshold -50.0 ; val:ratio 20.0 .

:out a val:Output .

:aInExp a val:Arc ; val:from [ val:node :in  ; val:port "out" ] ;
                    val:to   [ val:node :expander ; val:port "in" ] .
:aExpOut a val:Arc ; val:from [ val:node :expander ; val:port "out" ] ;
                     val:to   [ val:node :out ; val:port "in" ] .
:aInEnv a val:Arc ; val:from [ val:node :in  ; val:port "out" ] ;
                    val:to   [ val:node :env ; val:port "in" ] .
:aEnvExp a val:ControlArc ; val:from [ val:node :env ; val:port "out" ] ;
                            val:to   [ val:node :expander ; val:port "amount" ] .

:p0 a val:Param ; val:slot 0 ; val:target :expander ; val:property val:threshold ;
    lv2:name "Threshold" ; lv2:symbol "threshold" ; units:unit units:db .

:p1 a val:Param ; val:slot 1 ; val:target :expander ; val:property val:ratio ;
    lv2:name "Ratio" ; lv2:symbol "ratio" .

:p2 a val:Param ; val:slot 2 ; val:target :env ; val:property val:release ;
    lv2:name "Release" ; lv2:symbol "release" ; units:unit units:ms .
