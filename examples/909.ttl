# examples/909.ttl
#
# TR-909 drum synthesiser — functional circuit model.
#
# Each instrument is an independent sub-circuit gated by a val:NoteGate that
# listens on the General MIDI channel 10 note assignment for that drum. All
# nine voices feed a final Mixer and a single Output.
#
# Instrument map (General MIDI channel 10):
#   36  Bass Drum      — oscillator with pitch sweep, saturation, amplitude decay
#   37  Rim Shot       — noise click through a high-pass filter
#   38  Snare Drum     — oscillator tone + band-passed noise, amplitude decay
#   39  Hand Clap      — noise through a bandpass filter
#   41  Low Tom        — oscillator, amplitude decay
#   43  Mid Tom        — oscillator, amplitude decay
#   50  High Tom       — oscillator, amplitude decay
#   42  Closed Hi-Hat  — two square oscillators, highpass, short decay
#   46  Open Hi-Hat    — two square oscillators, highpass, longer decay

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :      <urn:valis:909#> .

:tr909 a val:Circuit ;
    rdfs:label "TR-909" ;
    val:element
        # Bass Drum
        :bdGate , :bdOsc , :bdPitchEnv , :bdPitchScale ,
        :bdAmpEnv , :bdSat , :bdVca ,
        # Snare Drum
        :sdGate , :sdOsc , :sdNoise , :sdBpf , :sdMix , :sdEnv , :sdVca ,
        # Rim Shot
        :rsGate , :rsNoise , :rsHpf , :rsEnv , :rsVca ,
        # Hand Clap
        :cpGate , :cpNoise , :cpBpf , :cpEnv , :cpVca ,
        # Low Tom
        :ltGate , :ltOsc , :ltEnv , :ltVca ,
        # Mid Tom
        :mtGate , :mtOsc , :mtEnv , :mtVca ,
        # High Tom
        :htGate , :htOsc , :htEnv , :htVca ,
        # Closed Hi-Hat
        :chGate , :chOsc1 , :chOsc2 , :chMix , :chHpf , :chEnv , :chVca ,
        # Open Hi-Hat
        :ohGate , :ohOsc1 , :ohOsc2 , :ohMix , :ohHpf , :ohEnv , :ohVca ,
        # Output stage
        :mix , :out ;
    val:arc
        # Bass Drum arcs
        :aBdGatePitchEnv , :aBdGateAmpEnv ,
        :aBdPitchEnvScale , :aBdScaleOsc ,
        :aBdOscSat , :aBdSatVca , :aBdEnvVca , :aBdVcaMix ,
        # Snare Drum arcs
        :aSdGateEnv ,
        :aSdNoiseBpf , :aSdOscMix , :aSdBpfMix ,
        :aSdMixVca , :aSdEnvVca , :aSdVcaMix ,
        # Rim Shot arcs
        :aRsGateEnv ,
        :aRsNoiseHpf , :aRsHpfVca , :aRsEnvVca , :aRsVcaMix ,
        # Hand Clap arcs
        :aCpGateEnv ,
        :aCpNoiseBpf , :aCpBpfVca , :aCpEnvVca , :aCpVcaMix ,
        # Low Tom arcs
        :aLtGateEnv , :aLtOscVca , :aLtEnvVca , :aLtVcaMix ,
        # Mid Tom arcs
        :aMtGateEnv , :aMtOscVca , :aMtEnvVca , :aMtVcaMix ,
        # High Tom arcs
        :aHtGateEnv , :aHtOscVca , :aHtEnvVca , :aHtVcaMix ,
        # Closed Hi-Hat arcs
        :aChGateEnv ,
        :aChOsc1Mix , :aChOsc2Mix , :aChMixHpf ,
        :aChHpfVca , :aChEnvVca , :aChVcaMix ,
        # Open Hi-Hat arcs
        :aOhGateEnv ,
        :aOhOsc1Mix , :aOhOsc2Mix , :aOhMixHpf ,
        :aOhHpfVca , :aOhEnvVca , :aOhVcaMix ,
        # Output
        :aMixOut .

################################################################
# Bass Drum (MIDI note 36)                                     #
#                                                              #
# A triangle oscillator at ~50 Hz swept upward by a fast pitch #
# envelope models the initial attack click. The amplitude      #
# envelope gives the body and tail. A tanh stage adds the      #
# characteristic punch without hard clipping.                  #
################################################################

:bdGate a val:NoteGate ; val:note 36 .

:bdOsc a val:Oscillator ;
    val:shape 3 .            # 3 = triangle

# Pitch envelope: fast decay pulls frequency from the peak down to base.
# The val:gate arc from :bdGate overrides the host MIDI gate, so only
# note 36 triggers this chain.
:bdPitchEnv a val:Envelope ;
    val:attack  0.5 ;        # ms
    val:decay   60.0 ;
    val:sustain 0.0 ;
    val:release 5.0 .

# Scale maps the envelope 0–1 to the oscillator's frequency range.
# val:min is the resting pitch; val:max is the attack peak.
:bdPitchScale a val:Scale ;
    val:min 50.0 ;           # Hz — body frequency
    val:max 180.0 .          # Hz — attack peak

:bdAmpEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   400.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:bdSat a val:Tanh ;
    val:gain 3.0 .

:bdVca a val:VCA .

################################################################
# Snare Drum (MIDI note 38)                                    #
#                                                              #
# Two sound sources are mixed: a triangle oscillator at ~180 Hz #
# for the tonal body, and white noise band-passed around 1 kHz #
# for the snare rattle. A single amplitude envelope shapes both.#
################################################################

:sdGate a val:NoteGate ; val:note 38 .

:sdOsc a val:Oscillator ;
    val:shape     3 ;        # triangle
    val:frequency 180.0 .

:sdNoise a val:Noise ;
    val:colour 0 .           # 0 = white

:sdBpf a val:StateVariable ;
    val:cutoff    1000.0 ;
    val:resonance 0.5 .

:sdMix a val:Mixer .

:sdEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   200.0 ;
    val:sustain 0.0 ;
    val:release 10.0 .

:sdVca a val:VCA .

################################################################
# Rim Shot (MIDI note 37)                                      #
#                                                              #
# A very short noise burst high-passed to remove the low-end   #
# thud. The 30 ms decay gives a dry, sharp click.              #
################################################################

:rsGate a val:NoteGate ; val:note 37 .

:rsNoise a val:Noise ;
    val:colour 0 .

:rsHpf a val:OnePole ;
    val:cutoff 800.0 ;
    val:mode   1 .           # 1 = highpass

:rsEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   30.0 ;
    val:sustain 0.0 ;
    val:release 5.0 .

:rsVca a val:VCA .

################################################################
# Hand Clap (MIDI note 39)                                     #
#                                                              #
# White noise through a bandpass filter at 1.2 kHz gives the   #
# hand-clap character. A 100 ms decay closes before the sound  #
# becomes a hiss.                                              #
################################################################

:cpGate a val:NoteGate ; val:note 39 .

:cpNoise a val:Noise ;
    val:colour 0 .

:cpBpf a val:StateVariable ;
    val:cutoff    1200.0 ;
    val:resonance 0.6 .

:cpEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   100.0 ;
    val:sustain 0.0 ;
    val:release 10.0 .

:cpVca a val:VCA .

################################################################
# Low Tom (MIDI note 41)                                       #
################################################################

:ltGate a val:NoteGate ; val:note 41 .

:ltOsc a val:Oscillator ;
    val:shape     3 ;
    val:frequency 100.0 .

:ltEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   500.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:ltVca a val:VCA .

################################################################
# Mid Tom (MIDI note 43)                                       #
################################################################

:mtGate a val:NoteGate ; val:note 43 .

:mtOsc a val:Oscillator ;
    val:shape     3 ;
    val:frequency 150.0 .

:mtEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   400.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:mtVca a val:VCA .

################################################################
# High Tom (MIDI note 50)                                      #
################################################################

:htGate a val:NoteGate ; val:note 50 .

:htOsc a val:Oscillator ;
    val:shape     3 ;
    val:frequency 220.0 .

:htEnv a val:Envelope ;
    val:attack  0.5 ;
    val:decay   300.0 ;
    val:sustain 0.0 ;
    val:release 20.0 .

:htVca a val:VCA .

################################################################
# Closed Hi-Hat (MIDI note 42)                                 #
#                                                              #
# Two square oscillators at frequency ratios derived from the  #
# original 909 circuit (~1 : 2.08) produce the metallic timbre.#
# A high-pass filter removes the fundamental, leaving the upper #
# partials that give the cymbal quality. Decay is very short.  #
################################################################

:chGate a val:NoteGate ; val:note 42 .

:chOsc1 a val:Oscillator ;
    val:shape     2 ;        # 2 = square
    val:frequency 562.0 .

:chOsc2 a val:Oscillator ;
    val:shape     2 ;
    val:frequency 1170.0 .

:chMix a val:Mixer .

:chHpf a val:StateVariable ;
    val:cutoff    5000.0 ;
    val:resonance 0.4 .

:chEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   35.0 ;
    val:sustain 0.0 ;
    val:release 5.0 .

:chVca a val:VCA .

################################################################
# Open Hi-Hat (MIDI note 46)                                   #
#                                                              #
# Same spectral source as the closed hat; only the decay is    #
# longer. In the original circuit, the open hat was cut by the  #
# closed hat's envelope (hi-hat choke). That interaction is not #
# modelled here — each note decays independently.              #
# TODO: implement choke logic via a UnitDelay feedback path.   #
################################################################

:ohGate a val:NoteGate ; val:note 46 .

:ohOsc1 a val:Oscillator ;
    val:shape     2 ;
    val:frequency 562.0 .

:ohOsc2 a val:Oscillator ;
    val:shape     2 ;
    val:frequency 1170.0 .

:ohMix a val:Mixer .

:ohHpf a val:StateVariable ;
    val:cutoff    5000.0 ;
    val:resonance 0.4 .

:ohEnv a val:Envelope ;
    val:attack  0.1 ;
    val:decay   400.0 ;
    val:sustain 0.0 ;
    val:release 30.0 .

:ohVca a val:VCA .

################################################################
# Output stage                                                 #
################################################################

:mix a val:Mixer .
:out a val:Output .

################################################################
# Bass Drum arcs                                               #
################################################################

# Gate routing: NoteGate.gate overrides the host MIDI gate on both envelopes.
:aBdGatePitchEnv a val:ControlArc ;
    val:from [ val:node :bdGate    ; val:port "gate" ] ;
    val:to   [ val:node :bdPitchEnv ; val:port "gate" ] .

:aBdGateAmpEnv a val:ControlArc ;
    val:from [ val:node :bdGate   ; val:port "gate" ] ;
    val:to   [ val:node :bdAmpEnv ; val:port "gate" ] .

# Pitch sweep: envelope shapes frequency over the Scale range.
:aBdPitchEnvScale a val:ControlArc ;
    val:from [ val:node :bdPitchEnv   ; val:port "out" ] ;
    val:to   [ val:node :bdPitchScale ; val:port "in"  ] .

:aBdScaleOsc a val:ControlArc ;
    val:from [ val:node :bdPitchScale ; val:port "out"       ] ;
    val:to   [ val:node :bdOsc        ; val:port "frequency" ] .

# Audio path: osc → saturation → VCA.
:aBdOscSat a val:Arc ;
    val:from [ val:node :bdOsc ; val:port "out" ] ;
    val:to   [ val:node :bdSat ; val:port "in"  ] .

:aBdSatVca a val:Arc ;
    val:from [ val:node :bdSat ; val:port "out" ] ;
    val:to   [ val:node :bdVca ; val:port "in"  ] .

:aBdEnvVca a val:ControlArc ;
    val:from [ val:node :bdAmpEnv ; val:port "out" ] ;
    val:to   [ val:node :bdVca    ; val:port "cv"  ] .

:aBdVcaMix a val:Arc ;
    val:from [ val:node :bdVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Snare Drum arcs                                              #
################################################################

:aSdGateEnv a val:ControlArc ;
    val:from [ val:node :sdGate ; val:port "gate" ] ;
    val:to   [ val:node :sdEnv  ; val:port "gate" ] .

:aSdNoiseBpf a val:Arc ;
    val:from [ val:node :sdNoise ; val:port "out" ] ;
    val:to   [ val:node :sdBpf   ; val:port "in"  ] .

# Both the oscillator (tonal) and the band-passed noise feed the Mixer.
:aSdOscMix a val:Arc ;
    val:from [ val:node :sdOsc ; val:port "out" ] ;
    val:to   [ val:node :sdMix ; val:port "in"  ] .

:aSdBpfMix a val:Arc ;
    val:from [ val:node :sdBpf ; val:port "bp"  ] ;
    val:to   [ val:node :sdMix ; val:port "in"  ] .

:aSdMixVca a val:Arc ;
    val:from [ val:node :sdMix ; val:port "out" ] ;
    val:to   [ val:node :sdVca ; val:port "in"  ] .

:aSdEnvVca a val:ControlArc ;
    val:from [ val:node :sdEnv ; val:port "out" ] ;
    val:to   [ val:node :sdVca ; val:port "cv"  ] .

:aSdVcaMix a val:Arc ;
    val:from [ val:node :sdVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Rim Shot arcs                                                #
################################################################

:aRsGateEnv a val:ControlArc ;
    val:from [ val:node :rsGate ; val:port "gate" ] ;
    val:to   [ val:node :rsEnv  ; val:port "gate" ] .

:aRsNoiseHpf a val:Arc ;
    val:from [ val:node :rsNoise ; val:port "out" ] ;
    val:to   [ val:node :rsHpf   ; val:port "in"  ] .

:aRsHpfVca a val:Arc ;
    val:from [ val:node :rsHpf ; val:port "out" ] ;
    val:to   [ val:node :rsVca ; val:port "in"  ] .

:aRsEnvVca a val:ControlArc ;
    val:from [ val:node :rsEnv ; val:port "out" ] ;
    val:to   [ val:node :rsVca ; val:port "cv"  ] .

:aRsVcaMix a val:Arc ;
    val:from [ val:node :rsVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Hand Clap arcs                                               #
################################################################

:aCpGateEnv a val:ControlArc ;
    val:from [ val:node :cpGate ; val:port "gate" ] ;
    val:to   [ val:node :cpEnv  ; val:port "gate" ] .

:aCpNoiseBpf a val:Arc ;
    val:from [ val:node :cpNoise ; val:port "out" ] ;
    val:to   [ val:node :cpBpf   ; val:port "in"  ] .

:aCpBpfVca a val:Arc ;
    val:from [ val:node :cpBpf ; val:port "bp"  ] ;
    val:to   [ val:node :cpVca ; val:port "in"  ] .

:aCpEnvVca a val:ControlArc ;
    val:from [ val:node :cpEnv ; val:port "out" ] ;
    val:to   [ val:node :cpVca ; val:port "cv"  ] .

:aCpVcaMix a val:Arc ;
    val:from [ val:node :cpVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Low Tom arcs                                                 #
################################################################

:aLtGateEnv a val:ControlArc ;
    val:from [ val:node :ltGate ; val:port "gate" ] ;
    val:to   [ val:node :ltEnv  ; val:port "gate" ] .

:aLtOscVca a val:Arc ;
    val:from [ val:node :ltOsc ; val:port "out" ] ;
    val:to   [ val:node :ltVca ; val:port "in"  ] .

:aLtEnvVca a val:ControlArc ;
    val:from [ val:node :ltEnv ; val:port "out" ] ;
    val:to   [ val:node :ltVca ; val:port "cv"  ] .

:aLtVcaMix a val:Arc ;
    val:from [ val:node :ltVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Mid Tom arcs                                                 #
################################################################

:aMtGateEnv a val:ControlArc ;
    val:from [ val:node :mtGate ; val:port "gate" ] ;
    val:to   [ val:node :mtEnv  ; val:port "gate" ] .

:aMtOscVca a val:Arc ;
    val:from [ val:node :mtOsc ; val:port "out" ] ;
    val:to   [ val:node :mtVca ; val:port "in"  ] .

:aMtEnvVca a val:ControlArc ;
    val:from [ val:node :mtEnv ; val:port "out" ] ;
    val:to   [ val:node :mtVca ; val:port "cv"  ] .

:aMtVcaMix a val:Arc ;
    val:from [ val:node :mtVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# High Tom arcs                                                #
################################################################

:aHtGateEnv a val:ControlArc ;
    val:from [ val:node :htGate ; val:port "gate" ] ;
    val:to   [ val:node :htEnv  ; val:port "gate" ] .

:aHtOscVca a val:Arc ;
    val:from [ val:node :htOsc ; val:port "out" ] ;
    val:to   [ val:node :htVca ; val:port "in"  ] .

:aHtEnvVca a val:ControlArc ;
    val:from [ val:node :htEnv ; val:port "out" ] ;
    val:to   [ val:node :htVca ; val:port "cv"  ] .

:aHtVcaMix a val:Arc ;
    val:from [ val:node :htVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Closed Hi-Hat arcs                                           #
################################################################

:aChGateEnv a val:ControlArc ;
    val:from [ val:node :chGate ; val:port "gate" ] ;
    val:to   [ val:node :chEnv  ; val:port "gate" ] .

:aChOsc1Mix a val:Arc ;
    val:from [ val:node :chOsc1 ; val:port "out" ] ;
    val:to   [ val:node :chMix  ; val:port "in"  ] .

:aChOsc2Mix a val:Arc ;
    val:from [ val:node :chOsc2 ; val:port "out" ] ;
    val:to   [ val:node :chMix  ; val:port "in"  ] .

:aChMixHpf a val:Arc ;
    val:from [ val:node :chMix ; val:port "out" ] ;
    val:to   [ val:node :chHpf ; val:port "in"  ] .

:aChHpfVca a val:Arc ;
    val:from [ val:node :chHpf ; val:port "hp"  ] ;
    val:to   [ val:node :chVca ; val:port "in"  ] .

:aChEnvVca a val:ControlArc ;
    val:from [ val:node :chEnv ; val:port "out" ] ;
    val:to   [ val:node :chVca ; val:port "cv"  ] .

:aChVcaMix a val:Arc ;
    val:from [ val:node :chVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Open Hi-Hat arcs                                             #
################################################################

:aOhGateEnv a val:ControlArc ;
    val:from [ val:node :ohGate ; val:port "gate" ] ;
    val:to   [ val:node :ohEnv  ; val:port "gate" ] .

:aOhOsc1Mix a val:Arc ;
    val:from [ val:node :ohOsc1 ; val:port "out" ] ;
    val:to   [ val:node :ohMix  ; val:port "in"  ] .

:aOhOsc2Mix a val:Arc ;
    val:from [ val:node :ohOsc2 ; val:port "out" ] ;
    val:to   [ val:node :ohMix  ; val:port "in"  ] .

:aOhMixHpf a val:Arc ;
    val:from [ val:node :ohMix ; val:port "out" ] ;
    val:to   [ val:node :ohHpf ; val:port "in"  ] .

:aOhHpfVca a val:Arc ;
    val:from [ val:node :ohHpf ; val:port "hp"  ] ;
    val:to   [ val:node :ohVca ; val:port "in"  ] .

:aOhEnvVca a val:ControlArc ;
    val:from [ val:node :ohEnv ; val:port "out" ] ;
    val:to   [ val:node :ohVca ; val:port "cv"  ] .

:aOhVcaMix a val:Arc ;
    val:from [ val:node :ohVca ; val:port "out" ] ;
    val:to   [ val:node :mix   ; val:port "in"  ] .

################################################################
# Output arc                                                   #
################################################################

:aMixOut a val:Arc ;
    val:from [ val:node :mix ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in"  ] .

################################################################
# Host parameters (val:Param bindings)                        #
#                                                              #
# Organised by section so the Knobs panel groups controls      #
# per instrument. Only the most performance-relevant controls  #
# are exposed; circuit defaults cover the rest.               #
################################################################

# ── Bass Drum ────────────────────────────────────────────────────────────────

:pBdDecay a val:Param ; val:slot 1 ;
    val:target :bdAmpEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "bd_decay" ; val:section "Bass Drum" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 2000.0 .

:pBdTune a val:Param ; val:slot 2 ;
    val:target :bdPitchScale ; val:property val:max ;
    lv2:name "Tune" ; lv2:symbol "bd_tune" ; val:section "Bass Drum" ;
    units:unit units:hz ; lv2:minimum 60.0 ; lv2:maximum 500.0 .

:pBdDrive a val:Param ; val:slot 3 ;
    val:target :bdSat ; val:property val:gain ;
    lv2:name "Drive" ; lv2:symbol "bd_drive" ; val:section "Bass Drum" ;
    lv2:minimum 1.0 ; lv2:maximum 20.0 .

# ── Snare ────────────────────────────────────────────────────────────────────

:pSdDecay a val:Param ; val:slot 4 ;
    val:target :sdEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "sd_decay" ; val:section "Snare" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 1000.0 .

:pSdTone a val:Param ; val:slot 5 ;
    val:target :sdBpf ; val:property val:cutoff ;
    lv2:name "Tone" ; lv2:symbol "sd_tone" ; val:section "Snare" ;
    units:unit units:hz ; lv2:minimum 200.0 ; lv2:maximum 4000.0 .

# ── Rim Shot ─────────────────────────────────────────────────────────────────

:pRsDecay a val:Param ; val:slot 6 ;
    val:target :rsEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "rs_decay" ; val:section "Rim Shot" ;
    units:unit units:ms ; lv2:minimum 5.0 ; lv2:maximum 200.0 .

# ── Hand Clap ────────────────────────────────────────────────────────────────

:pCpDecay a val:Param ; val:slot 7 ;
    val:target :cpEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "cp_decay" ; val:section "Hand Clap" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 500.0 .

# ── Low Tom ──────────────────────────────────────────────────────────────────

:pLtDecay a val:Param ; val:slot 8 ;
    val:target :ltEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "lt_decay" ; val:section "Low Tom" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 2000.0 .

# ── Mid Tom ──────────────────────────────────────────────────────────────────

:pMtDecay a val:Param ; val:slot 9 ;
    val:target :mtEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "mt_decay" ; val:section "Mid Tom" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 2000.0 .

# ── High Tom ─────────────────────────────────────────────────────────────────

:pHtDecay a val:Param ; val:slot 10 ;
    val:target :htEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "ht_decay" ; val:section "High Tom" ;
    units:unit units:ms ; lv2:minimum 10.0 ; lv2:maximum 2000.0 .

# ── Closed HH ────────────────────────────────────────────────────────────────

:pChDecay a val:Param ; val:slot 11 ;
    val:target :chEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "ch_decay" ; val:section "Closed HH" ;
    units:unit units:ms ; lv2:minimum 5.0 ; lv2:maximum 150.0 .

# ── Open HH ──────────────────────────────────────────────────────────────────

:pOhDecay a val:Param ; val:slot 12 ;
    val:target :ohEnv ; val:property val:decay ;
    lv2:name "Decay" ; lv2:symbol "oh_decay" ; val:section "Open HH" ;
    units:unit units:ms ; lv2:minimum 50.0 ; lv2:maximum 2000.0 .

:pOhBright a val:Param ; val:slot 13 ;
    val:target :ohHpf ; val:property val:cutoff ;
    lv2:name "Brightness" ; lv2:symbol "oh_bright" ; val:section "Open HH" ;
    units:unit units:hz ; lv2:minimum 2000.0 ; lv2:maximum 12000.0 .
