# examples/harp.ttl
#
# An eight-voice harp, as played in the Veracruz folk music that mariachi grew from. A bright pluck (val:Pluck) strikes
# a lightly damped stiff string that rings for several seconds, with one low soundboard resonance and a room.
# https://en.wikipedia.org/wiki/Harp

@prefix val:   <http://purl.org/stuff/valis/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix :      <urn:valis:harp#> .

:Voice a val:Subcircuit ;
    rdfs:label "Voice" ;

    lv2:port [ a lv2:OutputPort , lv2:AudioPort ;
               lv2:symbol "out" ; lv2:name "Out" ;
               val:node :dc ; val:port "out" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "ring" ; lv2:name "Ring time" ;
               lv2:default 4200.0 ; lv2:minimum 500 ; lv2:maximum 8000 ;
               lv2:portProperty lv2:logarithmic ;
               units:unit units:ms ;
               val:node :ampEnv ; val:port "decay" ] ,

             [ a lv2:InputPort , lv2:ControlPort ;
               lv2:symbol "pick" ; lv2:name "Pick hardness" ;
               lv2:default 0.6 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
               val:node :pick ; val:port "hardness" ] ;

    val:element :pitch , :pick , :string , :ampEnv , :ampVca , :dc ;
    val:arc :v_pitch_out__string_frequency ,
        :v_pitch_out__pick_frequency ,
        :v_pick_out__string_in ,
        :v_string_out__ampVca_in ,
        :v_ampEnv_out__ampVca_cv ,
        :v_ampVca_out__dc_in .

:pitch a val:MidiPitch .

:pick a val:Pluck ;
    val:position 0.12 ;
    val:hardness 0.6 .

:string a val:StiffString ;
    val:feedback 0.9985 ;
    val:damping 0.3 ;
    val:dispersion 0.002 .

:ampEnv a val:Envelope ;
    val:attack 0.5 ;
    val:decay 4200.0 ;
    val:sustain 0.0 ;
    val:release 4200.0 .

:ampVca a val:VCA .

:dc a val:OnePole ;
    val:mode 1 ;
    val:cutoff 28.0 .

:v_pitch_out__string_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :string ; val:port "frequency" ] .
:v_pitch_out__pick_frequency a val:Arc ;
    val:from [ val:node :pitch ; val:port "out" ] ;
    val:to   [ val:node :pick ; val:port "frequency" ] .
:v_pick_out__string_in a val:Arc ;
    val:from [ val:node :pick ; val:port "out" ] ;
    val:to   [ val:node :string ; val:port "in" ] .
:v_string_out__ampVca_in a val:Arc ;
    val:from [ val:node :string ; val:port "out" ] ;
    val:to   [ val:node :ampVca ; val:port "in" ] .
:v_ampEnv_out__ampVca_cv a val:Arc ;
    val:from [ val:node :ampEnv ; val:port "out" ] ;
    val:to   [ val:node :ampVca ; val:port "cv" ] .
:v_ampVca_out__dc_in a val:Arc ;
    val:from [ val:node :ampVca ; val:port "out" ] ;
    val:to   [ val:node :dc ; val:port "in" ] .

:harp a val:Circuit , trn:PluginProfile ;
    trn:role trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Harp", "Acoustic", "Latin" ;
    rdfs:label "Harp" ;
    val:element :poly , :soundboard , :body , :room , :trim , :limit , :out ;
    val:arc :a_poly_out__soundboard_in ,
        :a_poly_out__body_in ,
        :a_soundboard_bp__body_in ,
        :a_body_out__room_in ,
        :a_room_out__trim_in ,
        :a_trim_out__limit_in ,
        :a_limit_out__out_in .

:poly a :Voice ; val:voices 8 .

:soundboard a val:StateVariable ;
    val:cutoff 160.0 ;
    val:resonance 2.0 .

:body a val:Mixer .

:room a val:Reverb ;
    val:size 1.2 ;
    val:decay 2.4 ;
    val:damping 0.45 ;
    val:mix 0.2 .

:trim a val:Gain ;
    val:gain -9.0 .

:limit a val:Limiter ;
    val:ceiling -1.0 .

:out a val:Output .

:a_poly_out__soundboard_in a val:Arc ;
    val:from [ val:node :poly ; val:port "out" ] ;
    val:to   [ val:node :soundboard ; val:port "in" ] .
:a_poly_out__body_in a val:Arc ;
    val:from [ val:node :poly ; val:port "out" ] ;
    val:to   [ val:node :body ; val:port "in" ] .
:a_soundboard_bp__body_in a val:Arc ;
    val:from [ val:node :soundboard ; val:port "bp" ] ;
    val:to   [ val:node :body ; val:port "in" ] .
:a_body_out__room_in a val:Arc ;
    val:from [ val:node :body ; val:port "out" ] ;
    val:to   [ val:node :room ; val:port "in" ] .
:a_room_out__trim_in a val:Arc ;
    val:from [ val:node :room ; val:port "out" ] ;
    val:to   [ val:node :trim ; val:port "in" ] .
:a_trim_out__limit_in a val:Arc ;
    val:from [ val:node :trim ; val:port "out" ] ;
    val:to   [ val:node :limit ; val:port "in" ] .
:a_limit_out__out_in a val:Arc ;
    val:from [ val:node :limit ; val:port "out" ] ;
    val:to   [ val:node :out ; val:port "in" ] .

:p0 a val:Param ; val:slot 0 ;
    val:target :poly ; val:property val:ring ;
    lv2:name "Ring time" ; lv2:symbol "ring_time" ;
    lv2:minimum 500 ; lv2:maximum 8000 ;
    val:section "String" ;
    units:unit units:ms .
:p1 a val:Param ; val:slot 1 ;
    val:target :poly ; val:property val:pick ;
    lv2:name "Pick hardness" ; lv2:symbol "pick_hardness" ;
    lv2:minimum 0.0 ; lv2:maximum 1.0 ;
    val:section "String" .
